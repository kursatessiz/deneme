{
  email {$ACME_EMAIL}

  # Page engine (docs/SAYFA_MOTORU.md): tenant sites at <slug>.{$SITES_DOMAIN}
  # and verified custom domains get a certificate issued on first request,
  # gated by the API's public, rate-limited "ask" endpoint so a random
  # hostname can never trigger issuance. (Caddy 2.10 dropped the old
  # interval/burst options here; the ask endpoint does the rate limiting.)
  on_demand_tls {
    ask http://api:4000/public/domains/ask
  }
}

# Environment-specific headers, selected by SITE_ENV (docker-compose.prod.yml,
# default "production"). Any other value fails the config load on purpose.
# production: unchanged behaviour (HSTS preload on the web domain).
# preprod: never indexed by search engines, and no HSTS preload so the
# preprod hostname is never submitted to browser preload lists.
(env_production_web) {
  header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
}
(env_production_other) {
  header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
(env_preprod_web) {
  header Strict-Transport-Security "max-age=31536000; includeSubDomains"
  header X-Robots-Tag "noindex, nofollow"
}
(env_preprod_other) {
  header Strict-Transport-Security "max-age=31536000; includeSubDomains"
  header X-Robots-Tag "noindex, nofollow"
}

# Web Dashboard & Public Booking Pages
{$WEB_DOMAIN} {
  encode zstd gzip

  # Security headers
  import env_{$SITE_ENV:production}_web
  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Permissions-Policy "camera=(self), geolocation=(), microphone=()"
    -Server
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  reverse_proxy web:3000 {
    header_up Host {host}
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
  }
}

# Backend Core REST & WebSocket API
{$API_DOMAIN} {
  encode zstd gzip

  # CORS is handled by the API itself (explicit origin list).
  import env_{$SITE_ENV:production}_other
  header {
    X-Content-Type-Options "nosniff"
    -Server
  }

  reverse_proxy api:4000 {
    header_up Host {host}
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
  }
}

# Tenant sites (page engine): any host not matched above -- a
# <slug>.{$SITES_DOMAIN} subdomain or a tenant's own verified custom
# domain. Certificates are issued on demand per the "ask" endpoint above;
# the web app's middleware resolves the Host header to a tenant site.
:443 {
  encode zstd gzip
  tls {
    on_demand
  }

  import env_{$SITE_ENV:production}_other
  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }

  reverse_proxy web:3000 {
    header_up Host {host}
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
  }
}
