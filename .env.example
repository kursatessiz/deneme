# ==============================================================================
# Pilates Studio OS - Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=production
APP_VERSION=1.0.0

# Domain Names (Managed by Caddy Automatic SSL)
WEB_DOMAIN=panel.yourstudiodomain.com
API_DOMAIN=api.yourstudiodomain.com

# PostgreSQL Configuration
POSTGRES_USER=pilates_admin
POSTGRES_PASSWORD=generate_a_very_strong_password_here_32_chars!
POSTGRES_DB=pilates_prod
DATABASE_URL=postgresql://pilates_admin:generate_a_very_strong_password_here_32_chars!@postgres:5432/pilates_prod?schema=public

# Redis Configuration
REDIS_PASSWORD=another_strong_random_redis_password_32_chars!
REDIS_URL=redis://:another_strong_random_redis_password_32_chars!@redis:6379

# Authentication & Security
JWT_SECRET=super_secret_jwt_hmac_sha256_key_at_least_64_characters_long!
CORS_ORIGIN=https://panel.yourstudiodomain.com

# SMS Gateway (Options: NETGSM, ILETI_MERKEZI, MOCK)
SMS_PROVIDER=NETGSM
NETGSM_USER=850xxxxxxx
NETGSM_PASSWORD=your_netgsm_api_password
NETGSM_HEADER=STUDIO_SMS_BASLIGI

# Container Registry Image Tags (Handled by CI/CD)
API_IMAGE=ghcr.io/your-username/pilates-api:latest
WEB_IMAGE=ghcr.io/your-username/pilates-web:latest
