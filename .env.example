# Server environment template. Copy to /opt/app/.env on the host and fill in.
# Generate secrets with: openssl rand -hex 32
# Never commit the real file. docs/CICD_GUIDE.md "Preprod ortami" lists what
# to set on a pre-production server versus production.
#
# Every key below reaches its container through deploy/docker-compose.prod.yml.
# Optional keys may stay empty: an empty value means "not set" and the
# adapter falls back to its safe default (MOCK where that exists; in
# production most MOCKs refuse instead of pretending to succeed).
# [SIDE EFFECT] marks keys that make the platform talk to a real external
# service (real SMS/email/payments/invoices/registrations). On preprod leave
# them empty or use the provider's sandbox/test credentials.

# -- Required ---------------------------------------------------------------

# Images published by CI (lowercase owner/repo)
IMAGE_REPO=ghcr.io/<owner>/<repo>
# Used by scripts/nightly-deploy.sh (pull-based deploys)
GIT_REMOTE=https://github.com/<owner>/<repo>.git

# Public hostnames served by Caddy (automatic TLS)
WEB_DOMAIN=panel.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
# Tenant sites are served at <slug>.<SITES_DOMAIN>; empty uses WEB_DOMAIN.
SITES_DOMAIN=
# Web uygulamasinin POST /api/revalidate ucunun paylasilan sirri (en az 16 karakter; openssl rand -hex 24).
# API, bir sayfa veya yazi yayinlandiginda veya geri cekildiginda bu uc ile onbellegi temizletir; bos birakilirsa
# uc kapalidir (503) ve sayfalar en gec 5 dakikada yenilenir (docs/SEO.md bolum 11).
REVALIDATE_SECRET=
# production (default) or preprod. preprod adds "X-Robots-Tag: noindex,
# nofollow" on every host and drops the HSTS preload flag (deploy/caddy/Caddyfile).
SITE_ENV=production

# PostgreSQL
POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_PASSWORD=

# Redis
REDIS_PASSWORD=

# API (at least 32 characters)
JWT_SECRET=

# -- Messaging: SMS -----------------------------------------------------------
# MOCK, NETGSM, ILETI_MERKEZI or TWILIO. With NODE_ENV=production a MOCK SMS
# is never shown anywhere, so phone OTP login (mobile app) needs a real
# provider. [SIDE EFFECT] with credentials: real SMS, billed per message.
SMS_PROVIDER=MOCK
# Provider credit balance below which super admins are alerted (default 500).
SMS_PROVIDER_LOW_BALANCE_THRESHOLD=
# [SIDE EFFECT] Netgsm
NETGSM_USER=
NETGSM_PASSWORD=
NETGSM_HEADER=
# [SIDE EFFECT] Ileti Merkezi
ILETI_MERKEZI_USER=
ILETI_MERKEZI_PASSWORD=
ILETI_MERKEZI_SENDER=
# [SIDE EFFECT] Twilio (global default SMS provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Shared secret in the Netgsm / Ileti Merkezi delivery-report URL (24+ characters).
SMS_DLR_WEBHOOK_TOKEN=

# -- Messaging: WhatsApp Cloud API ---------------------------------------------
# [SIDE EFFECT] real template messages when both are set.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Webhook signature (X-Hub-Signature-256) and verify token (16+ characters).
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# -- Messaging: email (Amazon SES) --------------------------------------------
# [SIDE EFFECT] real email. Unset in production: email sends fail visibly
# (they never pretend to be delivered).
SES_REGION=
SES_FROM_ADDRESS=
SES_FROM_NAME=
SES_CONFIGURATION_SET=
# Comma-separated SNS topic ARNs accepted by the SES webhook; empty accepts any verified topic.
SES_SNS_TOPIC_ARNS=
# Credentials for the AWS SDK default chain (an IAM user limited to ses:SendEmail).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# HMAC key (32+ characters) for open/click/unsubscribe links. Required in
# production for any commercial email (without it no unsubscribe link can be
# issued, so commercial email is refused).
MESSAGING_TRACKING_SECRET=

# -- Consent registry (Turkey, IYS) -------------------------------------------
# [SIDE EFFECT] registers consents with the real IYS; the MOCK client is used until set.
IYS_BRAND_CODE=
IYS_API_KEY=

# -- Push notifications -------------------------------------------------------
# MOCK (default) or EXPO. [SIDE EFFECT] EXPO delivers to real devices.
PUSH_PROVIDER=
# Only when "enhanced push security" is on in the Expo project.
EXPO_ACCESS_TOKEN=

# -- Payments -----------------------------------------------------------------
# MOCK (default), STRIPE, IYZICO or PAYTR. MOCK is disabled in production
# (every checkout fails), so use STRIPE with test keys (sk_test_...) on preprod.
# [SIDE EFFECT] live keys charge real cards.
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# iyzico sandbox: https://sandbox-api.iyzipay.com
IYZICO_BASE_URL=
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# -- e-invoice integrators (docs/INVOICING.md) --------------------------------
# [SIDE EFFECT] issues legally binding invoices. Leave empty on preprod.
PARASUT_CLIENT_ID=
PARASUT_CLIENT_SECRET=
ELOGO_USERNAME=
ELOGO_PASSWORD=
FORIBA_USERNAME=
FORIBA_PASSWORD=
UYUMSOFT_USERNAME=
UYUMSOFT_PASSWORD=

# -- Partner integrations -----------------------------------------------------
# AES-256-GCM key for stored partner credentials: 32 random bytes, base64
# (openssl rand -base64 32). Required once any partner connection exists.
# Never reuse the production key on preprod.
INTEGRATION_ENCRYPTION_KEY=

# -- AI (docs/YAPAY_ZEKA.md) --------------------------------------------------
# Fallback only; the key is normally stored encrypted from the super admin AI
# screen. [SIDE EFFECT] billed API usage.
ANTHROPIC_API_KEY=

# -- Video (W19) --------------------------------------------------------------
# https base URL for meeting rooms; empty uses https://meet.jit.si.
JITSI_BASE_URL=

# -- Error reporting (docs/HATA_RAPORLAMA.md) ---------------------------------
# All optional; empty uses the defaults in apps/api/src/config/env.ts.
ERROR_USER_HASH_SALT=
ERROR_CLIENT_SAMPLE_RATE=
ERROR_ALERT_COOLDOWN_MINUTES=
# 0 turns the super admin alert/digest emails off (errors are still recorded).
ERROR_ALERTS_ENABLED=
# Source maps for stack symbolication (H2). Empty disables uploads. At least 32
# random characters (openssl rand -hex 32); the same value is the
# SOURCEMAP_UPLOAD_TOKEN secret of the GitHub environments (docs/CICD_GUIDE.md).
SOURCEMAP_UPLOAD_TOKEN=

# -- One-time super admin bootstrap (docs/CICD_GUIDE.md) ----------------------
# Not stored here: pass BOOTSTRAP_SUPER_ADMIN_PASSWORD from your shell with
# `docker compose run -e BOOTSTRAP_SUPER_ADMIN_PASSWORD ...`, or let the
# command generate one and print it once.

# -- Database backups (docs/YEDEKLER.md) ---------------------------------------
# Managed from the super admin panel
# (/admin/yedekler): the API makes the scheduled daily backup; the host cron
# (scripts/backup.sh, daily at 02:30) stays as the fallback. Both use these
# settings. Any S3-compatible storage; leave BACKUP_S3_BUCKET empty to keep
# local copies only (the panel then cannot make backups). When the bucket is
# set, the access key, the secret and BACKUP_ENCRYPTION_KEY are required or
# the API refuses to start. Keep BACKUP_ENCRYPTION_KEY (openssl rand -hex 32)
# somewhere other than this server too: without it the off-site copies
# cannot be restored.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_PREFIX=db
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY=
# Panel download links live this many seconds (60-900; empty = 300).
BACKUP_DOWNLOAD_URL_TTL_SECONDS=
# pg_dump binary inside the api image; empty uses the one on PATH.
BACKUP_PG_DUMP_PATH=

# -- Platform two-step verification (docs/PAZARLAMA_MODULU.md 6.3) -----------
# Issuer name shown in authenticator apps; empty uses "Platform".
MFA_ISSUER=
# Hours without a successful backup before super admins get an email (API).
BACKUP_STALE_HOURS=26

# -- Compose tarafindan turetilen degiskenler (elle ayarlamayin) -------------
# Asagidaki anahtarlar deploy/docker-compose.prod.yml icinde sabit veya yukaridaki
# degerlerden turetilir; bu dosyaya yazmaniz gerekmez, yazarsaniz compose degerleri gecerli kalir.
# NODE_ENV, PORT       : api icin production ve 4000, web icin production ve 3000.
# DATABASE_URL, REDIS_URL : POSTGRES_* ve REDIS_PASSWORD degerlerinden olusturulur.
# CORS_ORIGIN, PUBLIC_APP_URL : https://WEB_DOMAIN.
# PUBLIC_API_URL       : https://API_DOMAIN (api ve web konteynerleri; kaynak haritasi yuklemesi de kullanir).
# WEB_INTERNAL_URL     : http://web:3000, API'nin web onbellek temizleme ucuna ulastigi ic adres.
# API_INTERNAL_URL     : http://api:4000, web sunucusunun API'ye ulastigi ic adres (istemci paketine girmez).
# APP_VERSION, APP_RELEASE : dagitimin RELEASE_TAG degeri (sha-<commit>); hata raporlarini etiketler.
# SOURCEMAP_DIR, BACKUP_LOCAL_DIR : konteyner ici volume yollari.
# SITES_DOMAIN, WEB_DOMAIN : web ara katmani (middleware) isletme sitesi host'larini bunlardan cozer.
# Yalnizca test icin olan ve uretimde reddedilen anahtarlar bilerek aktarilmaz:
# OTP_TEST_CODE, AI_FAKE_PROVIDER, SOCIAL_FAKE_PROVIDER.
