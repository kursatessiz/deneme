# Server environment template. Copy to /opt/app/.env on the host and fill in.
# Generate secrets with: openssl rand -hex 32
# Never commit the real file.

# Images published by CI (lowercase owner/repo)
IMAGE_REPO=ghcr.io/<owner>/<repo>
# Used by scripts/nightly-deploy.sh (pull-based deploys)
GIT_REMOTE=https://github.com/<owner>/<repo>.git

# Public hostnames served by Caddy (automatic TLS)
WEB_DOMAIN=panel.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

# PostgreSQL
POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_PASSWORD=

# Redis
REDIS_PASSWORD=

# API (at least 32 characters)
JWT_SECRET=

# SMS gateway: MOCK, NETGSM or ILETI_MERKEZI
SMS_PROVIDER=MOCK
NETGSM_USER=
NETGSM_PASSWORD=
NETGSM_HEADER=

# Off-site database backups (scripts/backup.sh, daily at 02:30 via cron).
# Any S3-compatible storage; leave BACKUP_S3_BUCKET empty to keep local copies only.
# Keep BACKUP_ENCRYPTION_KEY somewhere other than this server too: without it
# the off-site copies cannot be restored.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_PREFIX=db
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY=
