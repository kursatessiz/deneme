  ATTENDED
  CANCELLED_EARLY
  CANCELLED_LATE
  NO_SHOW
  WAITLIST
}

/// W19: how a session is delivered. IN_PERSON is the default for every
/// existing session; ONLINE and HYBRID opt into a meeting link.
enum SessionDeliveryMode {
  IN_PERSON
  ONLINE
  HYBRID
}

/// W19: which adapter produced a session's meeting link.
enum VideoMeetingProviderKind {
  MANUAL
  JITSI
}

/// W19: on-demand library content source. UPLOADED is intentionally not
/// implemented yet - see docs/VIDEO.md - only EXTERNAL_URL is wired up.
