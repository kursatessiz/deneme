  COMPLETED
  REFUNDED
  FAILED
}

enum CommissionType {
  PER_SESSION_FIXED
  PERCENTAGE
  MONTHLY_SALARY
}

/// Payment provider adapter that produced a stored card, subscription charge
/// or online checkout. MOCK is deterministic and used by default/tests.
