model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  studioId  String   @map("studio_id") @db.Uuid
  name      String   @db.VarChar(100)
  address   String?  @db.Text
  phone     String?  @db.VarChar(30)
  email     String?  @db.VarChar(120)
  /// Null uses the studio's timezone.
  timezone  String?  @db.VarChar(60)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  studio      Studio             @relation(fields: [studioId], references: [id], onDelete: Cascade)
  resources   Resource[]
  schedules   SessionSchedule[]
  expenses    Expense[]
  payments    Payment[]
  staffAccess MembershipBranch[]
  homeMembers MemberProfile[]    @relation("MemberHomeBranch")
  payrollRuns   PayrollRun[]
  leads         Lead[]
  contacts      Contact[]
  invoices      Invoice[]
  checkInPoints CheckInPoint[]
  kioskDevices  KioskDevice[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  sales          Sale[]
  events        Event[]

  @@unique([studioId, name])
  /// Target of composite foreign keys that pin a row to the branch's studio.
  @@unique([id, studioId])
  @@index([studioId])
  @@map("branches")
}

/// Branches a staff membership may act on. No rows means every branch;
/// the owner role is never restricted.
model MembershipBranch {
  membershipId String   @map("membership_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  studioId     String   @map("studio_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  /// Composite key: a grant can only point at a branch of the same studio.
  branch     Branch     @relation(fields: [branchId, studioId], references: [id, studioId], onDelete: Cascade)

  @@id([membershipId, branchId])
  @@index([studioId])
  @@map("membership_branches")
}

// ---------------------------------------------------------------------------
// Identity: users are global and phone based; tenancy lives on Membership
// ---------------------------------------------------------------------------

model User {
  id                String                @id @default(uuid()) @db.Uuid
  /// E.164, e.g. +905321112233
  phone             String                @unique @db.VarChar(20)
  email             String?               @unique @db.VarChar(120)
  firstName         String                @map("first_name") @db.VarChar(60)
  lastName          String                @map("last_name") @db.VarChar(60)
  pinHash           String?               @map("pin_hash") @db.VarChar(255)
  passwordHash      String?               @map("password_hash") @db.VarChar(255)
  phoneVerifiedAt   DateTime?             @map("phone_verified_at")
  /// Platform owner. Not a tenant role; bypasses studio scoping.
  isSuperAdmin      Boolean               @default(false) @map("is_super_admin")
  avatarUrl         String?               @map("avatar_url") @db.Text
  refreshTokenHash  String?               @map("refresh_token_hash") @db.VarChar(255)
  failedPinAttempts Int                   @default(0) @map("failed_pin_attempts")
  pinLockedUntil    DateTime?             @map("pin_locked_until")
  /// Appearance override; null follows the tenant's theme family.
  themeFamily       String?               @map("theme_family") @db.VarChar(20)
  colorScheme       ColorSchemePreference @default(SYSTEM) @map("color_scheme")
  /// Own language choice (Language.code); null follows the active studio's default.
  locale            String?               @db.VarChar(10)
  isActive          Boolean               @default(true) @map("is_active")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  memberships           Membership[]
  pushDevices           PushDevice[]
  notificationPrefs     NotificationPreference[]
  calendarFeedToken     CalendarFeedToken?
  invitesCreated        InviteToken[]            @relation("InviteCreatedBy")
  packageTransfers      PackageTransfer[]
  measurementEntries    MeasurementEntry[]
  expenses              Expense[]
  smsTransactions       SmsTransaction[]
  auditLogs             AuditLog[]
  communicationConsents CommunicationConsent[]
  payrollRunsCreated    PayrollRun[]             @relation("PayrollRunCreatedBy")
  payrollRunsApproved   PayrollRun[]             @relation("PayrollRunApprovedBy")
  automationRuns        AutomationRun[]
  trialRedemptions      TrialRedemption[]
  promoCodesCreated     PromoCode[]              @relation("PromoCodeCreatedBy")
  promoRedemptions      PromoRedemption[]
  giftCardsPurchased    GiftCard[]               @relation("GiftCardPurchaser")
  giftCardTransactions  GiftCardTransaction[]    @relation("GiftCardTransactionActor")
  riskSnapshotsContacted MemberRiskSnapshot[]    @relation("RiskSnapshotContactedBy")
  referredAs            Referral[]
  kioskDevicesCreated   KioskDevice[]            @relation("KioskDeviceCreatedBy")
  apiKeysCreated        ApiKey[]                 @relation("ApiKeyCreatedBy")
  partnerGuestOf        PartnerGuest[]
  translationOverridesUpdated TranslationOverride[]
  pageVersionsPublished PageVersion[]
  /// Platform access and 2FA (M1, docs/PAZARLAMA_MODULU.md 7.1).
  totpSecretEncrypted   String?               @map("totp_secret_encrypted") @db.Text
  mfaEnabledAt          DateTime?             @map("mfa_enabled_at")
  /// Last accepted TOTP time step; a code is never accepted twice.
  totpLastUsedStep      Int?                  @map("totp_last_used_step")
  platformMembership    PlatformMembership?
  mfaRecoveryCodes      UserMfaRecoveryCode[]

  @@map("users")
}

/// A user's link to one tenant. The role template decides staff permissions;
/// self-service as a member comes from having a MemberProfile.
model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  studioId       String           @map("studio_id") @db.Uuid
  roleTemplateId String           @map("role_template_id") @db.Uuid
  status         MembershipStatus @default(INVITED)
  joinedAt       DateTime?        @map("joined_at")
  /// True only for a membership auto-created by a partner (aggregator)
  /// webhook guest who has never onboarded into the app themselves. Such
  /// guests must be excluded from automation targeting, bulk/marketing
  /// messaging, churn scoring, gamification pushes and referral/rating
  /// prompts until they complete real onboarding or staff converts them,
  /// at which point this is cleared (see docs/PARTNERS.md).
  isPartnerGuest Boolean          @default(false) @map("is_partner_guest")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  studio         Studio             @relation(fields: [studioId], references: [id], onDelete: Cascade)
  roleTemplate   RoleTemplate       @relation(fields: [roleTemplateId], references: [id])
  memberProfile  MemberProfile?
  trainerProfile TrainerProfile?
  consents       Consent[]
  branchAccess   MembershipBranch[]
  leadsOwned     Lead[]             @relation("LeadOwner")
  leadsConverted Lead[]             @relation("LeadConverted")
  leadActivities LeadActivity[]     @relation("LeadActivityActor")
  contact              Contact?          @relation("ContactMembership")
  contactsOwned        Contact[]         @relation("ContactOwner")
  contactActivities    ContactActivity[] @relation("ContactActivityActor")
  contactTasksAssigned ContactTask[]     @relation("ContactTaskAssignee")
  contactTasksCreated  ContactTask[]     @relation("ContactTaskCreator")
  conversationsAssigned     Conversation[]        @relation("ConversationAssignee")
  conversationMessagesSent  ConversationMessage[] @relation("ConversationMessageAuthor")
  loyaltyAccount            LoyaltyAccount?
  loyaltyLedger             LoyaltyLedger[]       @relation("LoyaltyLedgerHolder")
  loyaltyLedgerCreated      LoyaltyLedger[]       @relation("LoyaltyLedgerActor")
  loyaltyRedemptions        LoyaltyRedemption[]   @relation("LoyaltyRedemptionHolder")
  eventsCreated             Event[]               @relation("EventCreator")
  eventRegistrationsCreated EventRegistration[]   @relation("EventRegistrationCreator")
  communityPosts            CommunityPost[]       @relation("CommunityPostAuthor")
  communityComments         CommunityComment[]    @relation("CommunityCommentAuthor")
  communityReactions        CommunityReaction[]

  @@unique([userId, studioId])
  @@index([studioId, status])
  @@index([studioId, isPartnerGuest])
  @@map("memberships")
}

/// Per-tenant permission set. Keys come from the catalogue in
/// @platform/shared (PERMISSIONS). An owner template holds every permission
/// and cannot be edited or removed by tenant users.
model RoleTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  studioId  String   @map("studio_id") @db.Uuid
  key       String   @db.VarChar(40)
  name      String   @db.VarChar(80)
  isOwner   Boolean  @default(false) @map("is_owner")
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studio      Studio                   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  permissions RoleTemplatePermission[]
  memberships Membership[]
  invites     InviteToken[]

  @@unique([studioId, key])
  @@map("role_templates")
}

model RoleTemplatePermission {
  roleTemplateId String @map("role_template_id") @db.Uuid
  permissionKey  String @map("permission_key") @db.VarChar(80)

  roleTemplate RoleTemplate @relation(fields: [roleTemplateId], references: [id], onDelete: Cascade)

  @@id([roleTemplateId, permissionKey])
  @@map("role_template_permissions")
}

/// QR / link onboarding. Only a hash of the token is stored.
model InviteToken {
  id              String        @id @default(uuid()) @db.Uuid
  studioId        String        @map("studio_id") @db.Uuid
  createdByUserId String        @map("created_by_user_id") @db.Uuid
  roleTemplateId  String        @map("role_template_id") @db.Uuid
  phone           String        @db.VarChar(20)
  fullName        String        @map("full_name") @db.VarChar(120)
  tokenHash       String        @unique @map("token_hash") @db.VarChar(128)
  channel         InviteChannel
  expiresAt       DateTime      @map("expires_at")
  usedAt          DateTime?     @map("used_at")
  revokedAt       DateTime?     @map("revoked_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  studio       Studio       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("InviteCreatedBy", fields: [createdByUserId], references: [id])
  roleTemplate RoleTemplate @relation(fields: [roleTemplateId], references: [id])
  /// Set on a platform invite (M1): studioId is then the platform tenant.
  platformRoleTemplateId String?               @map("platform_role_template_id") @db.Uuid
  platformRoleTemplate   PlatformRoleTemplate? @relation(fields: [platformRoleTemplateId], references: [id], onDelete: Restrict)

  @@index([studioId, phone])
  @@map("invite_tokens")
}

/// One-time codes for login and invite acceptance. Only an HMAC of the
/// code is stored. Not tenant-scoped: a phone number is global.
model OtpChallenge {
  id         String     @id @default(uuid()) @db.Uuid
  phone      String     @db.VarChar(20)
  purpose    OtpPurpose
  codeHash   String     @map("code_hash") @db.VarChar(128)
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at")
  consumedAt DateTime?  @map("consumed_at")
  requestIp  String?    @map("request_ip") @db.VarChar(45)
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([phone, purpose, createdAt])
  @@index([requestIp, createdAt])
  @@map("otp_challenges")
}

/// Contract / KVKK texts. studioId null means a platform-wide template.
model DocumentVersion {
  id          String       @id @default(uuid()) @db.Uuid
  studioId    String?      @map("studio_id") @db.Uuid
  type        DocumentType
  version     Int
  title       String       @db.VarChar(160)
  body        String       @db.Text
  publishedAt DateTime?    @map("published_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  studio   Studio?   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  consents Consent[]

  @@unique([studioId, type, version])
  @@map("document_versions")
}

model Consent {
  id                String   @id @default(uuid()) @db.Uuid
  membershipId      String   @map("membership_id") @db.Uuid
  documentVersionId String   @map("document_version_id") @db.Uuid
  acceptedAt        DateTime @default(now()) @map("accepted_at")
  device            String?  @db.VarChar(200)
  ip                String?  @db.VarChar(45)

  membership      Membership      @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id])

  @@unique([membershipId, documentVersionId])
  @@map("consents")
}

model MemberProfile {
  id                    String    @id @default(uuid()) @db.Uuid
  membershipId          String    @unique @map("membership_id") @db.Uuid
  studioId              String    @map("studio_id") @db.Uuid
  familyGroupId         String?   @map("family_group_id") @db.Uuid
  /// Where the member usually trains; members may still book any branch.
  homeBranchId          String?   @map("home_branch_id") @db.Uuid
  birthDate             DateTime? @map("birth_date") @db.Date
  emergencyContactName  String?   @map("emergency_contact_name") @db.VarChar(100)
  emergencyContactPhone String?   @map("emergency_contact_phone") @db.VarChar(20)
  medicalConditions     String?   @map("medical_conditions") @db.Text
  notes                 String?   @db.Text
  /// Privacy-first opt-in for the monthly leaderboard; off by default.
  leaderboardOptIn      Boolean   @default(false) @map("leaderboard_opt_in")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  membership         Membership           @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  familyGroup        FamilyGroup?         @relation(fields: [familyGroupId], references: [id], onDelete: SetNull)
  homeBranch         Branch?              @relation("MemberHomeBranch", fields: [homeBranchId], references: [id], onDelete: SetNull)
  packages           MemberPackage[]
  bookings           Booking[]
  waitlistEntries    Waitlist[]
  payments           Payment[]
  storedCards        StoredCard[]
  subscriptions      MemberSubscription[]
  measurementEntries MeasurementEntry[]
  transfersOut       PackageTransfer[]    @relation("TransferFrom")
  transfersIn        PackageTransfer[]    @relation("TransferTo")
  billingProfile     BillingProfile?
  riskSnapshot       MemberRiskSnapshot?
  riskHistory        MemberRiskHistory[]
  badges             MemberBadge[]
  goals              MemberGoal[]
  ratingsGiven       SessionRating[]
  referralCode       ReferralCode?
  referralsMade      Referral[]           @relation("ReferralReferrer")
  healthSettings     MemberHealthSettings?
  healthSyncRecords  HealthSyncRecord[]
  healthDailySummaries HealthDailySummary[]
  videoViews         VideoView[]
  retailSales        Sale[]
  eventRegistrations EventRegistration[]

  @@index([studioId])
  @@map("member_profiles")
}

model TrainerProfile {
  id               String   @id @default(uuid()) @db.Uuid
  membershipId     String   @unique @map("membership_id") @db.Uuid
  studioId         String   @map("studio_id") @db.Uuid
  bio              String?  @db.Text
  commissionRuleId String?  @map("commission_rule_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  membership     Membership             @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  commissionRule CommissionRule?        @relation(fields: [commissionRuleId], references: [id], onDelete: SetNull)
  qualifications TrainerQualification[]
  schedules      SessionSchedule[]      @relation("ScheduleTrainer")
  substitutedFor SessionSchedule[]      @relation("ScheduleOriginalTrainer")
  payrollLines   PayrollLine[]
  ratingsReceived SessionRating[]
  videoContents   VideoContent[]
  eventOccurrences EventOccurrence[] @relation("EventOccurrenceTrainer")

  @@index([studioId])
  @@map("trainer_profiles")
}

model TrainerQualification {
  trainerProfileId String @map("trainer_profile_id") @db.Uuid
  serviceTypeId    String @map("service_type_id") @db.Uuid

  trainerProfile TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  serviceType    ServiceType    @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  @@id([trainerProfileId, serviceTypeId])
  @@map("trainer_qualifications")
}

// ---------------------------------------------------------------------------
// Catalogue: resources, services, policies (all tenant data)
// ---------------------------------------------------------------------------

/// e.g. room, reformer, EMS device, court, therapy bed.
model ResourceType {
  id                 String   @id @default(uuid()) @db.Uuid
  studioId           String   @map("studio_id") @db.Uuid
  name               String   @db.VarChar(80)
  /// true: members pick a specific unit ("reformer 3") when booking
  selectableByMember Boolean  @default(false) @map("selectable_by_member")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  studio     Studio                    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  resources  Resource[]
  requiredBy ServiceTypeResourceType[]

  @@unique([studioId, name])
  @@map("resource_types")
}

model Resource {
  id               String   @id @default(uuid()) @db.Uuid
  studioId         String   @map("studio_id") @db.Uuid
  branchId         String?  @map("branch_id") @db.Uuid
  resourceTypeId   String   @map("resource_type_id") @db.Uuid
  /// Equipment inside a room points at the room.
  parentResourceId String?  @map("parent_resource_id") @db.Uuid
  name             String   @db.VarChar(100)
  /// People who can use it at once; 1 for single-user equipment.
  capacity         Int      @default(1)
  serialNumber     String?  @map("serial_number") @db.VarChar(100)
  isMaintenance    Boolean  @default(false) @map("is_maintenance")
  isActive         Boolean  @default(true) @map("is_active")
  /// Grid coordinates for an optional spot map (e.g. equipment inside a room).
  layoutX          Int?     @map("layout_x")
  layoutY          Int?     @map("layout_y")
  /// Short visible label on a spot map, e.g. "3" or "Kort 2".
  label            String?  @db.VarChar(40)
  createdAt        DateTime @default(now()) @map("created_at")

  studio           Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  resourceType     ResourceType      @relation(fields: [resourceTypeId], references: [id])
  parent           Resource?         @relation("ResourceChildren", fields: [parentResourceId], references: [id], onDelete: SetNull)
  children         Resource[]        @relation("ResourceChildren")
  schedules        SessionSchedule[]
  bookingResources BookingResource[]
  eventOccurrences EventOccurrence[]

  @@index([studioId, resourceTypeId])
  @@map("resources")
}

model CancellationPolicy {
  id                    String   @id @default(uuid()) @db.Uuid
  studioId              String   @map("studio_id") @db.Uuid
  name                  String   @db.VarChar(80)
  /// Cancelling at least this many hours before start returns the unit.
  freeCancelHours       Int      @map("free_cancel_hours")
  lateCancelChargeUnits Int      @default(1) @map("late_cancel_charge_units")
  noShowChargeUnits     Int      @default(1) @map("no_show_charge_units")
  isDefault             Boolean  @default(false) @map("is_default")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")

  studio       Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  serviceTypes ServiceType[]

  @@index([studioId])
  @@map("cancellation_policies")
}

model CommissionRule {
  id        String         @id @default(uuid()) @db.Uuid
  studioId  String         @map("studio_id") @db.Uuid
  name      String         @db.VarChar(80)
  type      CommissionType
  /// Amount for fixed/salary, percent for PERCENTAGE.
  value     Decimal        @db.Decimal(10, 2)
  createdAt DateTime       @default(now()) @map("created_at")

  studio       Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  trainers     TrainerProfile[]
  serviceTypes ServiceType[]

  @@index([studioId])
  @@map("commission_rules")
}

// ---------------------------------------------------------------------------
// Payroll (trainer commission runs, W14)
// ---------------------------------------------------------------------------

/// One payroll cycle for a period, optionally scoped to a branch. DRAFT runs
/// can be regenerated (their lines are replaced); APPROVED and PAID runs are
/// immutable. See docs/PAYROLL.md for the commission formula.
model PayrollRun {
  id               String           @id @default(uuid()) @db.Uuid
  studioId         String           @map("studio_id") @db.Uuid
  /// Null covers every branch of the studio.
  branchId         String?          @map("branch_id") @db.Uuid
  periodStart      DateTime         @map("period_start")
  periodEnd        DateTime         @map("period_end")
  status           PayrollRunStatus @default(DRAFT)
  totalGross       Decimal          @default(0) @map("total_gross") @db.Decimal(12, 2)
  totalAdjustments Decimal          @default(0) @map("total_adjustments") @db.Decimal(12, 2)
  totalNet         Decimal          @default(0) @map("total_net") @db.Decimal(12, 2)
  createdByUserId  String           @map("created_by_user_id") @db.Uuid
  approvedByUserId String?          @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?        @map("approved_at")
  paidAt           DateTime?        @map("paid_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  studio     Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  branch     Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy  User          @relation("PayrollRunCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy User?         @relation("PayrollRunApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  lines      PayrollLine[]

  @@index([studioId, branchId, periodStart, periodEnd])
  @@index([studioId, status])
  @@map("payroll_runs")
}

/// One trainer's line within a run. `lines` holds the per-session detail the
/// calculator produced (schedule id, rule applied, unit price, amount).
model PayrollLine {
  id               String   @id @default(uuid()) @db.Uuid
  runId            String   @map("run_id") @db.Uuid
  studioId         String   @map("studio_id") @db.Uuid
  trainerProfileId String   @map("trainer_profile_id") @db.Uuid
  sessions         Int      @default(0)
  attendees        Int      @default(0)
  grossAmount      Decimal  @default(0) @map("gross_amount") @db.Decimal(12, 2)
  /// Manual correction, positive or negative; requires `note` (audited).
  adjustments      Decimal  @default(0) @map("adjustments") @db.Decimal(12, 2)
  netAmount        Decimal  @default(0) @map("net_amount") @db.Decimal(12, 2)
  note             String?  @db.Text
  lines            Json
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  run            PayrollRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  studio         Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  trainerProfile TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)

  @@unique([runId, trainerProfileId])
  @@index([studioId, trainerProfileId])
  @@map("payroll_lines")
}

/// What can be booked: "Private reformer", "EMS 20 min", "Padel court 1h".
model ServiceType {
  id                      String            @id @default(uuid()) @db.Uuid
  studioId                String            @map("studio_id") @db.Uuid
  name                    String            @db.VarChar(100)
  description             String?           @db.Text
  durationMin             Int               @map("duration_min")
  capacity                Int               @default(1)
  minRepeatIntervalDays   Int?              @map("min_repeat_interval_days")
  prerequisiteFormId      String?           @map("prerequisite_form_id") @db.Uuid
  allowedEntitlementKinds EntitlementKind[] @map("allowed_entitlement_kinds")
  cancellationPolicyId    String?           @map("cancellation_policy_id") @db.Uuid
  commissionRuleId        String?           @map("commission_rule_id") @db.Uuid
  /// Only trainers with a TrainerQualification for this service may teach it.
  requiresQualification   Boolean           @default(false) @map("requires_qualification")
  /// Maps this tenant-defined service to a generic Apple Health / Health
  /// Connect workout type (W21). Never hardcoded per sector; defaults to OTHER.
  healthActivityType      HealthActivityType @default(OTHER) @map("health_activity_type")
  isActive                Boolean           @default(true) @map("is_active")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  studio                Studio                     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  prerequisiteForm      MeasurementFormTemplate?   @relation(fields: [prerequisiteFormId], references: [id], onDelete: SetNull)
  cancellationPolicy    CancellationPolicy?        @relation(fields: [cancellationPolicyId], references: [id], onDelete: SetNull)
  commissionRule        CommissionRule?            @relation(fields: [commissionRuleId], references: [id], onDelete: SetNull)
  requiredResourceTypes ServiceTypeResourceType[]
  qualifiedTrainers     TrainerQualification[]
  packageServices       PackageDefinitionService[]
  schedules             SessionSchedule[]
  leads                 Lead[]
  interestedContacts    Contact[]
  ratings               SessionRating[]
  videoContents         VideoContent[]
  eventTicketTypes      EventTicketType[]

  @@unique([studioId, name])
  @@map("service_types")
}

/// Each booking of the service needs `quantity` units of this resource type.
model ServiceTypeResourceType {
  serviceTypeId  String @map("service_type_id") @db.Uuid
  resourceTypeId String @map("resource_type_id") @db.Uuid
  quantity       Int    @default(1)

  serviceType  ServiceType  @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  resourceType ResourceType @relation(fields: [resourceTypeId], references: [id], onDelete: Cascade)

  @@id([serviceTypeId, resourceTypeId])
  @@map("service_type_resource_types")
}

// ---------------------------------------------------------------------------
// Packages and entitlements
// ---------------------------------------------------------------------------

model PackageDefinition {
  id                String          @id @default(uuid()) @db.Uuid
  studioId          String          @map("studio_id") @db.Uuid
  name              String          @db.VarChar(100)
  entitlementKind   EntitlementKind @map("entitlement_kind")
  /// Sessions for SESSION_COUNT, credits for CREDIT, null for TIME_UNLIMITED.
  totalUnits        Int?            @map("total_units")
  validityDays      Int             @map("validity_days")
  price             Decimal         @db.Decimal(10, 2)
  freezeDaysAllowed Int             @default(0) @map("freeze_days_allowed")
  isTransferable    Boolean         @default(false) @map("is_transferable")
  maxFamilyMembers  Int             @default(1) @map("max_family_members")
  isActive          Boolean         @default(true) @map("is_active")
  /// W9: a trial offer. Limited to trialLimitPerUser purchases per global user at this studio.
  isTrial           Boolean         @default(false) @map("is_trial")
  trialLimitPerUser Int             @default(1) @map("trial_limit_per_user")
  createdAt         DateTime        @default(now()) @map("created_at")

  studio           Studio                     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  services         PackageDefinitionService[]
  memberPackages   MemberPackage[]
  subscriptions    MemberSubscription[]
  trialRedemptions TrialRedemption[]
  videoContents    VideoContentPackage[]
  accessTierRules  AccessTierRule[]

  @@index([studioId, isActive])
  @@index([studioId, isTrial])
  @@map("package_definitions")
}

/// Which services a package covers and how many units each booking burns.
model PackageDefinitionService {
  packageDefinitionId String @map("package_definition_id") @db.Uuid
  serviceTypeId       String @map("service_type_id") @db.Uuid
  unitCost            Int    @default(1) @map("unit_cost")

  packageDefinition PackageDefinition @relation(fields: [packageDefinitionId], references: [id], onDelete: Cascade)
  serviceType       ServiceType       @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  @@id([packageDefinitionId, serviceTypeId])
  @@map("package_definition_services")
}

model MemberPackage {
  id                  String          @id @default(uuid()) @db.Uuid
  studioId            String          @map("studio_id") @db.Uuid
  memberId            String          @map("member_id") @db.Uuid
  packageDefinitionId String          @map("package_definition_id") @db.Uuid
  entitlementKind     EntitlementKind @map("entitlement_kind")
  totalUnits          Int?            @map("total_units")
  usedUnits           Int             @default(0) @map("used_units")
  remainingUnits      Int?            @map("remaining_units")
  status              PackageStatus   @default(ACTIVE)
  startDate           DateTime        @default(now()) @map("start_date")
  endDate             DateTime        @map("end_date")
  frozenUntil         DateTime?       @map("frozen_until")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  studio            Studio                 @relation(fields: [studioId], references: [id], onDelete: Cascade)
  member            MemberProfile          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  packageDefinition PackageDefinition      @relation(fields: [packageDefinitionId], references: [id])
  freezeHistories   PackageFreezeHistory[]
  transfers         PackageTransfer[]
  bookings          Booking[]
  payments          Payment[]
  waitlistEntries   Waitlist[]
  trialRedemptions  TrialRedemption[]
  eventRegistrations EventRegistration[]

  @@index([studioId, memberId, status])
  @@map("member_packages")
}

model PackageFreezeHistory {
  id              String   @id @default(uuid()) @db.Uuid
  memberPackageId String   @map("member_package_id") @db.Uuid
  freezeStartDate DateTime @map("freeze_start_date")
  freezeEndDate   DateTime @map("freeze_end_date")
  reason          String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  memberPackage MemberPackage @relation(fields: [memberPackageId], references: [id], onDelete: Cascade)

  @@index([memberPackageId])
  @@map("package_freeze_history")
}

model PackageTransfer {
  id              String   @id @default(uuid()) @db.Uuid
  studioId        String   @map("studio_id") @db.Uuid
  memberPackageId String   @map("member_package_id") @db.Uuid
  fromMemberId    String   @map("from_member_id") @db.Uuid
  toMemberId      String   @map("to_member_id") @db.Uuid
  units           Int
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  studio        Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  memberPackage MemberPackage @relation(fields: [memberPackageId], references: [id], onDelete: Cascade)
  fromMember    MemberProfile @relation("TransferFrom", fields: [fromMemberId], references: [id])
  toMember      MemberProfile @relation("TransferTo", fields: [toMemberId], references: [id])
  createdBy     User          @relation(fields: [createdByUserId], references: [id])

  @@index([studioId, createdAt])
  @@map("package_transfers")
}

model FamilyGroup {
  id        String   @id @default(uuid()) @db.Uuid
  studioId  String   @map("studio_id") @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  studio  Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  members MemberProfile[]

  @@index([studioId])
  @@map("family_groups")
}

// ---------------------------------------------------------------------------
// Scheduling and bookings
// ---------------------------------------------------------------------------

model SessionSchedule {
  id                 String   @id @default(uuid()) @db.Uuid
  studioId           String   @map("studio_id") @db.Uuid
  branchId           String?  @map("branch_id") @db.Uuid
  serviceTypeId      String   @map("service_type_id") @db.Uuid
  /// Room or court the whole session occupies (optional).
  resourceId         String?  @map("resource_id") @db.Uuid
  trainerId          String?  @map("trainer_id") @db.Uuid
  /// Set when a substitute teaches instead of the planned trainer.
  originalTrainerId  String?  @map("original_trainer_id") @db.Uuid
  title              String   @db.VarChar(120)
  startTime          DateTime @map("start_time")
  endTime            DateTime @map("end_time")
  capacity           Int      @default(1)
  bookedCount        Int      @default(0) @map("booked_count")
  isCancelled        Boolean  @default(false) @map("is_cancelled")
  cancellationReason String?  @map("cancellation_reason") @db.Text
  /// W19: IN_PERSON by default. ONLINE/HYBRID sessions carry a meeting link,
  /// never returned by listing endpoints - only through the join endpoint,
  /// within the join window, to a member with a confirmed/attended booking.
  deliveryMode    SessionDeliveryMode @default(IN_PERSON) @map("delivery_mode")
  /// Optional cap on remote attendees for HYBRID sessions; null means unlimited.
  onlineCapacity  Int?                 @map("online_capacity")
  meetingProvider VideoMeetingProviderKind? @map("meeting_provider")
  /// https-only. For MANUAL this is the staff-pasted URL; for JITSI it is
  /// the generated room URL (base URL + unguessable room name).
  meetingUrl      String?              @map("meeting_url") @db.Text
  createdAt          DateTime @default(now()) @map("created_at")

  studio          Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  branch          Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  serviceType     ServiceType     @relation(fields: [serviceTypeId], references: [id])
  resource        Resource?       @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  trainer         TrainerProfile? @relation("ScheduleTrainer", fields: [trainerId], references: [id])
  originalTrainer TrainerProfile? @relation("ScheduleOriginalTrainer", fields: [originalTrainerId], references: [id])
  bookings        Booking[]
  waitlist        Waitlist[]
  partnerSpotAllocations PartnerSpotAllocation[]

  @@index([studioId, startTime, endTime])
  @@index([trainerId, startTime, endTime])
  @@index([resourceId, startTime, endTime])
  @@map("session_schedules")
}

model Booking {
  id                 String        @id @default(uuid()) @db.Uuid
  studioId           String        @map("studio_id") @db.Uuid
  scheduleId         String        @map("schedule_id") @db.Uuid
  memberId           String        @map("member_id") @db.Uuid
  memberPackageId    String?       @map("member_package_id") @db.Uuid
  status             BookingStatus @default(CONFIRMED)
  unitsCharged       Int           @default(0) @map("units_charged")
  checkInAt          DateTime?     @map("check_in_at")
  cancelledAt        DateTime?     @map("cancelled_at")
  cancellationReason String?       @map("cancellation_reason") @db.Text
  isLateCancellation Boolean       @default(false) @map("is_late_cancellation")
  /// Units kept by the business under the cancellation / no-show policy.
  penaltyUnits       Int           @default(0) @map("penalty_units")
  /// Set once a "rate your session" push has been sent for this booking,
  /// so promptRecentAttendees() never sends it twice.
  ratingPromptSentAt DateTime?     @map("rating_prompt_sent_at")
  /// W20: set when this booking was created by a partner/marketplace
  /// integration (ClassPass, Urban Sports Club, Wellhub, ...) rather than
  /// the studio or the member themselves. memberId still always points at a
  /// real MemberProfile (see docs/PARTNERS.md for why); partnerGuestId
  /// carries the partner's own guest identity for display/reporting.
  partnerConnectionId    String?  @map("partner_connection_id") @db.Uuid
  externalReservationId  String?  @map("external_reservation_id") @db.VarChar(120)
  partnerGuestId         String?  @map("partner_guest_id") @db.Uuid
  /// True once a partner-side cancellation has been applied to this booking;
  /// such cancellations follow the partner's own policy flag, not the
  /// studio's CancellationPolicy (see PartnerConnectionConfig).
  partnerCancelled       Boolean  @default(false) @map("partner_cancelled")
  /// W19: set once the "join is open" push has been sent for an ONLINE/HYBRID
  /// session's booking, so the heartbeat never sends it twice.
  joinReminderSentAt DateTime?     @map("join_reminder_sent_at")
  createdAt          DateTime      @default(now()) @map("created_at")

  studio            Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  schedule          SessionSchedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  member            MemberProfile     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberPackage     MemberPackage?    @relation(fields: [memberPackageId], references: [id])
  partnerConnection PartnerConnection? @relation(fields: [partnerConnectionId], references: [id], onDelete: SetNull)
  partnerGuest      PartnerGuest?      @relation(fields: [partnerGuestId], references: [id], onDelete: SetNull)
  resources         BookingResource[]
  rating            SessionRating?
  healthSyncRecords HealthSyncRecord[]

  @@unique([scheduleId, memberId])
  @@unique([partnerConnectionId, externalReservationId])
  @@index([studioId, status])
  @@index([memberId])
  @@index([partnerConnectionId])
  @@map("bookings")
}

/// Unit assigned to a booking ("reformer 3"). Times are copied from the
/// schedule so overlap checks need no join; single-capacity resources get a
/// database exclusion constraint in the migration.
model BookingResource {
  id         String   @id @default(uuid()) @db.Uuid
  studioId   String   @map("studio_id") @db.Uuid
  bookingId  String   @map("booking_id") @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  startTime  DateTime @map("start_time")
  endTime    DateTime @map("end_time")
  /// Copied from resource.capacity == 1. Enforced by the exclusion
  /// constraint booking_resources_no_overlap (see migration).
  exclusive  Boolean  @default(false)
  isActive   Boolean  @default(true) @map("is_active")

  studio   Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id])

  @@unique([bookingId, resourceId])
  @@index([resourceId, startTime, endTime])
  @@map("booking_resources")
}

model Waitlist {
  id              String         @id @default(uuid()) @db.Uuid
  studioId        String         @map("studio_id") @db.Uuid
  scheduleId      String         @map("schedule_id") @db.Uuid
  memberId        String         @map("member_id") @db.Uuid
  /// Package charged when the entry is promoted to a booking.
  memberPackageId String?        @map("member_package_id") @db.Uuid
  position        Int
  status          WaitlistStatus @default(WAITING)
  offeredAt       DateTime?      @map("offered_at")
  resolvedAt      DateTime?      @map("resolved_at")
  /// Why a promotion attempt failed (e.g. package ran out of units).
  failureReason   String?        @map("failure_reason") @db.VarChar(200)
  createdAt       DateTime       @default(now()) @map("created_at")

  studio        Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  schedule      SessionSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  member        MemberProfile   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberPackage MemberPackage?  @relation(fields: [memberPackageId], references: [id], onDelete: SetNull)

  @@unique([scheduleId, memberId])
  @@index([scheduleId, status, position])
  @@map("waitlist")
}

// ---------------------------------------------------------------------------
// Check-in kiosk and QR (W17)
// ---------------------------------------------------------------------------

/// A static, branch-bound QR point a member scans to check in (a poster at
/// the entrance). Only the SHA-256 hash of the point token is stored; the
/// raw token is returned once, on creation or rotation, for the QR image.
/// No turnstile/door integration: this only marks a booking ATTENDED.
model CheckInPoint {
  id        String   @id @default(uuid()) @db.Uuid
  studioId  String   @map("studio_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  name      String   @db.VarChar(100)
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([branchId])
  @@map("check_in_points")
}

/// A tablet paired to one branch as a check-in kiosk. Pairing is a one-time
/// code (hashed, short-lived); once paired the kiosk holds a long-lived
/// kiosk-scoped JWT (typ "kiosk") that only KioskAuthGuard accepts.
/// Revocation (revokedAt) is checked on every kiosk request.
model KioskDevice {
  id                   String    @id @default(uuid()) @db.Uuid
  studioId             String    @map("studio_id") @db.Uuid
  branchId             String    @map("branch_id") @db.Uuid
  name                 String    @db.VarChar(100)
  pairingCodeHash      String?   @map("pairing_code_hash") @db.VarChar(64)
  pairingCodeExpiresAt DateTime? @map("pairing_code_expires_at")
  pairedAt             DateTime? @map("paired_at")
  lastSeenAt           DateTime? @map("last_seen_at")
  revokedAt            DateTime? @map("revoked_at")
  createdByUserId      String    @map("created_by_user_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at")

  studio    Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy User   @relation("KioskDeviceCreatedBy", fields: [createdByUserId], references: [id])

  @@index([studioId])
  @@index([branchId])
  @@map("kiosk_devices")
}

// ---------------------------------------------------------------------------
// Measurements
// ---------------------------------------------------------------------------

/// studioId null: platform template (optionally tied to a business type).
model MeasurementFormTemplate {
  id                     String   @id @default(uuid()) @db.Uuid
  studioId               String?  @map("studio_id") @db.Uuid
  businessTypeTemplateId String?  @map("business_type_template_id") @db.Uuid
  name                   String   @db.VarChar(100)
  version                Int      @default(1)
  /// Field definitions validated by a Zod schema in @platform/shared.
  fields                 Json
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")

  studio               Studio?               @relation(fields: [studioId], references: [id], onDelete: Cascade)
  businessTypeTemplate BusinessTypeTemplate? @relation(fields: [businessTypeTemplateId], references: [id], onDelete: SetNull)
  entries              MeasurementEntry[]
  requiredBy           ServiceType[]

  @@index([studioId])
  @@map("measurement_form_templates")
}

model MeasurementEntry {
  id               String   @id @default(uuid()) @db.Uuid
  studioId         String   @map("studio_id") @db.Uuid
  memberId         String   @map("member_id") @db.Uuid
  formTemplateId   String   @map("form_template_id") @db.Uuid
  values           Json
  recordedByUserId String   @map("recorded_by_user_id") @db.Uuid
  recordedAt       DateTime @default(now()) @map("recorded_at")

  studio       Studio                  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  member       MemberProfile           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  formTemplate MeasurementFormTemplate @relation(fields: [formTemplateId], references: [id])
  recordedBy   User                    @relation(fields: [recordedByUserId], references: [id])

  @@index([studioId, memberId, recordedAt])
  @@map("measurement_entries")
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

model Payment {
  id                   String           @id @default(uuid()) @db.Uuid
  studioId             String           @map("studio_id") @db.Uuid
  /// Null for a guest or walk-in payment (event guest, retail walk-in); see
  /// docs/MUHASEBE.md. contactId then names the payer when known.
  memberId             String?          @map("member_id") @db.Uuid
  /// CRM contact who paid when there is no member (same studio, checked by
  /// the services that write it, like sales.contact_id).
  contactId            String?          @map("contact_id") @db.Uuid
  memberPackageId      String?          @map("member_package_id") @db.Uuid
  memberSubscriptionId String?          @map("member_subscription_id") @db.Uuid
  storedCardId         String?          @map("stored_card_id") @db.Uuid
  /// Branch where the sale happened, for per-branch revenue.
  branchId             String?          @map("branch_id") @db.Uuid
  amount               Decimal          @db.Decimal(10, 2)
  currency             String           @default("TRY") @db.VarChar(3)
  /// Amount refunded so far; must never exceed amount.
  refundedAmount       Decimal          @default(0) @map("refunded_amount") @db.Decimal(10, 2)
  paymentMethod        PaymentMethod    @map("payment_method")
  paymentStatus        PaymentStatus    @default(COMPLETED) @map("payment_status")
  provider             PaymentProvider?
  /// Card installment count, 1-12. Only meaningful for card payments.
  installmentCount     Int              @default(1) @map("installment_count")
  receiptNumber        String?          @map("receipt_number") @db.VarChar(60)
  providerReference    String?          @map("provider_reference") @db.VarChar(120)
  notes                String?          @db.Text
  /// Bookkeeping for a PENDING payment (e.g. bank transfer) that has not yet
  /// created its MemberPackage: { packageDefinitionId, startDate }.
  metadata             Json?
  paidAt               DateTime         @default(now()) @map("paid_at")
  /// W9: promo code applied to this sale, and the amount it discounted off the list price.
  promoCodeId          String?          @map("promo_code_id") @db.Uuid
  discountAmount       Decimal          @default(0) @map("discount_amount") @db.Decimal(10, 2)
  /// W9: gift card used to cover part or all of this sale, and how much of it (and of any
  /// refund) has moved through that card so far.
  giftCardId           String?          @map("gift_card_id") @db.Uuid
  giftCardAmount       Decimal          @default(0) @map("gift_card_amount") @db.Decimal(10, 2)
  giftCardRefunded     Decimal          @default(0) @map("gift_card_refunded") @db.Decimal(10, 2)

  studio             Studio                @relation(fields: [studioId], references: [id], onDelete: Cascade)
  member             MemberProfile?        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  contact            Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  memberPackage      MemberPackage?        @relation(fields: [memberPackageId], references: [id], onDelete: SetNull)
  memberSubscription MemberSubscription?   @relation(fields: [memberSubscriptionId], references: [id], onDelete: SetNull)
  storedCard         StoredCard?           @relation(fields: [storedCardId], references: [id], onDelete: SetNull)
  branch             Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  promoCode          PromoCode?            @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  giftCard           GiftCard?             @relation(fields: [giftCardId], references: [id], onDelete: SetNull)
  attempts           PaymentAttempt[]
  invoice            Invoice?
  promoRedemption    PromoRedemption?
  giftCardTxs        GiftCardTransaction[]
  retailSale         Sale?
  eventRegistration  EventRegistration?
  payoutItems        PayoutItem[]

  @@index([studioId, paidAt])
  @@index([branchId, paidAt])
  @@index([provider, providerReference])
  @@index([promoCodeId])
  @@index([giftCardId])
  @@index([contactId])
  @@map("payments")
}

/// A tokenized card on file for a member. The PAN/CVV never touch this
/// database: only the provider's opaque card token plus display metadata.
model StoredCard {
  id                String          @id @default(uuid()) @db.Uuid
  studioId          String          @map("studio_id") @db.Uuid
  memberId          String          @map("member_id") @db.Uuid
  provider          PaymentProvider @default(MOCK)
  providerCardToken String          @map("provider_card_token") @db.VarChar(200)
  last4             String          @db.VarChar(4)
  brand             String          @db.VarChar(20)
  expMonth          Int             @map("exp_month")
  expYear           Int             @map("exp_year")
  isDefault         Boolean         @default(false) @map("is_default")
  createdAt         DateTime        @default(now()) @map("created_at")

  studio        Studio               @relation(fields: [studioId], references: [id], onDelete: Cascade)
  member        MemberProfile        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  subscriptions MemberSubscription[]
  payments      Payment[]

  @@index([studioId, memberId])
  @@map("stored_cards")
}

/// Auto-renewing membership tied to a package definition, charged on
/// nextChargeAt by the dunning service.
model MemberSubscription {
  id                  String                   @id @default(uuid()) @db.Uuid
  studioId            String                   @map("studio_id") @db.Uuid
  memberId            String                   @map("member_id") @db.Uuid
  packageDefinitionId String                   @map("package_definition_id") @db.Uuid
  storedCardId        String?                  @map("stored_card_id") @db.Uuid
  status              MemberSubscriptionStatus @default(ACTIVE)
  currentPeriodStart  DateTime                 @map("current_period_start")
  currentPeriodEnd    DateTime                 @map("current_period_end")
  nextChargeAt        DateTime                 @map("next_charge_at")
  cancelAtPeriodEnd   Boolean                  @default(false) @map("cancel_at_period_end")
  /// Card installment count applied to each renewal charge, 1-12.
  installmentCount    Int                      @default(1) @map("installment_count")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  studio            Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  member            MemberProfile     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  packageDefinition PackageDefinition @relation(fields: [packageDefinitionId], references: [id])
  storedCard        StoredCard?       @relation(fields: [storedCardId], references: [id], onDelete: SetNull)
  attempts          PaymentAttempt[]
  payments          Payment[]

  @@index([studioId, memberId])
  @@index([status, nextChargeAt])
  @@map("member_subscriptions")
}

/// One dunning attempt to charge a due subscription.
model PaymentAttempt {
  id                   String               @id @default(uuid()) @db.Uuid
  studioId             String               @map("studio_id") @db.Uuid
  memberSubscriptionId String               @map("member_subscription_id") @db.Uuid
  paymentId            String?              @map("payment_id") @db.Uuid
  attemptNumber        Int                  @map("attempt_number")
  status               PaymentAttemptStatus
  failureCode          String?              @map("failure_code") @db.VarChar(60)
  nextRetryAt          DateTime?            @map("next_retry_at")
  createdAt            DateTime             @default(now()) @map("created_at")

  studio       Studio             @relation(fields: [studioId], references: [id], onDelete: Cascade)
  subscription MemberSubscription @relation(fields: [memberSubscriptionId], references: [id], onDelete: Cascade)
  payment      Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([memberSubscriptionId])
  @@map("payment_attempts")
}

// ---------------------------------------------------------------------------
// W9: sales tools (trial offers, promo codes, gift cards)
// ---------------------------------------------------------------------------

/// One (studioId, userId, packageDefinitionId) trial purchase, so the trial
/// limit check + insert stays race-safe under concurrent checkouts.
model TrialRedemption {
  id                  String   @id @default(uuid()) @db.Uuid
  studioId            String   @map("studio_id") @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  packageDefinitionId String   @map("package_definition_id") @db.Uuid
  memberPackageId     String   @map("member_package_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")

  studio            Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  packageDefinition PackageDefinition @relation(fields: [packageDefinitionId], references: [id], onDelete: Cascade)
  memberPackage     MemberPackage     @relation(fields: [memberPackageId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id])

  @@index([studioId, userId, packageDefinitionId])
  @@map("trial_redemptions")
}

/// Generic per-user redemption counter, shared by the trial-offer limit and
/// the promo code per-user limit. Race-safe: a conditional updateMany
/// (count < limit) increments an existing row, a unique-constraint-guarded
/// create seeds the first one.
model RedemptionCounter {
  id        String                   @id @default(uuid()) @db.Uuid
  studioId  String                   @map("studio_id") @db.Uuid
  subject   RedemptionCounterSubject
  subjectId String                   @map("subject_id") @db.Uuid
  userId    String                   @map("user_id") @db.Uuid
  count     Int                      @default(0)
  updatedAt DateTime                 @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, subject, subjectId, userId])
  @@map("redemption_counters")
}

model PromoCode {
  id                             String        @id @default(uuid()) @db.Uuid
  studioId                       String        @map("studio_id") @db.Uuid
  /// Always stored upper-case; unique per studio, case-insensitively.
  code                           String        @db.VarChar(40)
  kind                           PromoCodeKind
  value                          Decimal       @db.Decimal(10, 2)
  validFrom                      DateTime?     @map("valid_from")
  validTo                        DateTime?     @map("valid_to")
  maxRedemptions                 Int?          @map("max_redemptions")
  redeemedCount                  Int           @default(0) @map("redeemed_count")
  perUserLimit                   Int           @default(1) @map("per_user_limit")
  minAmount                      Decimal?      @map("min_amount") @db.Decimal(10, 2)
  /// Empty means every package definition of the studio qualifies.
  applicablePackageDefinitionIds String[]      @default([]) @map("applicable_package_definition_ids")
  newMembersOnly                 Boolean       @default(false) @map("new_members_only")
  /// G3a: a loyalty reward code only this user may redeem. Null = anyone.
  restrictedToUserId             String?       @map("restricted_to_user_id") @db.Uuid
  isActive                       Boolean       @default(true) @map("is_active")
  createdByUserId                String        @map("created_by_user_id") @db.Uuid
  createdAt                      DateTime      @default(now()) @map("created_at")
  updatedAt                      DateTime      @updatedAt @map("updated_at")

  studio      Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("PromoCodeCreatedBy", fields: [createdByUserId], references: [id])
  redemptions PromoRedemption[]
  payments    Payment[]
  loyaltyRedemptions LoyaltyRedemption[]

  @@unique([studioId, code])
  @@index([studioId, isActive])
  @@map("promo_codes")
}

/// One redemption of a promo code, tied 1:1 to the payment it discounted.
model PromoRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  promoCodeId    String   @map("promo_code_id") @db.Uuid
  studioId       String   @map("studio_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  paymentId      String   @unique @map("payment_id") @db.Uuid
  discountAmount Decimal  @map("discount_amount") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  studio    Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  payment   Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([promoCodeId, userId])
  @@index([studioId, userId])
  @@map("promo_redemptions")
}

/// A gift card's real code is shown once, at creation. Only its sha256 hash
/// and last 4 characters are stored, so a leaked database row cannot be
/// spent, and balance checks are a constant-time indexed hash lookup.
model GiftCard {
  id              String         @id @default(uuid()) @db.Uuid
  studioId        String         @map("studio_id") @db.Uuid
  codeHash        String         @map("code_hash") @db.VarChar(64)
  last4           String         @map("last4") @db.VarChar(4)
  initialAmount   Decimal        @map("initial_amount") @db.Decimal(10, 2)
  balance         Decimal        @db.Decimal(10, 2)
  currency        String         @default("TRY") @db.VarChar(3)
  purchaserUserId String?        @map("purchaser_user_id") @db.Uuid
  recipientName   String?        @map("recipient_name") @db.VarChar(120)
  recipientPhone  String?        @map("recipient_phone") @db.VarChar(20)
  message         String?        @db.Text
  expiresAt       DateTime?      @map("expires_at")
  status          GiftCardStatus @default(ACTIVE)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  studio       Studio                @relation(fields: [studioId], references: [id], onDelete: Cascade)
  purchaser    User?                 @relation("GiftCardPurchaser", fields: [purchaserUserId], references: [id], onDelete: SetNull)
  transactions GiftCardTransaction[]
  payments     Payment[]

  @@unique([studioId, codeHash])
  @@index([studioId, status])
  @@index([purchaserUserId])
  @@map("gift_cards")
}

model GiftCardTransaction {
  id          String                  @id @default(uuid()) @db.Uuid
  giftCardId  String                  @map("gift_card_id") @db.Uuid
  studioId    String                  @map("studio_id") @db.Uuid
  type        GiftCardTransactionType
  amount      Decimal                 @db.Decimal(10, 2)
  paymentId   String?                 @map("payment_id") @db.Uuid
  actorUserId String?                 @map("actor_user_id") @db.Uuid
  note        String?                 @db.Text
  createdAt   DateTime                @default(now()) @map("created_at")

  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  studio   Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  payment  Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  actor    User?    @relation("GiftCardTransactionActor", fields: [actorUserId], references: [id])

  @@index([giftCardId, createdAt])
  @@map("gift_card_transactions")
}

model Expense {
  id              String   @id @default(uuid()) @db.Uuid
  studioId        String   @map("studio_id") @db.Uuid
  branchId        String?  @map("branch_id") @db.Uuid
  category        String   @db.VarChar(60)
  amount          Decimal  @db.Decimal(10, 2)
  spentAt         DateTime @map("spent_at")
  note            String?  @db.Text
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  studio    Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy User    @relation(fields: [createdByUserId], references: [id])

  @@index([studioId, spentAt])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Notifications and SMS credits
// ---------------------------------------------------------------------------

/// Secret feed token for the user's personal ICS calendar subscription
/// (GET /calendar/:token.ics, no auth). Only a sha256 hash of the token is
/// stored; the raw token is returned once, on create or rotate. One row
/// per user: rotating replaces it, revoking deletes it.
model CalendarFeedToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @unique @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_feed_tokens")
}

/// Expo push token of one installed app. A token belongs to one user at a
/// time; signing in on the same phone as someone else moves it.
model PushDevice {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  token      String    @unique @db.VarChar(255)
  platform   String    @db.VarChar(10)
  deviceName String?   @map("device_name") @db.VarChar(100)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  /// Set when Expo reports DeviceNotRegistered.
  disabledAt DateTime? @map("disabled_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

/// Per-user override of a category default from NOTIFICATION_CATEGORIES in
/// @platform/shared. Missing rows mean "use the default".
model NotificationPreference {
  userId    String   @map("user_id") @db.Uuid
  category  String   @db.VarChar(40)
  push      Boolean
  sms       Boolean
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
  @@map("notification_preferences")
}

/// One wallet per tenant. Credits drop only when an SMS is actually sent.
model SmsWallet {
  id                  String   @id @default(uuid()) @db.Uuid
  studioId            String   @unique @map("studio_id") @db.Uuid
  balance             Int      @default(0)
  lowBalanceThreshold Int      @default(100) @map("low_balance_threshold")
  updatedAt           DateTime @updatedAt @map("updated_at")

  studio       Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  transactions SmsTransaction[]

  @@map("sms_wallets")
}

model SmsTransaction {
  id                String             @id @default(uuid()) @db.Uuid
  studioId          String             @map("studio_id") @db.Uuid
  walletId          String             @map("wallet_id") @db.Uuid
  type              SmsTransactionType
  /// Positive for PURCHASE/REFUND/credit adjustments, negative for USAGE.
  amount            Int
  balanceAfter      Int                @map("balance_after")
  smsPackageId      String?            @map("sms_package_id") @db.Uuid
  notificationLogId String?            @unique @map("notification_log_id") @db.Uuid
  createdByUserId   String?            @map("created_by_user_id") @db.Uuid
  note              String?            @db.Text
  createdAt         DateTime           @default(now()) @map("created_at")

  studio          Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  wallet          SmsWallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  smsPackage      SmsPackage?      @relation(fields: [smsPackageId], references: [id])
  notificationLog NotificationLog? @relation(fields: [notificationLogId], references: [id])
  createdBy       User?            @relation(fields: [createdByUserId], references: [id])

  @@index([studioId, createdAt])
  @@map("sms_transactions")
}

/// The delivery record of every message the engine sends (one row per
/// channel attempt; fallbacks chain through fallbackOfId). G1c extended it
/// for email, push, in-app, tracking and idempotency instead of adding a
/// parallel table.
model NotificationLog {
  id                String              @id @default(uuid()) @db.Uuid
  /// Null for platform messages such as login codes.
  studioId          String?             @map("studio_id") @db.Uuid
  /// E.164. Null for email/push/in-app attempts without a phone.
  recipientPhone    String?             @map("recipient_phone") @db.VarChar(20)
  recipientEmail    String?             @map("recipient_email") @db.VarChar(254)
  /// The recipient's user (members); no FK, the record outlives the account.
  userId            String?             @map("user_id") @db.Uuid
  contactId         String?             @map("contact_id") @db.Uuid
  channel           NotificationChannel
  purpose           MessagePurpose      @default(TRANSACTIONAL)
  /// Template key, e.g. BOOKING_REMINDER, PACKAGE_EXPIRY, INVITE
  type              String              @db.VarChar(50)
  /// MessageTemplate row used, null for built-in defaults and free text.
  templateId        String?             @map("template_id") @db.Uuid
  locale            String?             @db.VarChar(10)
  subject           String?             @db.VarChar(200)
  /// Rendered text (the plain-text part for email); redacted for codes.
  content           String              @db.Text
  status            NotificationStatus  @default(PENDING)
  /// Provider registry key that handled the attempt, e.g. NETGSM, SES, EXPO.
  provider          String?             @db.VarChar(30)
  providerMessageId String?             @map("provider_message_id") @db.VarChar(120)
  /// Set on the SMS attempt that replaced a failed WhatsApp attempt.
  fallbackOfId      String?             @map("fallback_of_id") @db.Uuid
  errorMessage      String?             @map("error_message") @db.Text
  /// Caller-supplied de-duplication key, unique per studio.
  idempotencyKey    String?             @map("idempotency_key") @db.VarChar(200)
  /// G2a: the campaign this message belongs to.
  campaignId        String?             @map("campaign_id") @db.Uuid
  /// G2a: the journey enrollment (one contact's run through a journey) that sent it.
  journeyRunId      String?             @map("journey_run_id") @db.Uuid
  deliveredAt       DateTime?           @map("delivered_at")
  /// First human open; machine (privacy proxy) opens only set machineOpenedAt.
  openedAt          DateTime?           @map("opened_at")
  machineOpenedAt   DateTime?           @map("machine_opened_at")
  clickedAt         DateTime?           @map("clicked_at")
  bouncedAt         DateTime?           @map("bounced_at")
  complainedAt      DateTime?           @map("complained_at")
  /// In-app messages: when the member read it.
  readAt            DateTime?           @map("read_at")
  createdAt         DateTime            @default(now()) @map("created_at")

  studio         Studio?                @relation(fields: [studioId], references: [id], onDelete: Cascade)
  contact        Contact?               @relation(fields: [contactId], references: [id], onDelete: SetNull)
  campaign       Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  journeyRun     JourneyEnrollment?     @relation(fields: [journeyRunId], references: [id], onDelete: SetNull)
  fallbackOf     NotificationLog?       @relation("NotificationFallback", fields: [fallbackOfId], references: [id])
  fallbacks      NotificationLog[]      @relation("NotificationFallback")
  smsTransaction SmsTransaction?
  links          MessageLink[]
  trackingEvents MessageTrackingEvent[]

  @@unique([studioId, idempotencyKey])
  @@index([studioId, createdAt])
  @@index([providerMessageId])
  @@index([studioId, contactId, purpose, createdAt])
  @@index([studioId, userId, createdAt])
  @@index([campaignId])
  @@index([journeyRunId])
  @@map("notification_logs")
}

/// A click-tracking target: the tracking token only references this row, so
/// the redirect can never be pointed at an arbitrary URL (no open redirect).
model MessageLink {
  id                String   @id @default(uuid()) @db.Uuid
  studioId          String   @map("studio_id") @db.Uuid
  notificationLogId String   @map("notification_log_id") @db.Uuid
  url               String   @db.Text
  createdAt         DateTime @default(now()) @map("created_at")

  studio          Studio                 @relation(fields: [studioId], references: [id], onDelete: Cascade)
  notificationLog NotificationLog        @relation(fields: [notificationLogId], references: [id], onDelete: Cascade)
  events          MessageTrackingEvent[]

  @@index([notificationLogId])
  @@map("message_links")
}

/// Delivery, open, click, bounce, complaint and unsubscribe events of one
/// sent message. No IP address or user agent is stored.
model MessageTrackingEvent {
  id                String                   @id @default(uuid()) @db.Uuid
  studioId          String                   @map("studio_id") @db.Uuid
  notificationLogId String                   @map("notification_log_id") @db.Uuid
  type              MessageTrackingEventType
  /// Opens by a privacy proxy (Apple Mail Privacy Protection) or scanner.
  isMachine         Boolean                  @default(false) @map("is_machine")
  linkId            String?                  @map("link_id") @db.Uuid
  /// Short machine-readable detail, e.g. "apple_mpp", "Permanent/General".
  detail            String?                  @db.VarChar(80)
  occurredAt        DateTime                 @default(now()) @map("occurred_at")

  studio          Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  notificationLog NotificationLog @relation(fields: [notificationLogId], references: [id], onDelete: Cascade)
  link            MessageLink?    @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([notificationLogId])
  @@index([studioId, type, occurredAt])
  @@map("message_tracking_events")
}

/// Addresses that must not receive COMMERCIAL messages on a channel:
/// unsubscribes, STOP keywords, hard bounces and complaints.
model MessageSuppression {
  id                String              @id @default(uuid()) @db.Uuid
  studioId          String              @map("studio_id") @db.Uuid
  channel           NotificationChannel
  /// Lower-cased email or E.164 phone.
  address           String              @db.VarChar(254)
  reason            SuppressionReason
  contactId         String?             @map("contact_id") @db.Uuid
  notificationLogId String?             @map("notification_log_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  studio  Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([studioId, channel, address])
  @@index([studioId, contactId])
  @@map("message_suppressions")
}

/// Inbox thread with one contact on one channel. At most one OPEN
/// conversation per (studio, contact, channel): partial unique index in the
/// migration SQL.
model Conversation {
  id                   String              @id @default(uuid()) @db.Uuid
  studioId             String              @map("studio_id") @db.Uuid
  contactId            String              @map("contact_id") @db.Uuid
  channel              NotificationChannel
  status               ConversationStatus  @default(OPEN)
  assignedMembershipId String?             @map("assigned_membership_id") @db.Uuid
  /// Phone (SMS/WhatsApp) or email the contact writes from; null for in-app.
  externalAddress      String?             @map("external_address") @db.VarChar(254)
  lastMessageAt        DateTime            @default(now()) @map("last_message_at")
  /// Last message from the contact (WhatsApp 24h customer-service window).
  lastInboundAt        DateTime?           @map("last_inbound_at")
  lastMessagePreview   String              @default("") @map("last_message_preview") @db.VarChar(200)
  unreadCount          Int                 @default(0) @map("unread_count")
  closedAt             DateTime?           @map("closed_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  studio             Studio                @relation(fields: [studioId], references: [id], onDelete: Cascade)
  contact            Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedMembership Membership?           @relation("ConversationAssignee", fields: [assignedMembershipId], references: [id], onDelete: SetNull)
  messages           ConversationMessage[]

  @@index([studioId, status, lastMessageAt])
  @@index([studioId, assignedMembershipId])
  @@index([studioId, contactId])
  @@map("conversations")
}

/// One message in a conversation. Attachments are metadata only (the media
/// stays with the provider).
model ConversationMessage {
  id                 String           @id @default(uuid()) @db.Uuid
  studioId           String           @map("studio_id") @db.Uuid
  conversationId     String           @map("conversation_id") @db.Uuid
  direction          MessageDirection
  body               String           @db.Text
  provider           String?          @db.VarChar(30)
  /// Inbound: unique per studio (partial index in SQL) so webhook retries are idempotent.
  providerMessageId  String?          @map("provider_message_id") @db.VarChar(120)
  /// RECEIVED for inbound; the NotificationLog status for outbound.
  status             String           @default("RECEIVED") @db.VarChar(20)
  attachments        Json             @default("[]")
  authorMembershipId String?          @map("author_membership_id") @db.Uuid
  notificationLogId  String?          @map("notification_log_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at")

  studio           Studio       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorMembership Membership?  @relation("ConversationMessageAuthor", fields: [authorMembershipId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([providerMessageId])
  @@map("conversation_messages")
}

/// Tenant-authored canned replies for the inbox.
model SavedReply {
  id                    String   @id @default(uuid()) @db.Uuid
  studioId              String   @map("studio_id") @db.Uuid
  title                 String   @db.VarChar(80)
  body                  String   @db.Text
  createdByMembershipId String?  @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@map("saved_replies")
}

/// Message copy is tenant data, not code. Null studioId rows are the global
/// defaults a super admin curates; a tenant row with the same key/channel/
/// locale overrides it. {named} (and legacy {{named}}) placeholders are
/// substituted at send time.
model MessageTemplate {
  id                   String              @id @default(uuid()) @db.Uuid
  /// Null for the global default, set by super admin.
  studioId             String?             @map("studio_id") @db.Uuid
  key                  String              @db.VarChar(60)
  channel              NotificationChannel
  locale               String              @default("tr") @db.VarChar(5)
  body                 String              @db.Text
  /// Meta-approved WhatsApp template name, required when channel is WHATSAPP.
  whatsappTemplateName String?             @map("whatsapp_template_name") @db.VarChar(120)
  /// Meta approval state (PENDING, APPROVED, REJECTED); only APPROVED is sent.
  whatsappStatus       String              @default("APPROVED") @map("whatsapp_status") @db.VarChar(20)
  /// EMAIL: subject line (also the push/in-app title).
  subject              String?             @db.VarChar(200)
  /// EMAIL: block list (packages/shared/src/email-blocks.ts); null renders `body` as one paragraph.
  blocks               Json?
  /// Utility/transactional templates bypass commercial consent gating.
  isTransactional      Boolean             @default(true) @map("is_transactional")
  isActive             Boolean             @default(true) @map("is_active")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  studio Studio? @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, key, channel, locale])
  @@index([key])
  @@map("message_templates")
}

/// İYS-style commercial communication consent, tracked per tenant, user and
/// channel. Transactional messages never require this; commercial ones do.
model CommunicationConsent {
  id          String         @id @default(uuid()) @db.Uuid
  studioId    String         @map("studio_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  channel     ConsentChannel
  status      ConsentStatus  @default(GRANTED)
  /// Where the consent was captured, e.g. "member-app", "staff-entry".
  source      String         @db.VarChar(60)
  grantedAt   DateTime?      @map("granted_at")
  revokedAt   DateTime?      @map("revoked_at")
  /// Set once the status change has been pushed to the real İYS API.
  iysSyncedAt DateTime?      @map("iys_synced_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([studioId, userId, channel])
  @@index([studioId, status])
  @@index([iysSyncedAt])
  @@map("communication_consents")
}

// ---------------------------------------------------------------------------
// Lead pipeline (W11)
// ---------------------------------------------------------------------------

/// A prospect, not yet a member. Converts into a User/Membership/MemberProfile
/// on WON. The migration that creates this table hand-adds a partial unique
/// index on (studio_id, phone) covering only open leads (stage not in
/// WON/LOST), since Prisma cannot express a partial unique index in the
/// schema; `prisma migrate diff` will therefore show it as drift, which is
/// expected and documented in that migration's header comment.
model Lead {
  id                    String     @id @default(uuid()) @db.Uuid
  studioId              String     @map("studio_id") @db.Uuid
  branchId              String?    @map("branch_id") @db.Uuid
  fullName              String     @map("full_name") @db.VarChar(150)
  /// E.164, e.g. +905321112233
  phone                 String     @db.VarChar(20)
  /// Equals phone while the lead is open (not WON/LOST), null otherwise;
  /// the unique key below allows one open lead per phone per studio.
  openPhone             String?    @map("open_phone") @db.VarChar(20)
  email                 String?    @db.VarChar(120)
  source                LeadSource @default(OTHER)
  sourceDetail          String?    @map("source_detail") @db.VarChar(200)
  interestServiceTypeId String?    @map("interest_service_type_id") @db.Uuid
  stage                 LeadStage  @default(NEW)
  lostReason            String?    @map("lost_reason") @db.Text
  ownerMembershipId     String?    @map("owner_membership_id") @db.Uuid
  nextFollowUpAt        DateTime?  @map("next_follow_up_at")
  convertedMembershipId String?    @map("converted_membership_id") @db.Uuid
  utmSource             String?    @map("utm_source") @db.VarChar(100)
  utmMedium             String?    @map("utm_medium") @db.VarChar(100)
  utmCampaign           String?    @map("utm_campaign") @db.VarChar(100)
  /// Referrer's short code from the "Arkadaşını getir" link, if the lead
  /// came through one. Carried over to the Referral record on conversion.
  referralCode          String?    @map("referral_code") @db.VarChar(24)
  notes                 String?    @db.Text
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  studio              Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  branch              Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  interestServiceType ServiceType?   @relation(fields: [interestServiceTypeId], references: [id], onDelete: SetNull)
  ownerMembership     Membership?    @relation("LeadOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  convertedMembership Membership?    @relation("LeadConverted", fields: [convertedMembershipId], references: [id], onDelete: SetNull)
  activities          LeadActivity[]

  @@unique([studioId, openPhone])
  @@index([studioId, stage])
  @@index([studioId, phone])
  @@index([studioId, nextFollowUpAt])
  @@map("leads")
}

model LeadActivity {
  id                String           @id @default(uuid()) @db.Uuid
  leadId            String           @map("lead_id") @db.Uuid
  studioId          String           @map("studio_id") @db.Uuid
  type              LeadActivityType
  body              String           @db.Text
  actorMembershipId String?          @map("actor_membership_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at")

  lead            Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  studio          Studio      @relation(fields: [studioId], references: [id], onDelete: Cascade)
  actorMembership Membership? @relation("LeadActivityActor", fields: [actorMembershipId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

// ---------------------------------------------------------------------------
// G1b: CRM contacts, visitor/touchpoint attribution, conversion events
// (docs/CRM_VE_ATIF.md, docs/BUYUME_VE_GLOBAL_MIMARI.md 3.1-3.3). Contact
// replaces Lead/LeadActivity, which stay in place unwritten until the
// contract release drops them.
// ---------------------------------------------------------------------------

/// Mirrors LIFECYCLE_STAGES in @platform/shared (growth/conversions.ts).
enum ContactLifecycleStage {
  LEAD
  TRIAL
  MEMBER
  LAPSED
  LOST
}

/// Terminal behaviour of a tenant pipeline stage.
enum PipelineStageKind {
  OPEN
  WON
  LOST
}

enum ContactTaskStatus {
  OPEN
  DONE
  CANCELLED
}

/// Tenant-defined sales pipeline stage. Every tenant gets the system
/// defaults (NEW, CONTACTED, TRIAL_BOOKED, TRIAL_DONE, WON, LOST); a null
/// name renders the i18n label crm.stage.<key>.
model PipelineStage {
  id        String            @id @default(uuid()) @db.Uuid
  studioId  String            @map("studio_id") @db.Uuid
  key       String            @db.VarChar(40)
  name      String?           @db.VarChar(80)
  kind      PipelineStageKind @default(OPEN)
  sortOrder Int               @default(0) @map("sort_order")
  isSystem  Boolean           @default(false) @map("is_system")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  studio   Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  contacts Contact[]

  @@unique([studioId, key])
  @@index([studioId, sortOrder])
  @@map("pipeline_stages")
}

/// One known person per tenant: lead, trial, member or former member.
/// Phone and lower(email) are unique per studio among unmerged rows
/// (partial unique indexes in the migration SQL).
model Contact {
  id                    String                @id @default(uuid()) @db.Uuid
  studioId              String                @map("studio_id") @db.Uuid
  firstName             String                @map("first_name") @db.VarChar(60)
  lastName              String                @default("") @map("last_name") @db.VarChar(60)
  /// E.164, e.g. +905321112233
  phone                 String?               @db.VarChar(20)
  email                 String?               @db.VarChar(120)
  locale                String?               @db.VarChar(10)
  countryCode           String?               @map("country_code") @db.VarChar(2)
  timezone              String?               @db.VarChar(60)
  lifecycleStage        ContactLifecycleStage @default(LEAD) @map("lifecycle_stage")
  /// Null when the contact is not in the sales pipeline (e.g. a member who
  /// never came in as a lead).
  pipelineStageId       String?               @map("pipeline_stage_id") @db.Uuid
  ownerMembershipId     String?               @map("owner_membership_id") @db.Uuid
  branchId              String?               @map("branch_id") @db.Uuid
  tags                  String[]              @default([])
  /// Values keyed by ContactFieldDefinition.key.
  customFields          Json                  @default("{}") @map("custom_fields")
  /// The tenant membership this contact became (one contact per membership).
  membershipId          String?               @unique @map("membership_id") @db.Uuid
  firstTouchpointId     String?               @map("first_touchpoint_id") @db.Uuid
  lastTouchpointId      String?               @map("last_touchpoint_id") @db.Uuid
  // Attribution summary copied from the first/last touchpoint for fast reporting.
  firstSource           String?               @map("first_source") @db.VarChar(250)
  firstMedium           String?               @map("first_medium") @db.VarChar(250)
  firstCampaignName     String?               @map("first_campaign_name") @db.VarChar(250)
  firstCampaignId       String?               @map("first_campaign_id") @db.VarChar(250)
  firstAdsetId          String?               @map("first_adset_id") @db.VarChar(250)
  firstAdId             String?               @map("first_ad_id") @db.VarChar(250)
  lastSource            String?               @map("last_source") @db.VarChar(250)
  lastMedium            String?               @map("last_medium") @db.VarChar(250)
  lastCampaignName      String?               @map("last_campaign_name") @db.VarChar(250)
  lastCampaignId        String?               @map("last_campaign_id") @db.VarChar(250)
  lastAdsetId           String?               @map("last_adset_id") @db.VarChar(250)
  lastAdId              String?               @map("last_ad_id") @db.VarChar(250)
  /// Manual acquisition channel (WEB_FORM, INSTAGRAM, WALK_IN, REFERRAL, PHONE, OTHER, ...).
  sourceChannel         String?               @map("source_channel") @db.VarChar(30)
  sourceDetail          String?               @map("source_detail") @db.VarChar(200)
  interestServiceTypeId String?               @map("interest_service_type_id") @db.Uuid
  lostReason            String?               @map("lost_reason") @db.Text
  nextFollowUpAt        DateTime?             @map("next_follow_up_at")
  referralCode          String?               @map("referral_code") @db.VarChar(24)
  notes                 String?               @db.Text
  /// Test traffic: kept, never reported and never sent to ad platforms.
  isTest                Boolean               @default(false) @map("is_test")
  /// A business (merchant/trader) rather than a private person: the TR
  /// merchant exemption for commercial messages may apply (M3e).
  isBusiness            Boolean               @default(false) @map("is_business")
  /// Set on the losing side of a merge; merged rows are hidden everywhere.
  mergedIntoId          String?               @map("merged_into_id") @db.Uuid
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  studio              Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  pipelineStage       PipelineStage?    @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  ownerMembership     Membership?       @relation("ContactOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  membership          Membership?       @relation("ContactMembership", fields: [membershipId], references: [id], onDelete: SetNull)
  branch              Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  interestServiceType ServiceType?      @relation(fields: [interestServiceTypeId], references: [id], onDelete: SetNull)
  firstTouchpoint     Touchpoint?       @relation("ContactFirstTouch", fields: [firstTouchpointId], references: [id], onDelete: SetNull)
  lastTouchpoint      Touchpoint?       @relation("ContactLastTouch", fields: [lastTouchpointId], references: [id], onDelete: SetNull)
  mergedInto          Contact?          @relation("ContactMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom          Contact[]         @relation("ContactMerge")
  activities          ContactActivity[]
  tasks               ContactTask[]
  visitors            Visitor[]
  touchpoints         Touchpoint[]      @relation("TouchpointContact")
  conversions         ConversionEvent[]
  notificationLogs    NotificationLog[]
  conversations       Conversation[]
  suppressions        MessageSuppression[]
  consents            ContactConsent[]
  segmentMemberships  SegmentMember[]
  campaignRecipients  CampaignRecipient[]
  journeyEnrollments  JourneyEnrollment[]
  retailSales         Sale[]
  eventRegistrations  EventRegistration[]
  payments            Payment[]

  @@index([studioId, lifecycleStage])
  @@index([studioId, pipelineStageId])
  @@index([studioId, ownerMembershipId])
  @@index([studioId, phone])
  @@index([studioId, nextFollowUpAt])
  @@index([studioId, firstSource])
  @@index([studioId, lastSource])
  @@index([tags], type: Gin)
  @@map("contacts")
}

/// Timeline entry on a contact (replaces LeadActivity). type is one of
/// CONTACT_ACTIVITY_TYPES in @platform/shared.
model ContactActivity {
  id                String   @id @default(uuid()) @db.Uuid
  studioId          String   @map("studio_id") @db.Uuid
  contactId         String   @map("contact_id") @db.Uuid
  type              String   @db.VarChar(30)
  body              String   @db.Text
  actorMembershipId String?  @map("actor_membership_id") @db.Uuid
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")

  studio          Studio      @relation(fields: [studioId], references: [id], onDelete: Cascade)
  contact         Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  actorMembership Membership? @relation("ContactActivityActor", fields: [actorMembershipId], references: [id], onDelete: SetNull)

  @@index([contactId, createdAt])
  @@index([studioId, createdAt])
  @@map("contact_activities")
}

/// Tenant custom contact field. label is a locale -> text map so tenants
/// can name the field in each language they use.
model ContactFieldDefinition {
  id         String   @id @default(uuid()) @db.Uuid
  studioId   String   @map("studio_id") @db.Uuid
  key        String   @db.VarChar(60)
  label      Json
  /// One of CONTACT_FIELD_KINDS in @platform/shared.
  kind       String   @db.VarChar(20)
  /// Allowed values when kind is enum.
  options    String[] @default([])
  sortOrder  Int      @default(0) @map("sort_order")
  isArchived Boolean  @default(false) @map("is_archived")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, key])
  @@map("contact_field_definitions")
}

/// Follow-up work on a contact (call, message, visit) assigned to staff.
model ContactTask {
  id                    String            @id @default(uuid()) @db.Uuid
  studioId              String            @map("studio_id") @db.Uuid
  contactId             String            @map("contact_id") @db.Uuid
  title                 String            @db.VarChar(200)
  notes                 String?           @db.Text
  dueAt                 DateTime?         @map("due_at")
  assigneeMembershipId  String?           @map("assignee_membership_id") @db.Uuid
  status                ContactTaskStatus @default(OPEN)
  completedAt           DateTime?         @map("completed_at")
  createdByMembershipId String?           @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  studio              Studio      @relation(fields: [studioId], references: [id], onDelete: Cascade)
  contact             Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assigneeMembership  Membership? @relation("ContactTaskAssignee", fields: [assigneeMembershipId], references: [id], onDelete: SetNull)
  createdByMembership Membership? @relation("ContactTaskCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@index([studioId, status, dueAt])
  @@index([contactId])
  @@index([assigneeMembershipId, status])
  @@map("contact_tasks")
}

/// Anonymous browser identity (the pw_vid first-party cookie) per tenant.
model Visitor {
  /// The pw_vid cookie value.
  id          String   @db.Uuid
  studioId    String   @map("studio_id") @db.Uuid
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  contactId   String?  @map("contact_id") @db.Uuid

  studio      Studio       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  touchpoints Touchpoint[]

  @@id([studioId, id])
  @@index([studioId, contactId])
  @@map("visitors")
}

/// First request of a visit session (or any request carrying tracking
/// parameters). Never stores an IP address or a query string.
model Touchpoint {
  id             String   @id @default(uuid()) @db.Uuid
  studioId       String   @map("studio_id") @db.Uuid
  visitorId      String   @map("visitor_id") @db.Uuid
  sessionId      String   @map("session_id") @db.Uuid
  occurredAt     DateTime @default(now()) @map("occurred_at")
  landingHost    String?  @map("landing_host") @db.VarChar(255)
  /// Path only; the query string and fragment are stripped before storage.
  landingPath    String   @map("landing_path") @db.VarChar(2000)
  referrerHost   String?  @map("referrer_host") @db.VarChar(255)
  utmSource      String?  @map("utm_source") @db.VarChar(250)
  utmMedium      String?  @map("utm_medium") @db.VarChar(250)
  utmCampaign    String?  @map("utm_campaign") @db.VarChar(250)
  utmId          String?  @map("utm_id") @db.VarChar(250)
  utmTerm        String?  @map("utm_term") @db.VarChar(250)
  utmContent     String?  @map("utm_content") @db.VarChar(250)
  /// One of AD_PLATFORMS in @platform/shared.
  adPlatform     String?  @map("ad_platform") @db.VarChar(20)
  pwCid          String?  @map("pw_cid") @db.VarChar(250)
  pwAsid         String?  @map("pw_asid") @db.VarChar(250)
  pwAdid         String?  @map("pw_adid") @db.VarChar(250)
  pwPlc          String?  @map("pw_plc") @db.VarChar(250)
  // Click ids and Meta browser cookies: stored only with advertising consent.
  fbclid         String?  @db.VarChar(250)
  gclid          String?  @db.VarChar(250)
  gbraid         String?  @db.VarChar(250)
  wbraid         String?  @db.VarChar(250)
  ttclid         String?  @db.VarChar(250)
  liFatId        String?  @map("li_fat_id") @db.VarChar(250)
  msclkid        String?  @db.VarChar(250)
  fbp            String?  @db.VarChar(250)
  fbc            String?  @db.VarChar(250)
  locale         String?  @db.VarChar(10)
  /// Coarse country from the edge proxy header; the IP is never stored.
  countryCode    String?  @map("country_code") @db.VarChar(2)
  deviceType     String?  @map("device_type") @db.VarChar(10)
  pageVariant    String?  @map("page_variant") @db.VarChar(40)
  isPaidUntagged Boolean  @default(false) @map("is_paid_untagged")
  /// consent.advertising at capture time (G2b). Gates whether a delivery to
  /// Meta/Google/TikTok may use this touchpoint's identifiers at all; click
  /// ids and fbp/fbc are only ever populated when this is true.
  advertisingConsent Boolean @default(false) @map("advertising_consent")
  /// Business-to-business referral code from the pw_ref parameter (G5c-1);
  /// only meaningful on the platform tenant.
  refCode        String?  @map("ref_code") @db.VarChar(16)
  contactId      String?  @map("contact_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  studio           Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  visitor          Visitor           @relation(fields: [studioId, visitorId], references: [studioId, id], onDelete: Cascade)
  contact          Contact?          @relation("TouchpointContact", fields: [contactId], references: [id], onDelete: SetNull)
  firstTouchOf     Contact[]         @relation("ContactFirstTouch")
  lastTouchOf      Contact[]         @relation("ContactLastTouch")
  attributedEvents ConversionEvent[]
  studioReferrals  StudioReferral[]

  @@index([studioId, visitorId, occurredAt])
  @@index([studioId, contactId, occurredAt])
  @@index([studioId, occurredAt])
  @@index([studioId, sessionId])
  @@map("touchpoints")
}

/// Funnel event (CONVERSION_EVENT_TYPES in @platform/shared). Idempotent
/// on (studioId, sourceKind, sourceId).
model ConversionEvent {
  id                     String   @id @default(uuid()) @db.Uuid
  studioId               String   @map("studio_id") @db.Uuid
  /// Shared with the browser pixel so ad platforms de-duplicate.
  eventId                String   @map("event_id") @db.VarChar(100)
  type                   String   @db.VarChar(30)
  occurredAt             DateTime @map("occurred_at")
  contactId              String   @map("contact_id") @db.Uuid
  valueAmount            Decimal? @map("value_amount") @db.Decimal(14, 4)
  currency               String?  @db.VarChar(3)
  sourceKind             String   @map("source_kind") @db.VarChar(40)
  sourceId               String   @map("source_id") @db.VarChar(100)
  isTest                 Boolean  @default(false) @map("is_test")
  /// Last touchpoint before the event within the attribution window.
  attributedTouchpointId String?  @map("attributed_touchpoint_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at")

  studio               Studio               @relation(fields: [studioId], references: [id], onDelete: Cascade)
  contact              Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  attributedTouchpoint Touchpoint?          @relation(fields: [attributedTouchpointId], references: [id], onDelete: SetNull)
  deliveries           ConversionDelivery[]

  @@unique([studioId, eventId])
  @@unique([studioId, sourceKind, sourceId])
  @@index([studioId, type, occurredAt])
  /// Funnel reports (G5d-1): per-type scan of a studio's events grouped by contact.
  @@index([studioId, type, contactId, occurredAt])
  @@index([contactId])
  @@map("conversion_events")
}

/// Outbox row per (event, ad platform target). Written as PENDING only
/// when the tenant has that ad platform connected; delivered by G2b.
model ConversionDelivery {
  id                String    @id @default(uuid()) @db.Uuid
  studioId          String    @map("studio_id") @db.Uuid
  conversionEventId String    @map("conversion_event_id") @db.Uuid
  /// One of CONVERSION_DELIVERY_TARGETS in @platform/shared.
  target            String    @db.VarChar(20)
  /// One of CONVERSION_DELIVERY_STATUSES in @platform/shared.
  status            String    @default("PENDING") @db.VarChar(24)
  attempts          Int       @default(0)
  nextAttemptAt     DateTime? @map("next_attempt_at")
  lastError         String?   @map("last_error") @db.Text
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  studio          Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  conversionEvent ConversionEvent @relation(fields: [conversionEventId], references: [id], onDelete: Cascade)

  @@unique([conversionEventId, target])
  @@index([status, nextAttemptAt])
  @@index([studioId])
  @@map("conversion_deliveries")
}

// ---------------------------------------------------------------------------
// G2b: ad platform connections, conversion delivery targets, spend sync
// ---------------------------------------------------------------------------

/// One tenant's connection to one ad platform account (docs/REKLAM_ENTEGRASYONU.md).
/// The platform tenant (Studio.isPlatform) connects the same way as any
/// other tenant. Credentials are encrypted with CredentialCipher; the API
/// never returns them, only credentialLast4.
model AdConnection {
  id                  String   @id @default(uuid()) @db.Uuid
  studioId            String   @map("studio_id") @db.Uuid
  /// One of AD_CONNECTION_PLATFORMS in @platform/shared.
  platform            String   @db.VarChar(10)
  label               String   @db.VarChar(80)
  /// One of AD_CONNECTION_STATUSES.
  status              String   @default("DISCONNECTED") @db.VarChar(20)
  /// Ad account id (Meta act_..., Google customer id, TikTok advertiser id).
  externalAccountId   String   @map("external_account_id") @db.VarChar(80)
  /// Meta pixel id / TikTok pixel code / Google's public "AW-XXXXXXXXX" tag id (not a secret).
  pixelOrDatasetId    String?  @map("pixel_or_dataset_id") @db.VarChar(80)
  /// Base64 iv+authTag+ciphertext of the platform credential object (CredentialCipher).
  encryptedCredentials String  @map("encrypted_credentials") @db.Text
  /// Last 4 characters of the identifying token, kept in the clear for display only.
  credentialLast4     String   @map("credential_last4") @db.VarChar(4)
  /// ConversionEventType -> platform conversion action id, where the platform needs one (Google Ads, TikTok).
  conversionActionIds Json     @default("{}") @map("conversion_action_ids")
  /// Test traffic (isTest events) is never delivered; this flag instead
  /// marks every *real* delivery from this connection as a platform test
  /// event (Meta test_event_code, Google/TikTok test flags), for a safe
  /// pre-launch check in Events Manager / Google Ads diagnostics.
  isTestMode          Boolean  @default(false) @map("is_test_mode")
  lastSyncAt          DateTime? @map("last_sync_at")
  lastError           String?  @db.Text @map("last_error")
  /// M4c: the Facebook Page whose Lead Ads this Meta connection receives; a
  /// webhook notification is routed to the connection by this id (unique
  /// across tenants, so one page never feeds two tenants).
  leadAdsPageId       String?  @unique @map("lead_ads_page_id") @db.VarChar(40)
  /// M4c: last time the page's app subscription was seen active (subscribed_apps check).
  leadAdsSubscribedAt DateTime? @map("lead_ads_subscribed_at")
  /// M4a: PASTED (entered by hand) or OAUTH (INTEGRATION_AUTH_METHODS in @platform/shared).
  authMethod          String    @default("PASTED") @map("auth_method") @db.VarChar(10)
  /// M4a: OAUTH_PROVIDERS value the token came from (null for pasted credentials).
  oauthProvider       String?   @map("oauth_provider") @db.VarChar(16)
  /// M4a: expiry of the stored OAuth token, when the provider gave one.
  tokenExpiresAt      DateTime? @map("token_expires_at")
  /// M4a: refresh token, CredentialCipher-encrypted (Google keeps a copy inside the credentials the adapter reads).
  encryptedRefreshToken String? @map("encrypted_refresh_token") @db.Text
  /// M4a: user who completed the OAuth consent.
  connectedByUserId   String?   @map("connected_by_user_id") @db.Uuid
  /// M4a: transient refresh failures in a row (backoff), reset on success.
  refreshAttempts     Int       @default(0) @map("refresh_attempts")
  /// M4a: when the heartbeat looks at the token next (null: never).
  nextRefreshAt       DateTime? @map("next_refresh_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, platform, label])
  @@index([studioId, status])
  @@index([authMethod, nextRefreshAt])
  @@map("ad_connections")
}

/// Campaign / ad set / ad structure synced daily from the platform APIs
/// (docs/BUYUME_VE_GLOBAL_MIMARI.md 3.4). Attribution is always keyed on
/// externalId (pw_cid/pw_asid/pw_adid), never on name, so a rename never
/// breaks a report; this table only refreshes the human-readable name shown
/// next to that id.
model AdEntity {
  id               String   @id @default(uuid()) @db.Uuid
  studioId         String   @map("studio_id") @db.Uuid
  /// One of AD_CONNECTION_PLATFORMS.
  platform         String   @db.VarChar(10)
  /// One of AD_ENTITY_LEVELS (CAMPAIGN | ADSET | AD).
  level            String   @db.VarChar(10)
  externalId       String   @map("external_id") @db.VarChar(80)
  name             String   @db.VarChar(250)
  status           String   @db.VarChar(20)
  /// externalId of the parent entity (adset's campaign, ad's adset); null for a campaign.
  parentExternalId String?  @map("parent_external_id") @db.VarChar(80)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, platform, level, externalId])
  @@index([studioId, platform, parentExternalId])
  @@map("ad_entities")
}

/// One row per (entity, day): spend, currency, impressions, clicks. Upserted
/// by the daily spend sync job and the manual refresh endpoint.
model AdSpendDaily {
  id         String   @id @default(uuid()) @db.Uuid
  studioId   String   @map("studio_id") @db.Uuid
  platform   String   @db.VarChar(10)
  level      String   @db.VarChar(10)
  externalId String   @map("external_id") @db.VarChar(80)
  date       DateTime @db.Date
  spendAmount Decimal @map("spend_amount") @db.Decimal(14, 4)
  currency   String   @db.VarChar(3)
  impressions Int     @default(0)
  clicks     Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, platform, level, externalId, date])
  @@index([studioId, platform, date])
  @@map("ad_spend_daily")
}

// ---------------------------------------------------------------------------
// W10: automated marketing and lifecycle flows
// ---------------------------------------------------------------------------

enum AutomationRuleType {
  /// No attendance for N days and no active package.
  WIN_BACK
  /// A package ends in N days, or has at most M remaining units.
  PACKAGE_EXPIRING
  BIRTHDAY
  /// N hours after a member's first ATTENDED booking.
  FIRST_CLASS_FOLLOW_UP
  /// N hours before a booking's session starts.
  BOOKING_REMINDER
  NO_SHOW_FOLLOW_UP
}

enum AutomationRunStatus {
  SENT
  SKIPPED
  FAILED
}

/// A tenant-configured lifecycle/marketing rule. Params are validated against
/// the shared discriminated-union Zod schema for `type` (see
/// AutomationRuleParamsSchema in @platform/shared); never a hardcoded enum
/// of session/business logic (rule 7).
model AutomationRule {
  id              String               @id @default(uuid()) @db.Uuid
  studioId        String               @map("studio_id") @db.Uuid
  type            AutomationRuleType
  name            String               @db.VarChar(100)
  /// Type-specific thresholds, e.g. { "noAttendanceDays": 30 }.
  params          Json
  /// MessageTemplate.key to render and send (see MESSAGE_TEMPLATE_KEYS).
  templateKey     String               @map("template_key") @db.VarChar(60)
  /// Optional preferred channel; falls back to the tenant's channel order.
  channel         NotificationChannel?
  /// Derived from `type` at creation time (reminders are transactional,
  /// win-back/birthday are marketing) and re-validated by the evaluator.
  isTransactional Boolean              @default(true) @map("is_transactional")
  isActive        Boolean              @default(false) @map("is_active")
  /// G2a: set once the rule has been converted into a journey; a migrated
  /// rule is never evaluated again (the journey sends instead).
  migratedJourneyId String?            @unique @map("migrated_journey_id") @db.Uuid
  migratedAt      DateTime?            @map("migrated_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  studio          Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  runs            AutomationRun[]
  migratedJourney Journey?        @relation("AutomationRuleMigration", fields: [migratedJourneyId], references: [id], onDelete: SetNull)

  @@index([studioId, type])
  @@index([studioId, isActive])
  @@map("automation_rules")
}

/// One delivery attempt for one rule/user/target. The unique constraint is
/// the at-most-once delivery guard: the evaluator inserts this row before
/// sending, so a second evaluation of the same target is a no-op.
model AutomationRun {
  id           String              @id @default(uuid()) @db.Uuid
  ruleId       String              @map("rule_id") @db.Uuid
  studioId     String              @map("studio_id") @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  /// The entity that triggered this run, e.g. a bookingId or memberPackageId.
  targetRef    String              @map("target_ref") @db.VarChar(80)
  scheduledFor DateTime            @map("scheduled_for")
  sentAt       DateTime?           @map("sent_at")
  status       AutomationRunStatus
  reason       String?             @db.Text
  createdAt    DateTime            @default(now()) @map("created_at")

  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  studio Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ruleId, userId, targetRef])
  @@index([studioId, ruleId, createdAt])
  @@map("automation_runs")
}

// ---------------------------------------------------------------------------
// Segments, contact consent, campaigns and journeys (G2a)
// ---------------------------------------------------------------------------

enum SegmentKind {
  DYNAMIC
  STATIC
}

/// A saved audience. DYNAMIC: `rules` (the segment DSL in @platform/shared)
/// is re-evaluated in the background and the result stored in
/// segment_members; STATIC: staff maintain segment_members by hand.
model Segment {
  id                    String      @id @default(uuid()) @db.Uuid
  studioId              String      @map("studio_id") @db.Uuid
  name                  String      @db.VarChar(120)
  description           String?     @db.Text
  kind                  SegmentKind @default(DYNAMIC)
  /// SegmentGroup JSON, validated with SegmentGroupSchema on every write.
  rules                 Json?
  cachedCount           Int         @default(0) @map("cached_count")
  refreshedAt           DateTime?   @map("refreshed_at")
  createdByMembershipId String?     @map("created_by_membership_id") @db.Uuid
  archivedAt            DateTime?   @map("archived_at")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  studio    Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  members   SegmentMember[]
  campaigns Campaign[]

  @@index([studioId, archivedAt])
  @@map("segments")
}

/// Current members of a segment. enteredAt drives the segment_entered
/// journey trigger.
model SegmentMember {
  segmentId     String   @map("segment_id") @db.Uuid
  contactId     String   @map("contact_id") @db.Uuid
  studioId      String   @map("studio_id") @db.Uuid
  enteredAt     DateTime @default(now()) @map("entered_at")
  addedManually Boolean  @default(false) @map("added_manually")

  segment Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  studio  Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@id([segmentId, contactId])
  @@index([studioId, contactId])
  @@index([segmentId, enteredAt])
  @@map("segment_members")
}

/// Commercial-message consent of a contact (with or without a user
/// account), per channel. Changes for TR contacts are pushed to İYS.
model ContactConsent {
  id          String         @id @default(uuid()) @db.Uuid
  studioId    String         @map("studio_id") @db.Uuid
  contactId   String         @map("contact_id") @db.Uuid
  channel     ConsentChannel
  status      ConsentStatus
  /// e.g. staff-entry, web-form, import, unsubscribe-link, stop-keyword.
  source      String         @db.VarChar(60)
  /// Staff note on how consent was obtained; never a copy of personal data.
  evidence    String?        @db.VarChar(300)
  grantedAt   DateTime?      @map("granted_at")
  revokedAt   DateTime?      @map("revoked_at")
  /// Set once the change has been pushed to İYS (TR only).
  iysSyncedAt DateTime?      @map("iys_synced_at")
  /// Why a commercial message may be sent (M3e). Null on rows written
  /// before M3e: treated as CONSENT.
  legalBasis  ConsentLegalBasis? @map("legal_basis")
  /// Double opt-in: when the person clicked the confirmation link. Only
  /// time is kept, never the IP address.
  confirmedAt DateTime?      @map("confirmed_at")
  /// Double opt-in was required at capture and a confirmation e-mail was
  /// requested; the consent does not count until confirmedAt is set.
  confirmationRequestedAt DateTime? @map("confirmation_requested_at")
  /// Version of the form (consent text) the person agreed to.
  formVersion String?        @map("form_version") @db.VarChar(60)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  studio        Studio                       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  contact       Contact                      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  confirmations ContactConsentConfirmation[]

  @@unique([contactId, channel])
  @@index([studioId, status])
  @@index([iysSyncedAt])
  @@map("contact_consents")
}

enum ConsentLegalBasis {
  CONSENT
  TR_MERCHANT_EXEMPTION
  EXISTING_CUSTOMER
}

/// Double opt-in confirmation link (M3e). Only the SHA-256 of the opaque
/// token is stored; the link is single use and expires after 7 days.
/// No IP address or device is recorded.
model ContactConsentConfirmation {
  id               String    @id @default(uuid()) @db.Uuid
  studioId         String    @map("studio_id") @db.Uuid
  contactConsentId String    @map("contact_consent_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at")
  confirmedAt      DateTime? @map("confirmed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  studio         Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  contactConsent ContactConsent @relation(fields: [contactConsentId], references: [id], onDelete: Cascade)

  @@index([contactConsentId, createdAt])
  @@index([studioId, createdAt])
  @@map("contact_consent_confirmations")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
  /// M3b: waiting for a super admin decision (platform tenant only).
  PENDING_APPROVAL
  /// M3b: stopped by a user; never sends until resumed.
  PAUSED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
  CANCELLED
}

/// One-off commercial broadcast of a message template to a segment.
model Campaign {
  id                    String               @id @default(uuid()) @db.Uuid
  studioId              String               @map("studio_id") @db.Uuid
  name                  String               @db.VarChar(120)
  segmentId             String               @map("segment_id") @db.Uuid
  /// Null: the tenant's channel order.
  channel               NotificationChannel?
  templateKey           String               @map("template_key") @db.VarChar(60)
  status                CampaignStatus       @default(DRAFT)
  scheduledAt           DateTime?            @map("scheduled_at")
  startedAt             DateTime?            @map("started_at")
  completedAt           DateTime?            @map("completed_at")
  cancelledAt           DateTime?            @map("cancelled_at")
  audienceCount         Int                  @default(0) @map("audience_count")
  createdByMembershipId String?              @map("created_by_membership_id") @db.Uuid
  /// M3b: the user who created it (set for super admins too, who have no membership).
  createdByUserId       String?              @map("created_by_user_id") @db.Uuid
  /// M3b: the approval request the campaign currently depends on (plain id; approval_requests.target_id points back).
  approvalRequestId     String?              @map("approval_request_id") @db.Uuid
  /// M3c: A/B test setup { testShare (percent), metric, waitMinutes }; null: no test.
  abTest                Json?                @map("ab_test")
  /// M3c: FIXED sends at the scheduled instant; the other modes schedule each recipient on their own clock.
  sendTimeMode          CampaignSendTimeMode @default(FIXED) @map("send_time_mode")
  /// M3c: "HH:mm" in the recipient's zone (RECIPIENT_LOCAL) or the fallback hour of BEST_TIME.
  sendTimeLocal         String?              @map("send_time_local") @db.VarChar(5)
  /// M3d: why the campaign is PAUSED when the system paused it (AUTO_BOUNCE, AUTO_COMPLAINT); null for a manual pause.
  pauseReason           String?              @map("pause_reason") @db.VarChar(40)
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  studio           Studio              @relation(fields: [studioId], references: [id], onDelete: Cascade)
  segment          Segment             @relation(fields: [segmentId], references: [id], onDelete: Restrict)
  recipients       CampaignRecipient[]
  notificationLogs NotificationLog[]
  variants         CampaignVariant[]

  @@index([studioId, status])
  @@index([status, scheduledAt])
  @@map("campaigns")
}

/// The audience snapshot of a campaign: at most one row (and one message)
/// per contact.
model CampaignRecipient {
  id                String                  @id @default(uuid()) @db.Uuid
  studioId          String                  @map("studio_id") @db.Uuid
  campaignId        String                  @map("campaign_id") @db.Uuid
  contactId         String                  @map("contact_id") @db.Uuid
  status            CampaignRecipientStatus @default(PENDING)
  /// Messaging engine reason code when not sent (CONSENT_REQUIRED, FREQUENCY_CAP, ...).
  reasonCode        String?                 @map("reason_code") @db.VarChar(40)
  channel           NotificationChannel?
  notificationLogId String?                 @map("notification_log_id") @db.Uuid
  attempts          Int                     @default(0)
  nextAttemptAt     DateTime?               @map("next_attempt_at")
  sentAt            DateTime?               @map("sent_at")
  /// M3c: the A/B variant this recipient gets; null: no test, or still held back until the winner is chosen.
  variantKey        String?                 @map("variant_key") @db.VarChar(2)
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  studio   Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status, nextAttemptAt])
  @@map("campaign_recipients")
}

enum JourneyStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum JourneyEnrollmentStatus {
  ACTIVE
  COMPLETED
  EXITED_GOAL
  EXITED
  CANCELLED
  FAILED
}

/// Multi-step automation (replaces the W10 automation rules). `definition`
/// is a JourneyDefinition validated with JourneyDefinitionSchema and
/// validateJourneyGraph on every write.
model Journey {
  id                    String              @id @default(uuid()) @db.Uuid
  studioId              String              @map("studio_id") @db.Uuid
  name                  String              @db.VarChar(120)
  description           String?             @db.Text
  status                JourneyStatus       @default(DRAFT)
  definition            Json
  /// JOURNEY_TEMPLATE_KEYS entry the journey was created from, if any.
  templateKey           String?             @map("template_key") @db.VarChar(40)
  /// The legacy rule this journey replaces (no double sending: its
  /// automation_runs are checked before enrolling).
  legacyRuleId          String?             @unique @map("legacy_rule_id") @db.Uuid
  legacyRuleType        AutomationRuleType? @map("legacy_rule_type")
  activatedAt           DateTime?           @map("activated_at")
  createdByMembershipId String?             @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  studio        Studio              @relation(fields: [studioId], references: [id], onDelete: Cascade)
  enrollments   JourneyEnrollment[]
  stepRuns      JourneyStepRun[]
  migratedRules AutomationRule[]    @relation("AutomationRuleMigration")

  @@index([studioId, status])
  @@index([status])
  @@map("journeys")
}

/// One contact's run through a journey. The unique (journey, contact,
/// triggerRef) index makes enrollment idempotent; lockKey enforces the
/// re-entry policy ("once" for NEVER, "active" while an AFTER_EXIT run is
/// in progress, null otherwise).
model JourneyEnrollment {
  id            String                  @id @default(uuid()) @db.Uuid
  studioId      String                  @map("studio_id") @db.Uuid
  journeyId     String                  @map("journey_id") @db.Uuid
  contactId     String                  @map("contact_id") @db.Uuid
  status        JourneyEnrollmentStatus @default(ACTIVE)
  triggerRef    String                  @map("trigger_ref") @db.VarChar(120)
  lockKey       String?                 @map("lock_key") @db.VarChar(10)
  currentStepId String?                 @map("current_step_id") @db.VarChar(40)
  /// When the current step was reached (the base of a wait step).
  stepEnteredAt DateTime                @map("step_entered_at")
  nextRunAt     DateTime?               @map("next_run_at")
  /// Claimed by a worker until this instant (concurrent heartbeats).
  lockedUntil   DateTime?               @map("locked_until")
  /// Template variables captured from the trigger (serviceName, startTime, ...).
  context       Json                    @default("{}")
  enteredAt     DateTime                @default(now()) @map("entered_at")
  completedAt   DateTime?               @map("completed_at")
  exitReason    String?                 @map("exit_reason") @db.VarChar(60)
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  studio           Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  journey          Journey           @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  contact          Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stepRuns         JourneyStepRun[]
  notificationLogs NotificationLog[]

  @@unique([journeyId, contactId, triggerRef])
  @@unique([journeyId, contactId, lockKey])
  @@index([status, nextRunAt])
  @@index([studioId, journeyId, status])
  @@index([contactId])
  @@map("journey_enrollments")
}

/// One executed step of one enrollment (the journey graph is acyclic, so a
/// step runs at most once per enrollment).
model JourneyStepRun {
  id                String   @id @default(uuid()) @db.Uuid
  studioId          String   @map("studio_id") @db.Uuid
  journeyId         String   @map("journey_id") @db.Uuid
  enrollmentId      String   @map("enrollment_id") @db.Uuid
  stepId            String   @map("step_id") @db.VarChar(40)
  stepType          String   @map("step_type") @db.VarChar(20)
  /// DONE, SKIPPED or FAILED.
  status            String   @db.VarChar(10)
  reasonCode        String?  @map("reason_code") @db.VarChar(40)
  notificationLogId String?  @map("notification_log_id") @db.Uuid
  detail            Json?
  createdAt         DateTime @default(now()) @map("created_at")

  studio     Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  journey    Journey           @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  enrollment JourneyEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, stepId])
  @@index([journeyId, stepId, status])
  @@map("journey_step_runs")
}

// ---------------------------------------------------------------------------
// Churn risk (W12)
// ---------------------------------------------------------------------------

/// Latest churn-risk computation per active member (one row per member,
/// upserted by ChurnService.recomputeStudio). `reasons` is a machine-key +
/// weight breakdown (see packages/shared/src/churn.ts). `snoozedUntil` hides
/// the member from the risky-members list without discarding the score.
model MemberRiskSnapshot {
  id                 String         @id @default(uuid()) @db.Uuid
  studioId           String         @map("studio_id") @db.Uuid
  memberId           String         @unique @map("member_id") @db.Uuid
  score              Int
  previousScore      Int?           @map("previous_score")
  level              ChurnRiskLevel
  onboarding         Boolean        @default(false)
  reasons            Json
  lastAttendedAt        DateTime?   @map("last_attended_at")
  activePackageEndDate  DateTime?   @map("active_package_end_date")
  contactedAt        DateTime?      @map("contacted_at")
  contactedByUserId  String?        @map("contacted_by_user_id") @db.Uuid
  contactNote        String?        @map("contact_note") @db.Text
  snoozedUntil       DateTime?      @map("snoozed_until")
  computedAt         DateTime       @default(now()) @map("computed_at")

  studio        Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  member        MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  contactedBy   User?   @relation("RiskSnapshotContactedBy", fields: [contactedByUserId], references: [id], onDelete: SetNull)

  @@index([studioId, level, score])
  @@map("member_risk_snapshots")
}

/// One row per recompute per member, kept to show week-over-week movement
/// and level-count trends on the summary endpoint.
model MemberRiskHistory {
  id         String         @id @default(uuid()) @db.Uuid
  studioId   String         @map("studio_id") @db.Uuid
  memberId   String         @map("member_id") @db.Uuid
  score      Int
  level      ChurnRiskLevel
  computedAt DateTime       @default(now()) @map("computed_at")

  studio Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  member MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([studioId, memberId, computedAt])
  @@index([studioId, computedAt])
  @@map("member_risk_history")
}

// ---------------------------------------------------------------------------
// Gamification (W16): streaks, milestones, badges, monthly goals
// ---------------------------------------------------------------------------

/// Badge as data, not code. `studioId` null means a global default (offered
/// to every tenant); a tenant may also define its own. `threshold` is a Json
/// blob shaped by `kind`, validated against a shared Zod discriminated union.
model BadgeDefinition {
  id          String    @id @default(uuid()) @db.Uuid
  studioId    String?   @map("studio_id") @db.Uuid
  key         String    @db.VarChar(60)
  name        String    @db.VarChar(100)
  description String?   @db.Text
  kind        BadgeKind
  threshold   Json
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  studio Studio?       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  awards MemberBadge[]

  /// Global defaults (studioId null) and a tenant's own keys must each be unique.
  @@unique([studioId, key])
  @@index([studioId, isActive])
  @@map("badge_definitions")
}

/// One row per member per badge ever earned; the unique constraint makes
/// awarding idempotent (re-evaluation can never double-award).
model MemberBadge {
  id                String   @id @default(uuid()) @db.Uuid
  studioId          String   @map("studio_id") @db.Uuid
  memberId          String   @map("member_id") @db.Uuid
  badgeDefinitionId String   @map("badge_definition_id") @db.Uuid
  earnedAt          DateTime @default(now()) @map("earned_at")
  /// Booking id (or other trigger) that caused the award, for troubleshooting.
  sourceRef         String?  @map("source_ref") @db.VarChar(100)

  studio          Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  member          MemberProfile   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  badgeDefinition BadgeDefinition @relation(fields: [badgeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([memberId, badgeDefinitionId])
  @@index([studioId, memberId])
  @@map("member_badges")
}

/// A member's self-set monthly session target. Progress is always computed
/// from attendance at read time, never stored here.
model MemberGoal {
  id             String   @id @default(uuid()) @db.Uuid
  studioId       String   @map("studio_id") @db.Uuid
  memberId       String   @map("member_id") @db.Uuid
  /// "YYYY-MM" in the studio's timezone.
  month          String   @db.VarChar(7)
  targetSessions Int      @map("target_sessions")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  studio Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  member MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, month])
  @@index([studioId, month])
  @@map("member_goals")
}

// ---------------------------------------------------------------------------
// W15: post-class ratings and refer-a-friend
// ---------------------------------------------------------------------------

/// One rating per booking. The teaching trainer (trainerProfileId) is copied
/// from the schedule at rating time so a later substitution never changes
/// who was rated. isAnonymousToTrainer hides the member's identity from the
/// trainer's own view; owner/manager always see everything.
model SessionRating {
  id                   String   @id @default(uuid()) @db.Uuid
  studioId             String   @map("studio_id") @db.Uuid
  bookingId            String   @unique @map("booking_id") @db.Uuid
  memberId             String   @map("member_id") @db.Uuid
  trainerProfileId     String   @map("trainer_profile_id") @db.Uuid
  serviceTypeId        String   @map("service_type_id") @db.Uuid
  score                Int
  comment              String?  @db.VarChar(1000)
  isAnonymousToTrainer Boolean  @default(true) @map("is_anonymous_to_trainer")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  studio         Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  booking        Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  member         MemberProfile  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainerProfile TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  serviceType    ServiceType    @relation(fields: [serviceTypeId], references: [id])

  @@index([studioId, trainerProfileId])
  @@index([studioId, serviceTypeId])
  @@index([studioId, createdAt])
  @@map("session_ratings")
}

/// One short code per member per studio, used for the "Arkadaşını getir" share link.
model ReferralCode {
  id        String   @id @default(uuid()) @db.Uuid
  studioId  String   @map("studio_id") @db.Uuid
  memberId  String   @unique @map("member_id") @db.Uuid
  code      String   @unique @db.VarChar(24)
  createdAt DateTime @default(now()) @map("created_at")

  studio    Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  member    MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  referrals Referral[]

  @@map("referral_codes")
}

/// Tracks a referred lead/member from signup through reward. Rewards are
/// granted exactly once via a conditional status update (PENDING/QUALIFIED
/// -> REWARDED); never for self-referral, enforced by referredUserId
/// pointing at a different user than the referrer's, checked in the service.
model Referral {
  id               String    @id @default(uuid()) @db.Uuid
  studioId         String    @map("studio_id") @db.Uuid
  referrerMemberId String    @map("referrer_member_id") @db.Uuid
  referredUserId   String    @map("referred_user_id") @db.Uuid
  referredPhone    String    @map("referred_phone") @db.VarChar(20)
  referralCodeId   String?   @map("referral_code_id") @db.Uuid
  status           ReferralStatus @default(PENDING)
  qualifiedAt      DateTime? @map("qualified_at")
  rewardedAt       DateTime? @map("rewarded_at")
  rewardType       ReferralRewardType? @map("reward_type")
  rewardUnits      Int?      @map("reward_units")
  voidedAt         DateTime? @map("voided_at")
  voidReason       String?   @map("void_reason") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  studio         Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  referrerMember MemberProfile @relation("ReferralReferrer", fields: [referrerMemberId], references: [id], onDelete: Cascade)
  referredUser   User          @relation(fields: [referredUserId], references: [id], onDelete: Cascade)
  referralCode   ReferralCode? @relation(fields: [referralCodeId], references: [id], onDelete: SetNull)

  /// One referral row per referred user per studio: prevents the same phone
  /// (users are globally phone-unique) from being recorded twice.
  @@unique([studioId, referredUserId])
  @@index([studioId, status])
  @@index([studioId, referrerMemberId])
  @@map("referrals")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// Null for platform-level (super-admin) actions.
  studioId   String?  @map("studio_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.VarChar(60)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  studio Studio? @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([studioId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// e-Arsiv / e-Fatura (W8)
// ---------------------------------------------------------------------------

/// Per-tenant e-invoice configuration. Buyer legal identity and tax number
/// validation live in packages/shared; provider credentials are never
/// stored here, only the choice of adapter (see EInvoiceProvider), whose
/// credentials come from env vars the same way payment providers do.
model InvoiceSettings {
  id                 String           @id @default(uuid()) @db.Uuid
  studioId           String           @unique @map("studio_id") @db.Uuid
  legalName          String           @map("legal_name") @db.VarChar(200)
  taxOffice          String?          @map("tax_office") @db.VarChar(100)
  /// VKN (10 digits) or TCKN (11 digits) of the studio itself, the seller.
  taxNumber          String?          @map("tax_number") @db.VarChar(11)
  address            String?          @db.Text
  eInvoiceMode       EInvoiceMode     @default(NONE) @map("e_invoice_mode")
  provider           EInvoiceProvider @default(MOCK)
  /// Percentage, e.g. 10.00 or 20.00.
  defaultVatRate     Decimal          @default(20) @map("default_vat_rate") @db.Decimal(5, 2)
  seriesPrefix       String           @default("A") @map("series_prefix") @db.VarChar(10)
  autoIssueOnPayment Boolean          @default(false) @map("auto_issue_on_payment")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@map("invoice_settings")
}

/// Atomic per-studio, per-series, per-year sequence. A row is created (or
/// incremented) inside the same transaction that creates the Invoice, so
/// two concurrent issues can never receive the same number.
model InvoiceCounter {
  studioId     String @map("studio_id") @db.Uuid
  seriesPrefix String @map("series_prefix") @db.VarChar(10)
  year         Int
  lastSequence Int    @default(0) @map("last_sequence")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@id([studioId, seriesPrefix, year])
  @@map("invoice_counters")
}

/// Buyer identity for invoicing. Individual members can also be invoiced
/// without one, in which case e-Arsiv falls back to the generic consumer
/// TCKN "11111111111" (documented in docs/INVOICING.md).
model BillingProfile {
  id           String             @id @default(uuid()) @db.Uuid
  studioId     String             @map("studio_id") @db.Uuid
  memberId     String             @unique @map("member_id") @db.Uuid
  kind         BillingProfileKind @default(INDIVIDUAL)
  fullName     String?            @map("full_name") @db.VarChar(150)
  /// 11-digit Turkish national ID, checksum-validated in shared. Optional:
  /// left empty falls back to the standard e-Arsiv consumer TCKN.
  tckn         String?            @db.VarChar(11)
  companyTitle String?            @map("company_title") @db.VarChar(200)
  taxOffice    String?            @map("tax_office") @db.VarChar(100)
  /// 10-digit Turkish tax number, checksum-validated in shared. Required for kind=COMPANY.
  vkn          String?            @db.VarChar(10)
  address      String?            @db.Text
  email        String?            @db.VarChar(120)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  studio Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  member MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@map("billing_profiles")
}

/// One e-Arsiv/e-Fatura document tied 1:1 to a completed Payment. Buyer and
/// line data are snapshotted as Json at issue time so a later change to the
/// member's billing profile or the package's price never rewrites history.
model Invoice {
  id             String           @id @default(uuid()) @db.Uuid
  studioId       String           @map("studio_id") @db.Uuid
  branchId       String?          @map("branch_id") @db.Uuid
  paymentId      String           @unique @map("payment_id") @db.Uuid
  /// seriesPrefix + year + zero-padded sequence, e.g. "A2026000001".
  number         String           @db.VarChar(40)
  issueDate      DateTime         @map("issue_date")
  /// Snapshot of BillingProfile (or the standard consumer TCKN fallback) at issue time.
  buyerSnapshot  Json             @map("buyer_snapshot")
  /// Snapshot of invoice lines: [{ description, quantity, unitPrice, total }].
  lines          Json
  subtotal       Decimal          @db.Decimal(10, 2)
  vatAmount      Decimal          @map("vat_amount") @db.Decimal(10, 2)
  /// VAT-inclusive total; equals the Payment amount it was issued for.
  total          Decimal          @db.Decimal(10, 2)
  currency       String           @default("TRY") @db.VarChar(3)
  status         InvoiceStatus    @default(DRAFT)
  provider       EInvoiceProvider
  providerUuid   String?          @map("provider_uuid") @db.VarChar(120)
  providerStatus String?          @map("provider_status") @db.VarChar(60)
  pdfUrl         String?          @map("pdf_url") @db.Text
  failureReason  String?          @map("failure_reason") @db.Text
  cancelledAt    DateTime?        @map("cancelled_at")
  cancelReason   String?          @map("cancel_reason") @db.Text
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  studio  Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([studioId, number])
  @@index([studioId, issueDate])
  @@index([branchId])
  @@index([status])
  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Open platform (W18): API keys, public API, outbound webhooks
// ---------------------------------------------------------------------------

/// A public-API credential for a studio. Plaintext secret is never stored:
/// only its sha256 hash. The prefix (shown in listings) is the non-secret
/// part of `pk_live_<prefix>_<secret>`.
model ApiKey {
  id              String    @id @default(uuid()) @db.Uuid
  studioId        String    @map("studio_id") @db.Uuid
  name            String    @db.VarChar(80)
  prefix          String    @db.VarChar(12)
  secretHash      String    @map("secret_hash") @db.VarChar(64)
  scopes          String[]
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  lastUsedAt      DateTime? @map("last_used_at")
  expiresAt       DateTime? @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  studio    Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  createdBy User   @relation("ApiKeyCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([prefix])
  @@index([studioId, revokedAt])
  @@map("api_keys")
}

/// A tenant-configured outbound webhook. The secret signs deliveries
/// (HMAC-SHA256); it is generated server-side and only ever shown once (on
/// create) or after a rotate call.
model WebhookEndpoint {
  id           String   @id @default(uuid()) @db.Uuid
  studioId     String   @map("studio_id") @db.Uuid
  url          String   @db.Text
  secret       String   @db.VarChar(64)
  events       String[]
  isActive     Boolean  @default(true) @map("is_active")
  /// Consecutive failed deliveries; reset to 0 on a success, auto-disables the endpoint past a threshold.
  failureCount Int      @default(0) @map("failure_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  studio     Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([studioId])
  @@map("webhook_endpoints")
}

/// One outbound delivery attempt log entry. A retried delivery reuses the
/// same row (attempt is incremented) until it succeeds or attempts run out.
model WebhookDelivery {
  id            String                @id @default(uuid()) @db.Uuid
  endpointId    String                @map("endpoint_id") @db.Uuid
  event         String                @db.VarChar(40)
  payload       Json
  status        WebhookDeliveryStatus @default(PENDING)
  attempt       Int                   @default(0)
  responseCode  Int?                  @map("response_code")
  nextAttemptAt DateTime?             @map("next_attempt_at")
  /// Truncated to 500 characters; response bodies are never stored beyond that.
  lastError     String?               @map("last_error") @db.VarChar(500)
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
  ABANDONED
}

// ---------------------------------------------------------------------------
// W20: Aggregator / marketplace partner integrations
// ---------------------------------------------------------------------------

/// A studio's connection to one aggregator/marketplace partner. Credentials
/// are AES-256-GCM encrypted with INTEGRATION_ENCRYPTION_KEY before storage
/// (see apps/api/src/common/crypto/credential-cipher.ts) and never decrypted
/// back out through any API response. `config` is plain, non-secret Json
/// validated by PartnerConnectionConfigSchema in @platform/shared.
model PartnerConnection {
  id                   String                  @id @default(uuid()) @db.Uuid
  studioId             String                  @map("studio_id") @db.Uuid
  provider             PartnerProvider
  label                String                  @db.VarChar(80)
  status               PartnerConnectionStatus @default(ACTIVE)
  /// Base64 of iv (12 bytes) + authTag (16 bytes) + ciphertext, see
  /// credential-cipher.ts. Null only for provider=MOCK in dev/test, where
  /// encryption is optional (INTEGRATION_ENCRYPTION_KEY unset).
  encryptedCredentials String?                 @map("encrypted_credentials") @db.Text
  config               Json                    @default("{}")
  lastSyncAt           DateTime?               @map("last_sync_at")
  /// Consecutive outbound sync failures; reset to 0 on the next success.
  consecutiveFailures  Int                     @default(0) @map("consecutive_failures")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  studio        Studio                  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  guests        PartnerGuest[]
  allocations   PartnerSpotAllocation[]
  bookings      Booking[]
  webhookEvents PartnerWebhookEvent[]

  @@unique([studioId, provider, label])
  @@index([studioId, status])
  @@map("partner_connections")
}

/// A guest brought in by a partner reservation. Always carries the partner's
/// own identity (name, and phone when the partner supplied one); `userId`
/// points at a global User (rule 6) so the guest can be recognised across
/// repeat visits by phone. When the partner gives no phone, a placeholder
/// User is created (isPlaceholder=true) purely to satisfy Booking.memberId,
/// and PartnerGuest - not that placeholder - is the source of truth for the
/// guest's displayed name.
model PartnerGuest {
  id              String   @id @default(uuid()) @db.Uuid
  studioId        String   @map("studio_id") @db.Uuid
  connectionId    String   @map("connection_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  externalGuestId String?  @map("external_guest_id") @db.VarChar(120)
  phone           String?  @db.VarChar(20)
  fullName        String   @map("full_name") @db.VarChar(120)
  isPlaceholder   Boolean  @default(false) @map("is_placeholder")
  createdAt       DateTime @default(now()) @map("created_at")

  studio     Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  connection PartnerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings   Booking[]

  @@index([studioId, connectionId])
  @@index([connectionId, externalGuestId])
  @@map("partner_guests")
}

/// Spots reserved out of a session's free capacity for one partner
/// connection. reservedSpots must never exceed the schedule's remaining
/// capacity at the time it is set; released automatically (isReleased=true)
/// releaseHoursBeforeStart hours before the session start, freeing the spots
/// back to the general pool.
model PartnerSpotAllocation {
  id            String   @id @default(uuid()) @db.Uuid
  studioId      String   @map("studio_id") @db.Uuid
  connectionId  String   @map("connection_id") @db.Uuid
  scheduleId    String   @map("schedule_id") @db.Uuid
  reservedSpots Int      @default(0) @map("reserved_spots")
  usedSpots     Int      @default(0) @map("used_spots")
  releaseAt     DateTime @map("release_at")
  isReleased    Boolean  @default(false) @map("is_released")
  createdAt     DateTime @default(now()) @map("created_at")

  studio     Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  connection PartnerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  schedule   SessionSchedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([connectionId, scheduleId])
  @@index([studioId, releaseAt, isReleased])
  @@map("partner_spot_allocations")
}

/// Replay protection for inbound partner webhooks: the partner's own eventId
/// is unique per connection, so a re-delivered webhook is a no-op.
model PartnerWebhookEvent {
  id           String   @id @default(uuid()) @db.Uuid
  studioId     String   @map("studio_id") @db.Uuid
  connectionId String   @map("connection_id") @db.Uuid
  eventId      String   @map("event_id") @db.VarChar(120)
  eventType    String   @map("event_type") @db.VarChar(40)
  receivedAt   DateTime @default(now()) @map("received_at")

  studio     Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  connection PartnerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, eventId])
  @@map("partner_webhook_events")
}

// ---------------------------------------------------------------------------
// Apple Health / Android Health Connect integration (W21)
// ---------------------------------------------------------------------------

/// One row per member: privacy-first, all-off-by-default toggles for the
/// health integration. Health data is special-category personal data under
/// KVKK, so every write path checks these plus an active HEALTH_DATA Consent.
model MemberHealthSettings {
  id              String   @id @default(uuid()) @db.Uuid
  memberId        String   @unique @map("member_id") @db.Uuid
  studioId        String   @map("studio_id") @db.Uuid
  /// Write attended-session workouts to the device's health store.
  writeWorkouts   Boolean  @default(false) @map("write_workouts")
  /// Read daily step / active energy / resting heart rate aggregates on-device.
  readAggregates  Boolean  @default(false) @map("read_aggregates")
  /// Second, separate opt-in: upload the daily aggregates to the server so
  /// staff with members.health.view can see trends on the member card.
  shareWithStudio Boolean  @default(false) @map("share_with_studio")
  updatedAt       DateTime @updatedAt @map("updated_at")

  member MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  studio Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@map("member_health_settings")
}

/// Tracks which bookings have already been written to a health platform so a
/// booking is never written twice, even across devices (server-side half of
/// the idempotency guarantee; the mobile app also tracks this locally).
model HealthSyncRecord {
  id        String         @id @default(uuid()) @db.Uuid
  studioId  String         @map("studio_id") @db.Uuid
  memberId  String         @map("member_id") @db.Uuid
  bookingId String         @map("booking_id") @db.Uuid
  platform  HealthPlatform
  syncedAt  DateTime       @default(now()) @map("synced_at")

  studio  Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  member  MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  booking Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([memberId, bookingId, platform])
  @@index([studioId, memberId])
  @@map("health_sync_records")
}

/// Daily aggregate only (never raw samples), uploaded solely when the member
/// has both readAggregates and shareWithStudio on and an active HEALTH_DATA
/// consent. One row per member per day.
model HealthDailySummary {
  id               String   @id @default(uuid()) @db.Uuid
  studioId         String   @map("studio_id") @db.Uuid
  memberId         String   @map("member_id") @db.Uuid
  date             DateTime @db.Date
  steps            Int?
  activeEnergyKcal Decimal? @map("active_energy_kcal") @db.Decimal(6, 1)
  restingHeartRate Int?     @map("resting_heart_rate")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  studio Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  member MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, date])
  @@index([studioId, memberId, date])
  @@map("health_daily_summaries")
}

// ---------------------------------------------------------------------------
// W19: on-demand video library
// ---------------------------------------------------------------------------

/// A piece of on-demand video content. EXTERNAL_URL is the only implemented
/// provider (any https URL - YouTube unlisted, Vimeo, etc); UPLOADED is
/// reserved for when local upload infrastructure exists (see docs/VIDEO.md).
model VideoContent {
  id               String                 @id @default(uuid()) @db.Uuid
  studioId         String                 @map("studio_id") @db.Uuid
  title            String                 @db.VarChar(150)
  description      String?                @db.Text
  durationSeconds  Int                    @map("duration_seconds")
  provider         VideoContentProvider   @default(EXTERNAL_URL)
  /// https-only. Required for EXTERNAL_URL; unused (null) for UPLOADED.
  sourceUrl        String?                @map("source_url") @db.Text
  thumbnailUrl     String?                @map("thumbnail_url") @db.Text
  serviceTypeId    String?                @map("service_type_id") @db.Uuid
  trainerProfileId String?                @map("trainer_profile_id") @db.Uuid
  visibility       VideoContentVisibility @default(ALL_MEMBERS)
  /// Optional per-content credit cost, charged once per member from a
  /// CREDIT_BASED package. Null/0 means watching never consumes units.
  creditCost       Int?                   @map("credit_cost")
  isPublished      Boolean                @default(false) @map("is_published")
  publishedAt      DateTime?              @map("published_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  studio         Studio                @relation(fields: [studioId], references: [id], onDelete: Cascade)
  serviceType    ServiceType?          @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  trainerProfile TrainerProfile?       @relation(fields: [trainerProfileId], references: [id], onDelete: SetNull)
  packages       VideoContentPackage[]
  views          VideoView[]
  communityPosts CommunityPost[]

  @@index([studioId, isPublished])
  @@map("video_contents")
}

/// Which package definitions unlock a VideoContent when visibility is
/// SPECIFIC_PACKAGES.
model VideoContentPackage {
  videoContentId      String @map("video_content_id") @db.Uuid
  packageDefinitionId String @map("package_definition_id") @db.Uuid

  videoContent      VideoContent      @relation(fields: [videoContentId], references: [id], onDelete: Cascade)
  packageDefinition PackageDefinition @relation(fields: [packageDefinitionId], references: [id], onDelete: Cascade)

  @@id([videoContentId, packageDefinitionId])
  @@map("video_content_packages")
}

/// One row per member per content: resume position and, once a credit was
/// charged, a durable idempotency marker (unique on member+content) so a
/// member is charged at most once even under concurrent requests.
model VideoView {
  id                  String    @id @default(uuid()) @db.Uuid
  studioId            String    @map("studio_id") @db.Uuid
  videoContentId      String    @map("video_content_id") @db.Uuid
  memberId            String    @map("member_id") @db.Uuid
  startedAt           DateTime  @default(now()) @map("started_at")
  lastPositionSeconds Int       @default(0) @map("last_position_seconds")
  completedAt         DateTime? @map("completed_at")
  /// Set once a creditCost has actually been charged for this member+content.
  creditChargedAt     DateTime? @map("credit_charged_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  studio       Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  videoContent VideoContent  @relation(fields: [videoContentId], references: [id], onDelete: Cascade)
  member       MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([videoContentId, memberId])
  @@index([studioId, videoContentId])
  @@map("video_views")
}

// ---------------------------------------------------------------------------
// Page engine (G2c): Site -> Page -> Block, with immutable PageVersion
// snapshots. See docs/SAYFA_MOTORU.md. The platform tenant has one PLATFORM
// site; any tenant may create one TENANT site through the same engine.
// A/B testing lives at the block level (Block.abVariantKey), not as
// duplicate Page rows, so a slug stays unique per site+locale.
// ---------------------------------------------------------------------------

enum SiteKind {
  PLATFORM
  TENANT
}

enum PageKind {
  HOME
  LANDING
  CORPORATE
  LEGAL
  CUSTOM
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum DomainVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

model Site {
  id             String   @id @default(uuid()) @db.Uuid
  studioId       String   @unique @map("studio_id") @db.Uuid
  kind           SiteKind
  primaryDomain  String?  @map("primary_domain") @db.VarChar(190)
  defaultLocale  String   @default("tr") @map("default_locale") @db.VarChar(10)
  enabledLocales String[] @default(["tr"]) @map("enabled_locales")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  studio  Studio       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  pages   Page[]
  domains SiteDomain[]

  @@map("sites")
}

/// Custom domain a tenant site can be reached on, once verified (docs/SAYFA_MOTORU.md).
/// Caddy's on-demand TLS "ask" endpoint only approves domains with status VERIFIED.
model SiteDomain {
  id                String                    @id @default(uuid()) @db.Uuid
  siteId            String                    @map("site_id") @db.Uuid
  domain            String                    @unique @db.VarChar(190)
  status            DomainVerificationStatus  @default(PENDING)
  verificationToken String                    @map("verification_token") @db.VarChar(64)
  verifiedAt        DateTime?                 @map("verified_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("site_domains")
}

/// A logical page (one URL family across locales). `status` governs the
/// whole page; a locale not present in `locales` is unpublished for that
/// locale even while the page itself is PUBLISHED in others.
model Page {
  id            String     @id @default(uuid()) @db.Uuid
  siteId        String     @map("site_id") @db.Uuid
  kind          PageKind
  /// BusinessTypeTemplate.key for a sector landing page; null otherwise.
  sectorKey     String?    @map("sector_key") @db.VarChar(60)
  /// Campaign offer slug for /{locale}/{sector}/{offer} variants; null otherwise.
  offerKey      String?    @map("offer_key") @db.VarChar(60)
  /// Admin-facing label only; never rendered to visitors.
  internalLabel String     @map("internal_label") @db.VarChar(150)
  status        PageStatus @default(DRAFT)
  publishedAt   DateTime?  @map("published_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  site     Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  locales  PageLocale[]
  blocks   Block[]
  versions PageVersion[]

  @@index([siteId, status])
  @@index([siteId, sectorKey, offerKey])
  @@map("pages")
}

/// One locale variant of a page: its URL slug and SEO fields. Existence of
/// a row is what makes that locale servable at all for the page.
model PageLocale {
  id              String    @id @default(uuid()) @db.Uuid
  pageId          String    @map("page_id") @db.Uuid
  /// Denormalized from Page.siteId so (site, locale, slug) can be unique.
  siteId          String    @map("site_id") @db.Uuid
  locale          String    @db.VarChar(10)
  slug            String    @db.VarChar(160)
  seoTitle        String?   @map("seo_title") @db.VarChar(200)
  seoDescription  String?   @map("seo_description") @db.VarChar(400)
  ogImageUrl      String?   @map("og_image_url") @db.Text
  /// Legal pages are marked draft until the super admin ticks this
  /// (docs/SAYFA_MOTORU.md "hukuki onay alındı").
  legalApproved   Boolean   @default(false) @map("legal_approved")
  legalApprovedAt DateTime? @map("legal_approved_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@unique([siteId, locale, slug])
  @@map("page_locales")
}

/// One typed, per-locale-text content block on a page. `type` is validated
/// against packages/shared/src/sites/blocks.ts (BLOCK_SCHEMAS) at the API
/// layer, not a DB enum, so a new block type ships without a migration.
/// `abVariantKey` null means the block always renders; a non-null key
/// renders only for visitors assigned that variant (packages/shared/src/sites/ab.ts).
model Block {
  id           String   @id @default(uuid()) @db.Uuid
  pageId       String   @map("page_id") @db.Uuid
  type         String   @db.VarChar(40)
  position     Int
  abVariantKey String?  @map("ab_variant_key") @db.VarChar(40)
  data         Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, position])
  @@map("blocks")
}

/// Immutable snapshot written on every publish; rollback restores a page's
/// locales and blocks from a chosen version (a new version is then created
/// for the restored state, so history only ever grows).
model PageVersion {
  id                String   @id @default(uuid()) @db.Uuid
  pageId            String   @map("page_id") @db.Uuid
  version           Int
  /// { locales: PageLocaleDTO[], blocks: BlockDTO[] } as published.
  snapshot          Json
  publishedAt       DateTime @default(now()) @map("published_at")
  publishedByUserId String?  @map("published_by_user_id") @db.Uuid

  page            Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  publishedByUser User? @relation(fields: [publishedByUserId], references: [id], onDelete: SetNull)

  @@unique([pageId, version])
  @@map("page_versions")
}

/// Platform-wide singleton (no studioId: this is the platform's own legal
/// identity, not tenant data). Editable by super admin only; tenant sites
/// use the studio's own name/address/phone/email instead.
model CompanyInfo {
  id              String   @id @default(uuid())
  legalName       String   @map("legal_name") @db.VarChar(200)
  address         String?  @db.Text
  tradeRegistryNo String?  @map("trade_registry_no") @db.VarChar(60)
  mersisNo        String?  @map("mersis_no") @db.VarChar(60)
  taxOffice       String?  @map("tax_office") @db.VarChar(100)
  taxNumber       String?  @map("tax_number") @db.VarChar(30)
  email           String?  @db.VarChar(120)
  phone           String?  @db.VarChar(30)
  socialLinks     Json     @default("{}") @map("social_links")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("company_info")
}

// ---------------------------------------------------------------------------
// AI core (G3b, docs/YAPAY_ZEKA.md)
// ---------------------------------------------------------------------------

enum AiTask {
  TRANSLATION
  COPYWRITING
  REPLY_SUGGESTION
  MARKETING_DRAFT
  MARKETING_ANALYSIS
  MARKETING_RESEARCH
  /// M3d: the weekly marketing summary (counts against the marketing AI budget).
  MARKETING_WEEKLY_SUMMARY
}

enum AiTranslationJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AiTranslationItemStatus {
  PENDING
  DONE
  FAILED
  SKIPPED
}

/// Platform-wide AI settings, a single row with id "platform". The provider
/// key is stored encrypted (CredentialCipher, AES-256-GCM) with only its last
/// four characters in clear; the API never returns it.
model AiSettings {
  id                        String    @id @default("platform") @db.VarChar(20)
  encryptedApiKey           String?   @map("encrypted_api_key") @db.Text
  apiKeyLast4               String?   @map("api_key_last4") @db.VarChar(4)
  apiKeyUpdatedAt           DateTime? @map("api_key_updated_at")
  apiKeyUpdatedByUserId     String?   @map("api_key_updated_by_user_id") @db.Uuid
  /// { "TRANSLATION": "claude-sonnet-5", ... }; missing tasks use the shared defaults.
  models                    Json      @default("{}")
  /// Model id -> AiModelPrice overriding the shared price table.
  priceOverrides            Json      @default("{}") @map("price_overrides")
  defaultMonthlyBudgetCents Int       @default(500) @map("default_monthly_budget_cents")
  /// Monthly cap (cents) of the marketing studio on the platform tenant, checked before every MARKETING_* call.
  marketingAiMonthlyBudgetCents Int   @default(5000) @map("marketing_ai_monthly_budget_cents")
  lastTestAt                DateTime? @map("last_test_at")
  lastTestOk                Boolean?  @map("last_test_ok")
  lastTestErrorCode         String?   @map("last_test_error_code") @db.VarChar(40)
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  @@map("ai_settings")
}

/// One model call: tokens and estimated cost in micro-USD (1e-6 USD). The
/// tenant's monthly budget is checked against the sum of its rows in the
/// current UTC month before every call. studioId is null for platform jobs.
model AiUsage {
  id                  String   @id @default(uuid()) @db.Uuid
  studioId            String?  @map("studio_id") @db.Uuid
  userId              String?  @map("user_id") @db.Uuid
  task                AiTask
  model               String   @db.VarChar(80)
  inputTokens         Int      @default(0) @map("input_tokens")
  outputTokens        Int      @default(0) @map("output_tokens")
  cacheCreationTokens Int      @default(0) @map("cache_creation_tokens")
  cacheReadTokens     Int      @default(0) @map("cache_read_tokens")
  costMicroUsd        Int      @default(0) @map("cost_micro_usd")
  success             Boolean
  errorCode           String?  @map("error_code") @db.VarChar(40)
  translationJobId    String?  @map("translation_job_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")

  studio         Studio?           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  translationJob AiTranslationJob? @relation(fields: [translationJobId], references: [id], onDelete: SetNull)

  @@index([studioId, createdAt])
  @@index([createdAt])
  @@index([translationJobId])
  @@map("ai_usage")
}

/// Per-language glossary sent with every translation request: terms that
/// stay unchanged (translation null) or are always translated one way.
model AiGlossaryTerm {
  id          String   @id @default(uuid()) @db.Uuid
  locale      String   @db.VarChar(10)
  term        String   @db.VarChar(120)
  translation String?  @db.VarChar(200)
  note        String?  @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  language Language @relation(fields: [locale], references: [code], onDelete: Cascade)

  @@unique([locale, term])
  @@map("ai_glossary_terms")
}

/// A background "translate this language with AI" run. Its items are the
/// unit of resumability: a crashed or paused run continues with the items
/// still PENDING once lockedUntil has passed.
model AiTranslationJob {
  id                String                 @id @default(uuid()) @db.Uuid
  locale            String                 @db.VarChar(10)
  namespaces        String[]               @default([])
  overwrite         Boolean                @default(false)
  status            AiTranslationJobStatus @default(QUEUED)
  total             Int                    @default(0)
  done              Int                    @default(0)
  failed            Int                    @default(0)
  skipped           Int                    @default(0)
  model             String?                @db.VarChar(80)
  createdByUserId   String?                @map("created_by_user_id") @db.Uuid
  /// Worker lease; another worker may resume the job after it passes.
  lockedUntil       DateTime?              @map("locked_until")
  /// Consecutive provider outages (rate limit, 5xx, timeout); the job fails after a few.
  transientErrors   Int                    @default(0) @map("transient_errors")
  lastErrorCode     String?                @map("last_error_code") @db.VarChar(40)
  cancelRequestedAt DateTime?              @map("cancel_requested_at")
  startedAt         DateTime?              @map("started_at")
  finishedAt        DateTime?              @map("finished_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  language Language               @relation(fields: [locale], references: [code], onDelete: Cascade)
  items    AiTranslationJobItem[]
  usages   AiUsage[]

  @@index([locale, createdAt])
  @@index([status])
  @@map("ai_translation_jobs")
}

/// One key (or one plural group "<key>.*") of a translation job.
model AiTranslationJobItem {
  id        String                  @id @default(uuid()) @db.Uuid
  jobId     String                  @map("job_id") @db.Uuid
  key       String                  @db.VarChar(210)
  isPlural  Boolean                 @default(false) @map("is_plural")
  status    AiTranslationItemStatus @default(PENDING)
  attempts  Int                     @default(0)
  errorCode String?                 @map("error_code") @db.VarChar(40)
  updatedAt DateTime                @updatedAt @map("updated_at")

  job AiTranslationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, key])
  @@index([jobId, status])
  @@map("ai_translation_job_items")
}

// ---------------------------------------------------------------------------
// Loyalty points (G3a, docs/SADAKAT.md)
// ---------------------------------------------------------------------------

enum LoyaltyExpiryMode {
  NONE
  MONTHS_AFTER_EARN
}

/// Per-tenant loyalty program settings. No row = program off.
model LoyaltySettings {
  studioId            String            @id @map("studio_id") @db.Uuid
  enabled             Boolean           @default(false)
  expiryMode          LoyaltyExpiryMode @default(NONE) @map("expiry_mode")
  /// MONTHS_AFTER_EARN: months an earned lot stays spendable.
  expiryMonths        Int?              @map("expiry_months")
  /// Days before expiry the member is told (0 = never).
  expiryNoticeDays    Int               @default(14) @map("expiry_notice_days")
  memberRedeemEnabled Boolean           @default(false) @map("member_redeem_enabled")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@map("loyalty_settings")
}

/// Tenant earn rule. `kind` is a key from LOYALTY_RULE_KINDS (shared); the
/// rows themselves are tenant data (CLAUDE.md rule 7).
model LoyaltyRule {
  id         String   @id @default(uuid()) @db.Uuid
  studioId   String   @map("studio_id") @db.Uuid
  kind       String   @db.VarChar(30)
  name       String   @db.VarChar(120)
  points     Int
  /// PURCHASE_AMOUNT: `points` per this much of `currency`.
  perAmount  Decimal? @map("per_amount") @db.Decimal(10, 2)
  currency   String?  @db.VarChar(3)
  /// { serviceTypeIds?, packageDefinitionIds?, badgeDefinitionIds? }
  conditions Json     @default("{}")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId, kind, isActive])
  @@map("loyalty_rules")
}

/// Tenant rewards catalogue. `type` is a key from LOYALTY_REWARD_TYPES.
model LoyaltyReward {
  id               String   @id @default(uuid()) @db.Uuid
  studioId         String   @map("studio_id") @db.Uuid
  name             String   @db.VarChar(120)
  description      String?  @db.Text
  type             String   @db.VarChar(30)
  costPoints       Int      @map("cost_points")
  /// Amount (DISCOUNT_AMOUNT, with currency), percent (DISCOUNT_PERCENT) or units (EXTRA_SESSION_CREDIT).
  value            Decimal? @db.Decimal(10, 2)
  currency         String?  @db.VarChar(3)
  /// Days an issued promotion code stays valid.
  validityDays     Int      @default(90) @map("validity_days")
  isActive         Boolean  @default(true) @map("is_active")
  memberRedeemable Boolean  @default(true) @map("member_redeemable")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  studio      Studio              @relation(fields: [studioId], references: [id], onDelete: Cascade)
  redemptions LoyaltyRedemption[]

  @@index([studioId, isActive])
  @@map("loyalty_rewards")
}

/// Cached balance per membership, updated in the same transaction as every
/// ledger row (the ledger stays the source of truth). The row lock
/// serialises a member's ledger writes, so a balance never goes below zero.
model LoyaltyAccount {
  id               String    @id @default(uuid()) @db.Uuid
  studioId         String    @map("studio_id") @db.Uuid
  membershipId     String    @unique @map("membership_id") @db.Uuid
  balance          Int       @default(0)
  lifetimeEarned   Int       @default(0) @map("lifetime_earned")
  lifetimeRedeemed Int       @default(0) @map("lifetime_redeemed")
  /// Earliest expiry of a lot that may still hold points: a recheck hint for
  /// the expiry job, never later than the real next expiry (earlier only
  /// costs one extra recheck).
  nextExpiryAt     DateTime? @map("next_expiry_at")
  /// The lot expiry the member was last told about (one notice per date).
  expiryNoticeFor  DateTime? @map("expiry_notice_for")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  studio     Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([studioId, balance])
  @@index([nextExpiryAt])
  @@map("loyalty_accounts")
}

/// Append-only points ledger: rows are never updated or deleted by the
/// application. Positive rows are lots (expiresAt from the tenant policy at
/// earn time); negative rows are debits consumed FIFO by expiry date.
model LoyaltyLedger {
  id                    String    @id @default(uuid()) @db.Uuid
  studioId              String    @map("studio_id") @db.Uuid
  membershipId          String    @map("membership_id") @db.Uuid
  /// The member's CRM contact when known (reporting and journeys).
  contactId             String?   @map("contact_id") @db.Uuid
  delta                 Int
  balanceAfter          Int       @map("balance_after")
  /// Key from LOYALTY_REASONS.
  reason                String    @db.VarChar(30)
  /// Key from LOYALTY_SOURCE_TYPES; with sourceId and reason the idempotency key.
  sourceType            String    @map("source_type") @db.VarChar(30)
  sourceId              String    @map("source_id") @db.VarChar(120)
  ruleId                String?   @map("rule_id") @db.Uuid
  expiresAt             DateTime? @map("expires_at")
  createdByMembershipId String?   @map("created_by_membership_id") @db.Uuid
  note                  String?   @db.VarChar(300)
  createdAt             DateTime  @default(now()) @map("created_at")

  studio     Studio             @relation(fields: [studioId], references: [id], onDelete: Cascade)
  membership Membership         @relation("LoyaltyLedgerHolder", fields: [membershipId], references: [id], onDelete: Cascade)
  createdBy  Membership?        @relation("LoyaltyLedgerActor", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  redemption LoyaltyRedemption?

  @@unique([studioId, sourceType, sourceId, reason])
  @@index([studioId, membershipId, createdAt])
  @@index([studioId, expiresAt])
  @@map("loyalty_ledger")
}

/// A reward taken: the negative ledger row plus its effect (a single-use
/// promotion code, units on a member package, or a gift to hand over).
model LoyaltyRedemption {
  id                    String   @id @default(uuid()) @db.Uuid
  studioId              String   @map("studio_id") @db.Uuid
  membershipId          String   @map("membership_id") @db.Uuid
  rewardId              String   @map("reward_id") @db.Uuid
  ledgerId              String   @unique @map("ledger_id") @db.Uuid
  rewardName            String   @map("reward_name") @db.VarChar(120)
  type                  String   @db.VarChar(30)
  pointsSpent           Int      @map("points_spent")
  value                 Decimal? @db.Decimal(10, 2)
  currency              String?  @db.VarChar(3)
  promoCodeId           String?  @map("promo_code_id") @db.Uuid
  memberPackageId       String?  @map("member_package_id") @db.Uuid
  createdByMembershipId String?  @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")

  studio     Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  membership Membership    @relation("LoyaltyRedemptionHolder", fields: [membershipId], references: [id], onDelete: Cascade)
  reward     LoyaltyReward @relation(fields: [rewardId], references: [id])
  ledger     LoyaltyLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  promoCode  PromoCode?    @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  @@index([studioId, membershipId, createdAt])
  @@map("loyalty_redemptions")
}

// ---------------------------------------------------------------------------
// G3c-1: events, workshops and multi-session courses (docs/ETKINLIKLER.md)
// ---------------------------------------------------------------------------

/// An event, workshop or course. `kind`, `status` and `visibility` are keys
/// from EVENT_KINDS / EVENT_STATUSES / EVENT_VISIBILITIES (shared; CHECK
/// constraints in the migration). `seatsTaken` counts seat-holding
/// registrations and only moves through conditional updates
/// (seats_taken < capacity), so concurrent registrations never oversell.
model Event {
  id                    String    @id @default(uuid()) @db.Uuid
  studioId              String    @map("studio_id") @db.Uuid
  branchId              String?   @map("branch_id") @db.Uuid
  title                 String    @db.VarChar(160)
  description           String?   @db.Text
  kind                  String    @db.VarChar(10)
  status                String    @default("DRAFT") @db.VarChar(12)
  capacity              Int
  seatsTaken            Int       @default(0) @map("seats_taken")
  waitlistEnabled       Boolean   @default(false) @map("waitlist_enabled")
  visibility            String    @default("MEMBERS_ONLY") @db.VarChar(15)
  coverImageUrl         String?   @map("cover_image_url") @db.Text
  registrationOpensAt   DateTime? @map("registration_opens_at")
  registrationClosesAt  DateTime? @map("registration_closes_at")
  /// First occurrence start / last occurrence end, kept in sync with the occurrences.
  startsAt              DateTime? @map("starts_at")
  endsAt                DateTime? @map("ends_at")
  /// Full refund until this many hours before startsAt, none after.
  fullRefundHoursBefore Int       @default(24) @map("full_refund_hours_before")
  publishedAt           DateTime? @map("published_at")
  cancelledAt           DateTime? @map("cancelled_at")
  cancellationReason    String?   @map("cancellation_reason") @db.Text
  completedAt           DateTime? @map("completed_at")
  createdByMembershipId String?   @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  studio        Studio              @relation(fields: [studioId], references: [id], onDelete: Cascade)
  branch        Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy     Membership?         @relation("EventCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  occurrences   EventOccurrence[]
  ticketTypes   EventTicketType[]
  registrations EventRegistration[]

  @@index([studioId, status, startsAt])
  @@index([status, endsAt])
  @@map("events")
}

/// One dated occurrence of an event (a SINGLE event has one, a SERIES
/// several). Own table rather than SessionSchedule: see docs/ETKINLIKLER.md.
model EventOccurrence {
  id             String    @id @default(uuid()) @db.Uuid
  studioId       String    @map("studio_id") @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  startsAt       DateTime  @map("starts_at")
  endsAt         DateTime  @map("ends_at")
  resourceId     String?   @map("resource_id") @db.Uuid
  trainerId      String?   @map("trainer_id") @db.Uuid
  /// Set once the 24-hour reminder went out for this occurrence.
  reminderSentAt DateTime? @map("reminder_sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  studio   Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  event    Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  resource Resource?       @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  trainer  TrainerProfile? @relation("EventOccurrenceTrainer", fields: [trainerId], references: [id], onDelete: SetNull)

  @@index([eventId, startsAt])
  @@index([studioId, startsAt])
  @@index([startsAt, reminderSentAt])
  @@map("event_occurrences")
}

/// A ticket type of an event: price with its currency, optional quantity
/// limit and sales window, member-only flag, and optionally payment with
/// package units (a package covering creditServiceTypeId, creditUnits each).
model EventTicketType {
  id                  String    @id @default(uuid()) @db.Uuid
  studioId            String    @map("studio_id") @db.Uuid
  eventId             String    @map("event_id") @db.Uuid
  name                String    @db.VarChar(120)
  description         String?   @db.Text
  priceAmount         Decimal   @default(0) @map("price_amount") @db.Decimal(10, 2)
  currency            String    @db.VarChar(3)
  quantityLimit       Int?      @map("quantity_limit")
  soldCount           Int       @default(0) @map("sold_count")
  salesStartAt        DateTime? @map("sales_start_at")
  salesEndAt          DateTime? @map("sales_end_at")
  membersOnly         Boolean   @default(false) @map("members_only")
  allowMultiple       Boolean   @default(false) @map("allow_multiple")
  creditServiceTypeId String?   @map("credit_service_type_id") @db.Uuid
  creditUnits         Int?      @map("credit_units")
  isActive            Boolean   @default(true) @map("is_active")
  sortOrder           Int       @default(0) @map("sort_order")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  studio            Studio              @relation(fields: [studioId], references: [id], onDelete: Cascade)
  event             Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  creditServiceType ServiceType?        @relation(fields: [creditServiceTypeId], references: [id], onDelete: SetNull)
  registrations     EventRegistration[]

  @@index([eventId, sortOrder])
  @@index([studioId])
  @@map("event_ticket_types")
}

/// A person's registration: a member (memberId) or a CRM contact
/// (contactId, a guest from the public page). `dedupeKey` makes one live
/// registration per person and event unique; it is cleared on cancellation
/// and null for ticket types that allow several registrations.
model EventRegistration {
  id                    String    @id @default(uuid()) @db.Uuid
  studioId              String    @map("studio_id") @db.Uuid
  eventId               String    @map("event_id") @db.Uuid
  ticketTypeId          String    @map("ticket_type_id") @db.Uuid
  memberId              String?   @map("member_id") @db.Uuid
  contactId             String?   @map("contact_id") @db.Uuid
  status                String    @db.VarChar(20)
  source                String    @db.VarChar(10)
  dedupeKey             String?   @map("dedupe_key") @db.VarChar(80)
  waitlistPosition      Int?      @map("waitlist_position")
  amountDue             Decimal   @default(0) @map("amount_due") @db.Decimal(10, 2)
  amountPaid            Decimal   @default(0) @map("amount_paid") @db.Decimal(10, 2)
  refundedAmount        Decimal   @default(0) @map("refunded_amount") @db.Decimal(10, 2)
  currency              String    @db.VarChar(3)
  paymentId             String?   @unique @map("payment_id") @db.Uuid
  paymentMethod         String?   @map("payment_method") @db.VarChar(20)
  paymentLink           String?   @map("payment_link") @db.Text
  paymentDueAt          DateTime? @map("payment_due_at")
  memberPackageId       String?   @map("member_package_id") @db.Uuid
  unitsCharged          Int       @default(0) @map("units_charged")
  refundedUnits         Int       @default(0) @map("refunded_units")
  checkedInAt           DateTime? @map("checked_in_at")
  cancelledAt           DateTime? @map("cancelled_at")
  cancellationReason    String?   @map("cancellation_reason") @db.Text
  notes                 String?   @db.Text
  createdByMembershipId String?   @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  studio        Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  event         Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType    EventTicketType @relation(fields: [ticketTypeId], references: [id])
  member        MemberProfile?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  contact       Contact?        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  payment       Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  memberPackage MemberPackage?  @relation(fields: [memberPackageId], references: [id], onDelete: SetNull)
  createdBy     Membership?     @relation("EventRegistrationCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@unique([eventId, dedupeKey])
  @@index([studioId, eventId, status])
  @@index([eventId, status, waitlistPosition])
  @@index([studioId, status, paymentDueAt])
  @@index([memberId])
  @@index([contactId])
  @@map("event_registrations")
}

// ---------------------------------------------------------------------------
// Retail and stock (G3c-2, docs/PERAKENDE.md)
// ---------------------------------------------------------------------------

enum StockMovementType {
  RECEIVE
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  VOID
}

/// Per-studio retail settings and the receipt number sequence. The row is
/// created on first use; `last_receipt_seq` is incremented inside the sale
/// transaction, so receipt numbers are gapless and unique per studio.
model RetailSettings {
  studioId       String   @id @map("studio_id") @db.Uuid
  /// Tracked products may be sold below zero stock. Off by default.
  allowBackorder Boolean  @default(false) @map("allow_backorder")
  receiptPrefix  String   @default("S") @map("receipt_prefix") @db.VarChar(10)
  lastReceiptSeq Int      @default(0) @map("last_receipt_seq")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@map("retail_settings")
}

model ProductCategory {
  id        String   @id @default(uuid()) @db.Uuid
  studioId  String   @map("studio_id") @db.Uuid
  name      String   @db.VarChar(80)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studio   Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([studioId, name])
  @@map("product_categories")
}

/// A physical product or simple add-on sold at the desk. Price is stored with
/// its currency (always the studio currency, rule 8); `taxRate` null means
/// the studio default (docs/PERAKENDE.md). Sold products are deactivated, not
/// deleted, so sale lines and the stock ledger keep their reference.
model Product {
  id                String   @id @default(uuid()) @db.Uuid
  studioId          String   @map("studio_id") @db.Uuid
  categoryId        String?  @map("category_id") @db.Uuid
  name              String   @db.VarChar(120)
  sku               String?  @db.VarChar(60)
  barcode           String?  @db.VarChar(64)
  description       String?  @db.Text
  price             Decimal  @db.Decimal(12, 2)
  currency          String   @db.VarChar(3)
  /// Percentage, e.g. 20.00. Null uses the studio default rate.
  taxRate           Decimal? @map("tax_rate") @db.Decimal(5, 2)
  /// Purchase cost per unit, for margin reporting.
  costPrice         Decimal? @map("cost_price") @db.Decimal(12, 2)
  isActive          Boolean  @default(true) @map("is_active")
  trackStock        Boolean  @default(true) @map("track_stock")
  lowStockThreshold Int?     @map("low_stock_threshold")
  imageUrl          String?  @map("image_url") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  studio         Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  saleLines      SaleLine[]

  @@unique([studioId, sku])
  @@unique([studioId, barcode])
  /// Target of composite foreign keys that pin a row to the product's studio.
  @@unique([id, studioId])
  @@index([studioId, isActive, name])
  @@map("products")
}

/// Cached on-hand quantity per product and branch. The stock ledger is the
/// source of truth; this row is updated in the same transaction as every
/// movement, with a conditional update so concurrent sales cannot oversell.
model StockLevel {
  studioId  String   @map("studio_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  quantity  Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  product Product @relation(fields: [productId, studioId], references: [id, studioId], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId, studioId], references: [id, studioId], onDelete: Cascade)

  @@id([productId, branchId])
  @@index([studioId, branchId])
  @@map("stock_levels")
}

/// Append-only stock ledger: one row per change with the signed quantity and
/// the branch quantity after it. Rows are never updated or deleted.
model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  studioId      String            @map("studio_id") @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  branchId      String            @map("branch_id") @db.Uuid
  type          StockMovementType
  quantity      Int
  quantityAfter Int               @map("quantity_after")
  reason        String?           @db.VarChar(300)
  /// Free reference (delivery note, transfer group id).
  reference     String?           @db.VarChar(120)
  unitCost      Decimal?          @map("unit_cost") @db.Decimal(12, 2)
  saleId        String?           @map("sale_id") @db.Uuid
  saleRefundId  String?           @map("sale_refund_id") @db.Uuid
  actorUserId   String?           @map("actor_user_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")

  product Product @relation(fields: [productId, studioId], references: [id, studioId], onDelete: NoAction)
  branch  Branch  @relation(fields: [branchId, studioId], references: [id, studioId], onDelete: Cascade)

  @@index([studioId, createdAt])
  @@index([productId, branchId, createdAt])
  @@index([saleId])
  @@map("stock_movements")
}

/// A desk sale (cart checkout). Totals are stored with the currency; a sale
/// with a member also has one Payment row (payment_id), which carries the
/// promo redemption and feeds the CRM and loyalty hooks.
model Sale {
  id               String        @id @default(uuid()) @db.Uuid
  studioId         String        @map("studio_id") @db.Uuid
  branchId         String        @map("branch_id") @db.Uuid
  receiptSeq       Int           @map("receipt_seq")
  receiptNumber    String        @map("receipt_number") @db.VarChar(30)
  status           SaleStatus    @default(COMPLETED)
  memberId         String?       @map("member_id") @db.Uuid
  contactId        String?       @map("contact_id") @db.Uuid
  /// Customer name snapshot for the receipt.
  customerName     String?       @map("customer_name") @db.VarChar(150)
  currency         String        @db.VarChar(3)
  pricesIncludeTax Boolean       @map("prices_include_tax")
  subtotal         Decimal       @db.Decimal(12, 2)
  discountTotal    Decimal       @default(0) @map("discount_total") @db.Decimal(12, 2)
  netTotal         Decimal       @map("net_total") @db.Decimal(12, 2)
  taxTotal         Decimal       @map("tax_total") @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  refundedAmount   Decimal       @default(0) @map("refunded_amount") @db.Decimal(12, 2)
  paymentMethod    PaymentMethod @map("payment_method")
  paymentId        String?       @unique @map("payment_id") @db.Uuid
  promoCode        String?       @map("promo_code") @db.VarChar(40)
  promoDiscount    Decimal       @default(0) @map("promo_discount") @db.Decimal(12, 2)
  note             String?       @db.Text
  idempotencyKey   String?       @map("idempotency_key") @db.VarChar(64)
  soldByUserId     String        @map("sold_by_user_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  studio  Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  branch  Branch         @relation(fields: [branchId, studioId], references: [id, studioId], onDelete: Cascade)
  member  MemberProfile? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  contact Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  payment Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  lines   SaleLine[]
  refunds SaleRefund[]

  @@unique([studioId, receiptSeq])
  @@unique([studioId, receiptNumber])
  @@unique([studioId, idempotencyKey])
  @@unique([id, studioId])
  @@index([studioId, createdAt])
  @@index([branchId, createdAt])
  @@index([memberId])
  @@map("sales")
}

model SaleLine {
  id               String   @id @default(uuid()) @db.Uuid
  studioId         String   @map("studio_id") @db.Uuid
  saleId           String   @map("sale_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  /// Cart order, so the receipt lists lines as they were rung up.
  position         Int      @default(0)
  /// Snapshots at sale time: later product edits never rewrite a receipt.
  productName      String   @map("product_name") @db.VarChar(120)
  sku              String?  @db.VarChar(60)
  stockTracked     Boolean  @map("stock_tracked")
  quantity         Int
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  unitCost         Decimal? @map("unit_cost") @db.Decimal(12, 2)
  lineDiscount     Decimal  @default(0) @map("line_discount") @db.Decimal(12, 2)
  orderDiscount    Decimal  @default(0) @map("order_discount") @db.Decimal(12, 2)
  taxRate          Decimal  @map("tax_rate") @db.Decimal(5, 2)
  netAmount        Decimal  @map("net_amount") @db.Decimal(12, 2)
  taxAmount        Decimal  @map("tax_amount") @db.Decimal(12, 2)
  total            Decimal  @db.Decimal(12, 2)
  refundedQuantity Int      @default(0) @map("refunded_quantity")
  refundedAmount   Decimal  @default(0) @map("refunded_amount") @db.Decimal(12, 2)

  sale        Sale             @relation(fields: [saleId, studioId], references: [id, studioId], onDelete: Cascade)
  product     Product          @relation(fields: [productId, studioId], references: [id, studioId], onDelete: NoAction)
  refundLines SaleRefundLine[]

  @@index([saleId])
  @@index([studioId, productId])
  @@map("sale_lines")
}

model SaleRefund {
  id          String   @id @default(uuid()) @db.Uuid
  studioId    String   @map("studio_id") @db.Uuid
  saleId      String   @map("sale_id") @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @db.VarChar(3)
  reason      String   @db.VarChar(300)
  actorUserId String   @map("actor_user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  sale  Sale             @relation(fields: [saleId, studioId], references: [id, studioId], onDelete: Cascade)
  lines SaleRefundLine[]

  @@index([saleId])
  @@index([studioId, createdAt])
  @@map("sale_refunds")
}

model SaleRefundLine {
  id         String  @id @default(uuid()) @db.Uuid
  studioId   String  @map("studio_id") @db.Uuid
  refundId   String  @map("refund_id") @db.Uuid
  saleLineId String  @map("sale_line_id") @db.Uuid
  quantity   Int
  amount     Decimal @db.Decimal(12, 2)
  restocked  Boolean

  refund   SaleRefund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  saleLine SaleLine   @relation(fields: [saleLineId], references: [id], onDelete: Cascade)

  @@index([refundId])
  @@index([saleLineId])
  @@map("sale_refund_lines")
}

/// Tenant-defined conversion funnel (G5d-1, docs/HUNILER.md): an ordered list
/// of 2-6 ConversionEvent types with an optional maximum step-to-step window.
/// Ready-made funnels are code-defined in @platform/shared, not rows.
model Funnel {
  id                    String   @id @default(uuid()) @db.Uuid
  studioId              String   @map("studio_id") @db.Uuid
  name                  String   @db.VarChar(100)
  /// FunnelStepsSchema in @platform/shared, validated on every write.
  steps                 Json
  /// Maximum days between two consecutive steps; null means no limit.
  windowDays            Int?     @map("window_days")
  createdByMembershipId String?  @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId, createdAt])
  @@map("funnels")
}

// ---------------------------------------------------------------------------
// G5c-1: trial, activation and business-to-business referrals
// (docs/DENEME_VE_ETKINLESTIRME.md)
// ---------------------------------------------------------------------------

/// One platform invoice payment by a tenant (activation or a later period).
/// The tenant pays the platform, so this is not a tenant Payment row.
model PlatformBillingPayment {
  id                String           @id @default(uuid()) @db.Uuid
  studioId          String           @map("studio_id") @db.Uuid
  /// Null on an add-on payment (G5c-2, then studioAddOnId is set).
  planId            String?          @map("plan_id") @db.Uuid
  /// The add-on subscription this payment is for (G5c-2), null on a plan payment.
  studioAddOnId     String?          @map("studio_add_on_id") @db.Uuid
  /// Plan price for the period before credits.
  listAmount        Decimal          @map("list_amount") @db.Decimal(10, 2)
  /// Referral credit applied to this charge (same currency).
  creditAmount      Decimal          @default(0) @map("credit_amount") @db.Decimal(10, 2)
  /// Free months of credit applied to this charge.
  creditMonths      Int              @default(0) @map("credit_months")
  /// Charged through the provider: listAmount minus credits, never negative.
  amount            Decimal          @db.Decimal(10, 2)
  currency          String           @db.VarChar(3)
  periodMonths      Int              @default(1) @map("period_months")
  /// Null when credits covered the whole charge and no provider was called.
  provider          PaymentProvider?
  providerReference String?          @map("provider_reference") @db.VarChar(200)
  /// PENDING | COMPLETED | FAILED (PLATFORM_PAYMENT_STATUSES in @platform/shared).
  status            String           @default("PENDING") @db.VarChar(20)
  paidAt            DateTime?        @map("paid_at")
  createdByUserId   String?          @map("created_by_user_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  studio        Studio                 @relation(fields: [studioId], references: [id], onDelete: Cascade)
  plan          Plan?                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  studioAddOn   StudioAddOn?           @relation(fields: [studioAddOnId], references: [id], onDelete: SetNull)
  creditEntries PlatformCreditLedger[]

  @@unique([provider, providerReference])
  @@index([studioId, createdAt])
  @@index([studioAddOnId])
  @@map("platform_billing_payments")
}

/// A business referred by another business. One row per referred studio
/// (unique), so a studio can only ever be referred, and rewarded, once.
model StudioReferral {
  id               String    @id @default(uuid()) @db.Uuid
  referrerStudioId String    @map("referrer_studio_id") @db.Uuid
  referredStudioId String    @unique @map("referred_studio_id") @db.Uuid
  code             String    @db.VarChar(16)
  /// TOUCHPOINT (pw_ref on a platform site visit) or MANUAL (code entered by the super admin).
  source           String    @db.VarChar(20)
  touchpointId     String?   @map("touchpoint_id") @db.Uuid
  /// SIGNED_UP | REWARDED | REJECTED (STUDIO_REFERRAL_STATUSES).
  status           String    @default("SIGNED_UP") @db.VarChar(20)
  rejectReason     String?   @map("reject_reason") @db.VarChar(40)
  rewardedAt       DateTime? @map("rewarded_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  referrer      Studio                 @relation("StudioReferralReferrer", fields: [referrerStudioId], references: [id], onDelete: Cascade)
  referred      Studio                 @relation("StudioReferralReferred", fields: [referredStudioId], references: [id], onDelete: Cascade)
  touchpoint    Touchpoint?            @relation(fields: [touchpointId], references: [id], onDelete: SetNull)
  creditEntries PlatformCreditLedger[]

  @@index([referrerStudioId, createdAt])
  @@map("studio_referrals")
}

/// Append-only subscription credit ledger per tenant. Rows are never
/// updated or deleted by the application; the balance is the sum.
/// idempotencyKey makes every write safe to retry (e.g. one reward per
/// referred studio: referral-reward:<referredStudioId>).
model PlatformCreditLedger {
  id               String   @id @default(uuid()) @db.Uuid
  studioId         String   @map("studio_id") @db.Uuid
  /// REFERRAL_REWARD | APPLIED | ADJUSTMENT (PLATFORM_CREDIT_KINDS).
  kind             String   @db.VarChar(20)
  /// Signed money credit; null for a months-only entry.
  amount           Decimal? @db.Decimal(10, 2)
  currency         String?  @db.VarChar(3)
  /// Signed free months; null for a money-only entry.
  months           Int?
  referralId       String?  @map("referral_id") @db.Uuid
  billingPaymentId String?  @map("billing_payment_id") @db.Uuid
  idempotencyKey   String   @unique @map("idempotency_key") @db.VarChar(120)
  createdAt        DateTime @default(now()) @map("created_at")

  studio         Studio                  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  referral       StudioReferral?         @relation(fields: [referralId], references: [id], onDelete: SetNull)
  billingPayment PlatformBillingPayment? @relation(fields: [billingPaymentId], references: [id], onDelete: SetNull)

  @@index([studioId, createdAt])
  @@map("platform_credit_ledger")
}

/// Platform-wide billing settings (single row, id "platform").
model PlatformBillingSettings {
  id                     String   @id @default("platform") @db.VarChar(20)
  /// AMOUNT or FREE_MONTHS (REFERRAL_REWARD_KINDS).
  referralRewardKind     String   @default("FREE_MONTHS") @map("referral_reward_kind") @db.VarChar(20)
  referralRewardAmount   Decimal? @map("referral_reward_amount") @db.Decimal(10, 2)
  referralRewardCurrency String?  @map("referral_reward_currency") @db.VarChar(3)
  referralRewardMonths   Int?     @default(1) @map("referral_reward_months")
  updatedByUserId        String?  @map("updated_by_user_id") @db.Uuid
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("platform_billing_settings")
}

// ---------------------------------------------------------------------------
// Bank payouts and reconciliation (G5d-2, docs/BANKA_ODEMELERI.md)
// ---------------------------------------------------------------------------

enum PayoutStatus {
  PENDING
  IN_TRANSIT
  PAID
  FAILED
  CANCELED
}

enum PayoutItemType {
  CHARGE
  REFUND
  FEE
  ADJUSTMENT
}

enum PayoutReconciliationStatus {
  MATCHED
  PARTIAL
  UNMATCHED
}

/// How a payout item got its payment link. UNMATCHED_MANUAL: a person removed
/// the link, so later syncs must not re-link it automatically.
enum PayoutMatchSource {
  AUTO
  MANUAL
  UNMATCHED_MANUAL
}

/// A batch transfer from a payment provider to the studio's bank account
/// (Stripe payout, iyzico/PayTR settlement). Amounts are decimals in the
/// payout's own currency, never a hard-coded one.
model Payout {
  id                   String                     @id @default(uuid()) @db.Uuid
  studioId             String                     @map("studio_id") @db.Uuid
  provider             PaymentProvider
  providerPayoutId     String                     @map("provider_payout_id") @db.VarChar(120)
  status               PayoutStatus
  arrivalDate          DateTime                   @map("arrival_date")
  /// Sum of CHARGE items.
  grossAmount          Decimal                    @map("gross_amount") @db.Decimal(12, 2)
  /// Item fees plus FEE items, as a positive amount.
  feeAmount            Decimal                    @map("fee_amount") @db.Decimal(12, 2)
  /// Sum of REFUND items, as a positive amount.
  refundAmount         Decimal                    @map("refund_amount") @db.Decimal(12, 2)
  /// The amount the provider actually transferred to the bank.
  netAmount            Decimal                    @map("net_amount") @db.Decimal(12, 2)
  currency             String                     @db.VarChar(3)
  itemCount            Int                        @default(0) @map("item_count")
  /// Charge and refund items linked to a payment.
  matchedItemCount     Int                        @default(0) @map("matched_item_count")
  /// Charge and refund items, the ones that can be matched.
  matchableItemCount   Int                        @default(0) @map("matchable_item_count")
  reconciliationStatus PayoutReconciliationStatus @default(UNMATCHED) @map("reconciliation_status")
  syncedAt             DateTime                   @default(now()) @map("synced_at")
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  studio Studio       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  items  PayoutItem[]

  @@unique([studioId, provider, providerPayoutId])
  @@index([studioId, arrivalDate])
  @@index([studioId, reconciliationStatus])
  @@map("payouts")
}

/// One line inside a payout: a charge, refund, fee or adjustment.
model PayoutItem {
  id                String             @id @default(uuid()) @db.Uuid
  studioId          String             @map("studio_id") @db.Uuid
  payoutId          String             @map("payout_id") @db.Uuid
  providerItemId    String             @map("provider_item_id") @db.VarChar(120)
  type              PayoutItemType
  /// The charge or refund id at the provider; matched against Payment.providerReference.
  providerReference String?            @map("provider_reference") @db.VarChar(120)
  /// A second reference to match on (the original charge of a refund, a checkout session).
  relatedReference  String?            @map("related_reference") @db.VarChar(120)
  /// Signed gross amount: charges positive, refunds and fees negative.
  amount            Decimal            @db.Decimal(12, 2)
  /// Provider fee of this line, positive.
  fee               Decimal            @default(0) @db.Decimal(12, 2)
  net               Decimal            @db.Decimal(12, 2)
  currency          String             @db.VarChar(3)
  occurredAt        DateTime           @map("occurred_at")
  description       String?            @db.VarChar(200)
  paymentId         String?            @map("payment_id") @db.Uuid
  matchSource       PayoutMatchSource? @map("match_source")

  studio  Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  payout  Payout   @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([payoutId, providerItemId])
  @@index([studioId, paymentId])
  @@index([studioId, providerReference])
  @@map("payout_items")
}

/// Per studio and provider: the provider account payouts are read from and
/// the state of the last sync. A real Stripe sync needs providerAccountId
/// (the studio's connected account), otherwise it would read the platform's own payouts.
model PayoutConnection {
  id                String          @id @default(uuid()) @db.Uuid
  studioId          String          @map("studio_id") @db.Uuid
  provider          PaymentProvider
  providerAccountId String?         @map("provider_account_id") @db.VarChar(120)
  lastSyncedAt      DateTime?       @map("last_synced_at")
  /// Short error code of the last failed sync; null after a successful one.
  lastError         String?         @map("last_error") @db.VarChar(200)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, provider])
  @@map("payout_connections")
}

/// Monthly price of a plan in one platform billing currency (G5c-1b,
/// PLATFORM_BILLING_CURRENCIES). A plan without a row in a studio's billing
/// currency is not offered to that studio.
model PlanPrice {
  id           String   @id @default(uuid()) @db.Uuid
  planId       String   @map("plan_id") @db.Uuid
  currency     String   @db.VarChar(3)
  priceMonthly Decimal  @map("price_monthly") @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, currency])
  @@map("plan_prices")
}

/// AMOUNT referral reward per platform billing currency (G5c-1b). Platform
/// level (no tenant): the referrer is credited in its own billing currency;
/// a currency without a row falls back to DEFAULT_REFERRAL_REWARD.
model PlatformReferralRewardAmount {
  currency  String   @id @db.VarChar(3)
  amount    Decimal  @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_referral_reward_amounts")
}

// ---------------------------------------------------------------------------
// H1 error reporting (docs/HATA_RAPORLAMA.md)
// ---------------------------------------------------------------------------

/// One distinct error across the platform, keyed by sha256 of the shared
/// fingerprint (source + type + normalised message + top in-app frame).
/// Platform-wide on purpose: the tenant of each occurrence lives on
/// ErrorEvent.studioId and in ErrorGroupStudio, so one bug hitting many
/// tenants is one group (and one alert).
model ErrorGroup {
  id                  String    @id @default(uuid()) @db.Uuid
  fingerprintHash     String    @unique @map("fingerprint_hash") @db.VarChar(64)
  fingerprint         String    @db.VarChar(1000)
  /// api | web | mobile | job (ERROR_SOURCES).
  source              String    @db.VarChar(10)
  type                String    @db.VarChar(120)
  /// Scrubbed, normalised "Type: message".
  title               String    @db.VarChar(200)
  topFrame            String?   @map("top_frame") @db.VarChar(300)
  /// OPEN | RESOLVED | IGNORED (ERROR_GROUP_STATUSES).
  status              String    @default("OPEN") @db.VarChar(10)
  count               Int       @default(0)
  affectedStudioCount Int       @default(0) @map("affected_studio_count")
  /// Approximate: distinct user hashes among the stored events.
  affectedUserCount   Int       @default(0) @map("affected_user_count")
  firstSeenAt         DateTime  @map("first_seen_at")
  lastSeenAt          DateTime  @map("last_seen_at")
  lastRelease         String?   @map("last_release") @db.VarChar(64)
  resolvedInRelease   String?   @map("resolved_in_release") @db.VarChar(64)
  resolvedAt          DateTime? @map("resolved_at")
  /// Seen on a login, auth, payment or billing route.
  critical            Boolean   @default(false)
  lastCode            String?   @map("last_code") @db.VarChar(8)
  note                String?   @db.Text
  /// Alert cooldown claim (one email per group per window).
  lastAlertAt         DateTime? @map("last_alert_at")
  /// H3: set when this group was merged into another; the fingerprint then lives on as an alias of the target.
  mergedIntoId        String?   @map("merged_into_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  events     ErrorEvent[]
  studios    ErrorGroupStudio[]
  mergedInto ErrorGroup?        @relation("ErrorGroupMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom ErrorGroup[]       @relation("ErrorGroupMerge")
  aliases    ErrorGroupAlias[]
  buckets    ErrorGroupBucket[]
  alerts     ErrorAlert[]

  @@index([lastSeenAt])
  @@index([status, lastSeenAt])
  @@index([mergedIntoId])
  @@map("error_groups")
}

/// One occurrence, already scrubbed. The id is the reporter's event id (the
/// user-facing code is its first 8 hex digits). The last 50 per group are
/// kept and none older than 30 days (heartbeat purge).
model ErrorEvent {
  id          String   @id @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  code        String   @db.VarChar(8)
  source      String   @db.VarChar(10)
  severity    String   @db.VarChar(10)
  release     String   @db.VarChar(64)
  environment String   @db.VarChar(20)
  route       String?  @db.VarChar(300)
  requestId   String?  @map("request_id") @db.VarChar(64)
  /// From the authenticated context only. No FK: events are purged by age, and the group cascades.
  studioId    String?  @map("studio_id") @db.Uuid
  /// sha256(server salt + user id), never the raw id.
  userIdHash  String?  @map("user_id_hash") @db.VarChar(64)
  type        String   @db.VarChar(120)
  message     String   @db.Text
  stack       String?  @db.Text
  /// Stack resolved with the release's uploaded source maps (H2); the raw stack stays in `stack`.
  symbolicatedStack String? @map("symbolicated_stack") @db.Text
  /// H3: source lines around the resolved frames (only when the map carried sourcesContent); the raw stack stays unchanged.
  symbolicatedContext Json? @map("symbolicated_context")
  /// H3: the user's optional "what were you doing" note (max 500 characters, PII scrubbed, no e-mail capture).
  feedback    String?  @db.VarChar(500)
  breadcrumbs Json?
  statusCode  Int?     @map("status_code")
  occurredAt  DateTime @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")

  group ErrorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, occurredAt])
  @@index([code])
  @@index([occurredAt])
  @@map("error_events")
}

/// Per-tenant counters of a group: the tenant owner view and the exact
/// affected studio count.
model ErrorGroupStudio {
  groupId     String   @map("group_id") @db.Uuid
  studioId    String   @map("studio_id") @db.Uuid
  count       Int      @default(0)
  firstSeenAt DateTime @map("first_seen_at")
  lastSeenAt  DateTime @map("last_seen_at")
  lastCode    String?  @map("last_code") @db.VarChar(8)
  /// H3: when the studio owner was last e-mailed about this group (at most once per 24 hours).
  ownerNotifiedAt DateTime? @map("owner_notified_at")

  group  ErrorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studio Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@id([groupId, studioId])
  @@index([studioId, lastSeenAt])
  @@map("error_group_studios")
}

// ---------------------------------------------------------------------------
// G5b: community feed and access tiers (docs/TOPLULUK.md)
// ---------------------------------------------------------------------------

/// Tenant-defined access tier: which members may see a community post. A
/// member satisfies the tier when any one of its rules matches; a tier
/// whose rules were all removed (e.g. the package definition was deleted)
/// matches nobody, so access fails closed.
model AccessTier {
  id          String   @id @default(uuid()) @db.Uuid
  studioId    String   @map("studio_id") @db.Uuid
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  studio Studio              @relation(fields: [studioId], references: [id], onDelete: Cascade)
  rules  AccessTierRule[]
  posts  CommunityPostTier[]

  @@index([studioId, name])
  @@map("access_tiers")
}

/// One rule of a tier: ACTIVE_MEMBER, ACTIVE_PACKAGE or PACKAGE_DEFINITION
/// (ACCESS_TIER_RULE_KINDS in @platform/shared). packageDefinitionId is set
/// exactly for PACKAGE_DEFINITION (CHECK constraint in the migration).
model AccessTierRule {
  id                  String   @id @default(uuid()) @db.Uuid
  studioId            String   @map("studio_id") @db.Uuid
  tierId              String   @map("tier_id") @db.Uuid
  kind                String   @db.VarChar(30)
  packageDefinitionId String?  @map("package_definition_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")

  tier              AccessTier         @relation(fields: [tierId], references: [id], onDelete: Cascade)
  packageDefinition PackageDefinition? @relation(fields: [packageDefinitionId], references: [id], onDelete: Cascade)

  @@index([tierId])
  @@index([studioId, packageDefinitionId])
  @@map("access_tier_rules")
}

/// A members-only feed item. type: COMMUNITY_POST_TYPES, status:
/// COMMUNITY_POST_STATUSES. shareToken is set only while the public share
/// link is on (32 random bytes, base64url); archiving clears it.
model CommunityPost {
  id                 String    @id @default(uuid()) @db.Uuid
  studioId           String    @map("studio_id") @db.Uuid
  type               String    @db.VarChar(20)
  status             String    @default("DRAFT") @db.VarChar(12)
  title              String    @db.VarChar(160)
  body               String    @default("") @db.Text
  videoContentId     String?   @map("video_content_id") @db.Uuid
  attachmentUrl      String?   @map("attachment_url") @db.Text
  attachmentName     String?   @map("attachment_name") @db.VarChar(200)
  pinned             Boolean   @default(false)
  commentsEnabled    Boolean   @default(true) @map("comments_enabled")
  authorMembershipId String?   @map("author_membership_id") @db.Uuid
  shareToken         String?   @unique @map("share_token") @db.VarChar(64)
  publishedAt        DateTime? @map("published_at")
  archivedAt         DateTime? @map("archived_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  studio       Studio              @relation(fields: [studioId], references: [id], onDelete: Cascade)
  videoContent VideoContent?       @relation(fields: [videoContentId], references: [id], onDelete: SetNull)
  author       Membership?         @relation("CommunityPostAuthor", fields: [authorMembershipId], references: [id], onDelete: SetNull)
  tiers        CommunityPostTier[]
  comments     CommunityComment[]
  reactions    CommunityReaction[]

  @@index([studioId, status, pinned, publishedAt])
  @@map("community_posts")
}

/// Which tiers a post requires (any one is enough). A tier that is still
/// used by a post cannot be deleted (NO ACTION: checked at the end of the
/// statement, so deleting a whole studio still cascades), so removing a tier never
/// silently opens a post to every member.
model CommunityPostTier {
  postId   String @map("post_id") @db.Uuid
  tierId   String @map("tier_id") @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tier AccessTier    @relation(fields: [tierId], references: [id], onDelete: NoAction)

  @@id([postId, tierId])
  @@index([tierId])
  @@map("community_post_tiers")
}

/// Plain-text comment. deletedAt: removed by its author or a moderator;
/// hiddenAt: hidden by a moderator (still visible to staff with community.view).
model CommunityComment {
  id                   String    @id @default(uuid()) @db.Uuid
  studioId             String    @map("studio_id") @db.Uuid
  postId               String    @map("post_id") @db.Uuid
  authorMembershipId   String?   @map("author_membership_id") @db.Uuid
  body                 String    @db.VarChar(1000)
  hiddenAt             DateTime? @map("hidden_at")
  hiddenByMembershipId String?   @map("hidden_by_membership_id") @db.Uuid
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  studio Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author Membership?   @relation("CommunityCommentAuthor", fields: [authorMembershipId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
  @@index([studioId, createdAt])
  @@map("community_comments")
}

/// One like per post and membership.
model CommunityReaction {
  id           String   @id @default(uuid()) @db.Uuid
  studioId     String   @map("studio_id") @db.Uuid
  postId       String   @map("post_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  studio     Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  post       CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  membership Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([postId, membershipId])
  @@index([studioId])
  @@map("community_reactions")
}

// ---------------------------------------------------------------------------
// D2 database backups (docs/YEDEKLER.md)
// ---------------------------------------------------------------------------

enum BackupRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum BackupTrigger {
  MANUAL
  SCHEDULED
}

/// Platform-level singleton (id "platform"): the schedule and retention the
/// super admin edits, plus the run lock. lockRunId is taken with a
/// conditional update, so only one backup runs at a time; a lock older than
/// the run timeout is considered abandoned (the process died mid-run).
model BackupSettings {
  id              String    @id @default("platform") @db.VarChar(20)
  scheduleEnabled Boolean   @default(true) @map("schedule_enabled")
  /// "HH:MM", UTC.
  scheduleTimeUtc String    @default("01:00") @map("schedule_time_utc") @db.VarChar(5)
  /// Off-site objects older than this are pruned after a verified backup; 0 = off.
  retentionDays   Int       @default(35) @map("retention_days")
  lockRunId       String?   @map("lock_run_id") @db.Uuid
  lockedAt        DateTime? @map("locked_at")
  updatedByUserId String?   @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("backup_settings")
}

/// One backup made by the API (the host cron's runs are not recorded here;
/// they are visible through the files they write). Platform data, not
/// tenant data: no studioId, super admin only.
model BackupRun {
  id                String          @id @default(uuid()) @db.Uuid
  status            BackupRunStatus @default(RUNNING)
  trigger           BackupTrigger
  startedAt         DateTime        @default(now()) @map("started_at")
  finishedAt        DateTime?       @map("finished_at")
  /// Encrypted size in bytes.
  sizeBytes         BigInt?         @map("size_bytes")
  objectKey         String?         @map("object_key") @db.VarChar(512)
  sha256            String?         @db.VarChar(64)
  verifiedAt        DateTime?       @map("verified_at")
  error             String?         @db.VarChar(1000)
  requestedByUserId String?         @map("requested_by_user_id") @db.Uuid

  @@index([startedAt])
  @@index([trigger, startedAt])
  @@map("backup_runs")
}

// ---------------------------------------------------------------------------
// M1: platform access (docs/PAZARLAMA_MODULU.md 2, 5.1, 6.3, 7.1-7.2)
// ---------------------------------------------------------------------------

/// Platform-level permission set. Keys come from PLATFORM_PERMISSIONS in
/// @platform/shared. System templates are seeded and cannot be deleted.
/// Super-admin status is never granted through a template.
model PlatformRoleTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(40)
  name      String   @db.VarChar(80)
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  permissions PlatformRoleTemplatePermission[]
  memberships PlatformMembership[]
  invites     InviteToken[]

  @@map("platform_role_templates")
}

model PlatformRoleTemplatePermission {
  roleTemplateId String @map("role_template_id") @db.Uuid
  permissionKey  String @map("permission_key") @db.VarChar(80)

  roleTemplate PlatformRoleTemplate @relation(fields: [roleTemplateId], references: [id], onDelete: Cascade)

  @@id([roleTemplateId, permissionKey])
  @@map("platform_role_template_permissions")
}

/// A user's single platform role. No studioId: platform level. While ACTIVE,
/// PlatformAccessService keeps a system-locked Membership in the platform
/// tenant (platformStudioMembershipId, no FK: the service is its only writer).
model PlatformMembership {
  id                         String           @id @default(uuid()) @db.Uuid
  userId                     String           @unique @map("user_id") @db.Uuid
  roleTemplateId             String           @map("role_template_id") @db.Uuid
  status                     MembershipStatus @default(INVITED)
  invitedByUserId            String?          @map("invited_by_user_id") @db.Uuid
  activatedAt                DateTime?        @map("activated_at")
  deactivatedAt              DateTime?        @map("deactivated_at")
  platformStudioMembershipId String?          @map("platform_studio_membership_id") @db.Uuid
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleTemplate PlatformRoleTemplate @relation(fields: [roleTemplateId], references: [id])

  @@index([status])
  @@map("platform_memberships")
}

/// Single-use 2FA recovery codes; only a SHA-256 hash is stored.
model UserMfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(128)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_mfa_recovery_codes")
}

/// Singleton platform access policy (row id "platform").
model PlatformAccessSettings {
  id                         String   @id @default("platform") @db.VarChar(20)
  require2faForPlatformRoles Boolean  @default(true) @map("require_2fa_for_platform_roles")
  updatedByUserId            String?  @map("updated_by_user_id") @db.Uuid
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("platform_access_settings")
}

/// Sender domain of a tenant (in practice the platform tenant) with the DNS
/// records SES needs and the result of the last check. No secrets here.
model EmailSenderDomain {
  id              String    @id @default(uuid()) @db.Uuid
  studioId        String    @map("studio_id") @db.Uuid
  domain          String    @db.VarChar(253)
  purpose         String    @default("MARKETING") @db.VarChar(20)
  mailFromDomain  String?   @map("mail_from_domain") @db.VarChar(253)
  dkimTokens      Json      @default("[]") @map("dkim_tokens")
  spfStatus       String    @default("PENDING") @map("spf_status") @db.VarChar(12)
  dkimStatus      String    @default("PENDING") @map("dkim_status") @db.VarChar(12)
  dmarcStatus     String    @default("PENDING") @map("dmarc_status") @db.VarChar(12)
  dmarcPolicy     String?   @map("dmarc_policy") @db.VarChar(20)
  lastCheckedAt   DateTime? @map("last_checked_at")
  lastError       String?   @map("last_error") @db.VarChar(500)
  warmupStartedAt DateTime? @map("warmup_started_at")
  dailyCap        Int?      @map("daily_cap")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, domain])
  @@map("email_sender_domains")
}

// ---------------------------------------------------------------------------
// M2 marketing studio (docs/PAZARLAMA_MODULU.md 4, 7.3): brand kit, product
// facts, AI studio drafts and the content calendar. Every table carries
// studioId and is in practice written only for the platform tenant.
// ---------------------------------------------------------------------------

enum MarketingDraftStatus {
  DRAFT
  REVIEWED
  ARCHIVED
}

enum ContentCalendarStatus {
  PLANNED
  DRAFTED
  APPROVED
  SENT
  CANCELLED
}

/// Brand kit of a tenant (the platform tenant today): one row per studio; `version` grows on every save.
model BrandKit {
  id                String   @id @default(uuid()) @db.Uuid
  studioId          String   @unique @map("studio_id") @db.Uuid
  version           Int      @default(1)
  brandName         String   @map("brand_name") @db.VarChar(80)
  positioning       String   @default("") @db.VarChar(400)
  defaultLocale     String   @map("default_locale") @db.VarChar(10)
  /// { website, linkedin, instagram, facebook, x, youtube } (https URLs).
  links             Json     @default("{}")
  /// { EMAIL | SMS | WHATSAPP: { displayName, address, replyTo } }
  senderIdentities  Json     @default("{}") @map("sender_identities")
  /// [{ key, name, description }]
  icps              Json     @default("[]")
  updatedByUserId   String?  @map("updated_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  studio  Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  locales BrandKitLocale[]

  @@map("brand_kits")
}

/// Voice of the brand in one language: tone notes, do and don't lists, banned phrases and the required disclaimer per channel.
model BrandKitLocale {
  id                  String   @id @default(uuid()) @db.Uuid
  studioId            String   @map("studio_id") @db.Uuid
  brandKitId          String   @map("brand_kit_id") @db.Uuid
  locale              String   @db.VarChar(10)
  toneNotes           String   @default("") @map("tone_notes") @db.Text
  doList              Json     @default("[]") @map("do_list")
  dontList            Json     @default("[]") @map("dont_list")
  bannedPhrases       Json     @default("[]") @map("banned_phrases")
  /// { EMAIL | SMS | WHATSAPP: text }
  requiredDisclaimers Json     @default("{}") @map("required_disclaimers")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  studio   Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  brandKit BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)

  @@unique([brandKitId, locale])
  @@index([studioId])
  @@map("brand_kit_locales")
}

/// A short verified claim the AI may use; the statement is stored per language.
model ProductFact {
  id              String    @id @default(uuid()) @db.Uuid
  studioId        String    @map("studio_id") @db.Uuid
  key             String    @db.VarChar(60)
  category        String    @default("general") @db.VarChar(40)
  /// { locale: statement }
  statements      Json      @default("{}")
  sourceUrl       String?   @map("source_url") @db.VarChar(300)
  validUntil      DateTime? @map("valid_until") @db.Date
  isActive        Boolean   @default(true) @map("is_active")
  updatedByUserId String?   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, key])
  @@map("product_facts")
}

/// One AI studio output for one kind and language. Never sent or published by the studio; variants hold the alternative texts.
model MarketingDraft {
  id                 String               @id @default(uuid()) @db.Uuid
  studioId           String               @map("studio_id") @db.Uuid
  /// EMAIL, SMS, WHATSAPP, AD_META, AD_GOOGLE_RSA, AD_LINKEDIN, LANDING_BLOCK, SUBJECT_LINES, CTA_VARIANTS, SEO_OUTLINE, SEGMENT_SUGGESTION, RESEARCH_NOTE (shared list).
  kind               String               @db.VarChar(30)
  locale             String               @db.VarChar(10)
  title              String               @db.VarChar(160)
  status             MarketingDraftStatus @default(DRAFT)
  /// The brief the draft was generated from (already redacted of contact details).
  brief              Json?
  notes              String?              @db.Text
  /// Product fact keys given to the model.
  factKeys           Json                 @default("[]") @map("fact_keys")
  brandKitVersion    Int?                 @map("brand_kit_version")
  /// A/B setup stub (share, metric, wait, variant ids); stored only.
  abTest             Json?                @map("ab_test")
  /// Campaign created by "Kampanyaya aktar"; plain id, the campaign owns its own lifecycle.
  exportedCampaignId String?              @map("exported_campaign_id") @db.Uuid
  aiModel            String?              @map("ai_model") @db.VarChar(80)
  aiCostMicroUsd     Int                  @default(0) @map("ai_cost_micro_usd")
  createdByUserId    String?              @map("created_by_user_id") @db.Uuid
  updatedByUserId    String?              @map("updated_by_user_id") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  studio        Studio                  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  variants      MarketingDraftVariant[]
  calendarItems ContentCalendarItem[]

  @@index([studioId, status, createdAt])
  @@index([studioId, kind])
  @@map("marketing_drafts")
}

model MarketingDraftVariant {
  id        String    @id @default(uuid()) @db.Uuid
  studioId  String    @map("studio_id") @db.Uuid
  draftId   String    @map("draft_id") @db.Uuid
  position  Int
  /// A, B, C, ...
  key       String    @db.VarChar(4)
  content   Json
  /// Deterministic brand check result of the current content.
  issues    Json      @default("[]")
  editedAt  DateTime? @map("edited_at")
  createdAt DateTime  @default(now()) @map("created_at")

  studio Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  draft  MarketingDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, key])
  @@index([studioId])
  @@map("marketing_draft_variants")
}

/// A planned piece of marketing content on a date. Nothing is sent from here; draftId and campaignId only link.
model ContentCalendarItem {
  id              String                @id @default(uuid()) @db.Uuid
  studioId        String                @map("studio_id") @db.Uuid
  title           String                @db.VarChar(160)
  /// EMAIL, SMS, WHATSAPP, AD_META, AD_GOOGLE, AD_LINKEDIN, SOCIAL, BLOG, LANDING, OTHER (shared list).
  channel         String                @db.VarChar(20)
  scheduledDate   DateTime              @map("scheduled_date") @db.Date
  status          ContentCalendarStatus @default(PLANNED)
  draftId         String?               @map("draft_id") @db.Uuid
  campaignId      String?               @map("campaign_id") @db.Uuid
  ownerUserId     String?               @map("owner_user_id") @db.Uuid
  notes           String?               @db.Text
  createdByUserId String?               @map("created_by_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  studio Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  draft  MarketingDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)

  @@index([studioId, scheduledDate])
  @@map("content_calendar_items")
}

// ---------------------------------------------------------------------------
// M3b marketing approvals (docs/PAZARLAMA_MODULU.md 6.1, 6.2, 7.4): approval
// requests for outgoing actions and the marketing settings (thresholds,
// caps, TTL). Enforced for the platform tenant only; other tenants have no
// MarketingSettings row and keep their behaviour.
// ---------------------------------------------------------------------------

enum ApprovalTargetType {
  CAMPAIGN
  JOURNEY
  SOCIAL_POST
  PAGE_PUBLISH
  AD_BUDGET
  AD_ACTIVATE
  EXPORT
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
  SELF_APPROVED
}

/// One request to let an outgoing action (a campaign send today) happen. Bound to contentHash: a change of the content invalidates it.
model ApprovalRequest {
  id                String                @id @default(uuid()) @db.Uuid
  studioId          String                @map("studio_id") @db.Uuid
  targetType        ApprovalTargetType    @map("target_type")
  /// Id of the campaign (or later journey, post, ...); plain id, the target owns its lifecycle.
  targetId          String                @map("target_id") @db.Uuid
  /// sha256 hex of the content fingerprint (template versions, audience count, schedule, channel).
  contentHash       String                @map("content_hash") @db.VarChar(64)
  /// Precheck summary: audience, regions, cost estimate, findings, reasons (shared ApprovalSummary).
  summary           Json                  @default("{}")
  status            ApprovalRequestStatus @default(PENDING)
  requestedByUserId String                @map("requested_by_user_id") @db.Uuid
  decidedByUserId   String?               @map("decided_by_user_id") @db.Uuid
  decisionNote      String?               @map("decision_note") @db.VarChar(1000)
  expiresAt         DateTime              @map("expires_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  decidedAt         DateTime?             @map("decided_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId, status, createdAt])
  @@index([studioId, targetType, targetId])
  @@index([status, expiresAt])
  @@map("approval_requests")
}

/// Marketing thresholds and caps of a tenant (the platform tenant today). Only the approval fields have behaviour in M3b.
model MarketingSettings {
  studioId                 String   @id @map("studio_id") @db.Uuid
  selfApproveEmailMax      Int      @default(1000) @map("self_approve_email_max")
  selfApproveSmsMax        Int      @default(100) @map("self_approve_sms_max")
  selfApproveSmsCredits    Int      @default(100) @map("self_approve_sms_credits")
  requireApprovalForSocial Boolean  @default(false) @map("require_approval_for_social")
  dailyEmailCap            Int?     @map("daily_email_cap")
  dailySmsCreditCap        Int?     @map("daily_sms_credit_cap")
  /// { ISO 4217 currency: decimal string }
  monthlyAdSpendCaps       Json     @default("{}") @map("monthly_ad_spend_caps")
  aiDailyCapCents          Int?     @map("ai_daily_cap_cents")
  bounceAutoPausePct       Decimal  @default(2) @map("bounce_auto_pause_pct") @db.Decimal(6, 3)
  complaintAutoPausePct    Decimal  @default(0.08) @map("complaint_auto_pause_pct") @db.Decimal(6, 3)
  /// Segment rule group (shared SegmentGroupSchema) defining an MQL / SQL; used by the dashboard (M3a).
  mqlRule                  Json?    @map("mql_rule")
  sqlRule                  Json?    @map("sql_rule")
  weeklySummaryEnabled     Boolean  @default(false) @map("weekly_summary_enabled")
  /// [userId]
  weeklySummaryRecipients  Json     @default("[]") @map("weekly_summary_recipients")
  approvalTtlHours         Int      @default(72) @map("approval_ttl_hours")
  /// Compliance region codes (EU, UK, ...) or ISO countries whose form
  /// consents need double opt-in (M3e). Data, editable by the super admin.
  doubleOptInRegions       Json     @default("[\"EU\", \"UK\"]") @map("double_opt_in_regions")
  /// TR merchant exemption: business contacts in TR may receive commercial
  /// messages without prior consent (registered with İYS, opt-out honoured).
  trMerchantExemptionEnabled Boolean @default(false) @map("tr_merchant_exemption_enabled")
  /// M3d: optional warm-up plan for the daily e-mail cap: [cap of day 1, cap of day 2, ...] counted from the
  /// day the sender domain was verified; null: no warm-up.
  emailWarmupPlan          Json?    @map("email_warmup_plan")
  updatedByUserId          String?  @map("updated_by_user_id") @db.Uuid
  updatedAt                DateTime @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@map("marketing_settings")
}

/// M3c: how a campaign's send time is decided.
enum CampaignSendTimeMode {
  FIXED
  RECIPIENT_LOCAL
  BEST_TIME
}

/// M3c: one variant of a campaign A/B test. Content is the campaign template
/// (templateKey null) or another template, with optional e-mail/SMS overrides.
model CampaignVariant {
  id                String   @id @default(uuid()) @db.Uuid
  studioId          String   @map("studio_id") @db.Uuid
  campaignId        String   @map("campaign_id") @db.Uuid
  /// A, B, C ... (unique per campaign).
  key               String   @db.VarChar(2)
  templateKey       String?  @map("template_key") @db.VarChar(60)
  /// { subject?, preheader?, body? }
  templateOverrides Json?    @map("template_overrides")
  /// Provenance only: the AI studio draft the content came from (plain id).
  aiDraftId         String?  @map("ai_draft_id") @db.Uuid
  isWinner          Boolean  @default(false) @map("is_winner")
  /// Cache written when the winner is chosen: { sent, opened, clicked, converted }.
  stats             Json?
  createdAt         DateTime @default(now()) @map("created_at")

  studio   Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, key])
  @@index([studioId])
  @@map("campaign_variants")
}

/// M3d: the weekly marketing summary of a tenant (the platform tenant today):
/// aggregate KPIs of one ISO week against the week before, the model's short
/// summary and suggested actions. One row per studio and week (the unique key
/// makes the heartbeat idempotent). `ai_usage_id` is a plain id (no FK).
model MarketingInsight {
  id          String   @id @default(uuid()) @db.Uuid
  studioId    String   @map("studio_id") @db.Uuid
  /// Monday (UTC) of the summarised week.
  periodStart DateTime @map("period_start") @db.Date
  /// Sunday (UTC) of the summarised week, inclusive.
  periodEnd   DateTime @map("period_end") @db.Date
  /// Aggregate figures only (shared InsightKpis), never a person.
  kpis        Json
  summary     String   @db.Text
  /// [{ title, detail, kpiKey }]
  actions     Json     @default("[]")
  aiUsageId   String?  @map("ai_usage_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, periodStart])
  @@index([studioId, createdAt])
  @@map("marketing_insights")
}

// ---------------------------------------------------------------------------
// M4b organic social publishing (docs/PAZARLAMA_MODULU.md 5.2, 6.1, 7.2):
// pasted-token connections to a Facebook Page, an Instagram business account
// or a LinkedIn organization, and the posts published through them.
// ---------------------------------------------------------------------------

enum SocialProvider {
  META_PAGE
  INSTAGRAM
  LINKEDIN_ORG
}

enum SocialConnectionStatus {
  CONNECTED
  ERROR
  REAUTH_REQUIRED
}

enum SocialPostStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

/// A connected social account of a tenant (the platform tenant today). Credentials are pasted tokens for now (OAuth is M4a).
model SocialConnection {
  id                   String                 @id @default(uuid()) @db.Uuid
  studioId             String                 @map("studio_id") @db.Uuid
  provider             SocialProvider
  /// Page id, Instagram business account id or LinkedIn organization id.
  externalId           String                 @map("external_id") @db.VarChar(80)
  displayName          String                 @map("display_name") @db.VarChar(160)
  /// Base64 iv+authTag+ciphertext of the credential object (CredentialCipher).
  encryptedCredentials String                 @map("encrypted_credentials") @db.Text
  /// Last 4 characters of the token, kept in the clear for display only.
  credentialLast4      String                 @map("credential_last4") @db.VarChar(4)
  status               SocialConnectionStatus @default(CONNECTED)
  lastError            String?                @map("last_error") @db.Text
  connectedByUserId    String?                @map("connected_by_user_id") @db.Uuid
  /// M4a: PASTED or OAUTH (INTEGRATION_AUTH_METHODS in @platform/shared).
  authMethod           String                 @default("PASTED") @map("auth_method") @db.VarChar(10)
  /// M4a: OAUTH_PROVIDERS value the token came from (null for pasted tokens).
  oauthProvider        String?                @map("oauth_provider") @db.VarChar(16)
  /// M4a: expiry of the stored token, when it has one (Meta page tokens from a long-lived user token do not).
  tokenExpiresAt       DateTime?              @map("token_expires_at")
  /// M4a: refresh token, CredentialCipher-encrypted.
  encryptedRefreshToken String?               @map("encrypted_refresh_token") @db.Text
  /// M4a: transient refresh failures in a row (backoff), reset on success.
  refreshAttempts      Int                    @default(0) @map("refresh_attempts")
  /// M4a: when the heartbeat looks at the token next (null: never).
  nextRefreshAt        DateTime?              @map("next_refresh_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  studio Studio       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  posts  SocialPost[]

  @@unique([studioId, provider, externalId])
  @@index([studioId, status])
  @@index([authMethod, nextRefreshAt])
  @@map("social_connections")
}

/// One organic post for one connection. Goes out only from SCHEDULED, bound to an ApprovalRequest whose contentHash still matches.
model SocialPost {
  id                String           @id @default(uuid()) @db.Uuid
  studioId          String           @map("studio_id") @db.Uuid
  connectionId      String           @map("connection_id") @db.Uuid
  status            SocialPostStatus @default(DRAFT)
  /// Language of the text (brand check uses the brand kit of this locale).
  locale            String           @default("tr") @db.VarChar(10)
  text              String           @db.Text
  /// [url] public image or video URLs.
  mediaUrls         Json             @default("[]") @map("media_urls")
  link              String?          @db.VarChar(2000)
  scheduledAt       DateTime?        @map("scheduled_at")
  publishedAt       DateTime?        @map("published_at")
  externalPostId    String?          @map("external_post_id") @db.VarChar(160)
  lastError         String?          @map("last_error") @db.Text
  /// Publish attempts made so far (retries with backoff on 5xx/429).
  attemptCount      Int              @default(0) @map("attempt_count")
  /// Earliest time of the next attempt after a retryable failure.
  nextAttemptAt     DateTime?        @map("next_attempt_at")
  aiDraftId         String?          @map("ai_draft_id") @db.Uuid
  calendarItemId    String?          @map("calendar_item_id") @db.Uuid
  approvalRequestId String?          @map("approval_request_id") @db.Uuid
  createdByUserId   String           @map("created_by_user_id") @db.Uuid
  /// Result of the deterministic brand check: { checkedAt, issues: MarketingCheckIssue[] }.
  brandCheck        Json             @default("{}") @map("brand_check")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  studio     Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  connection SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([studioId, status, scheduledAt])
  @@index([status, scheduledAt])
  @@index([studioId, calendarItemId])
  @@map("social_posts")
}

// ---------------------------------------------------------------------------
// M4c: inbound leads and automation (docs/PAZARLAMA_MODULU.md 5.2, 8)
// ---------------------------------------------------------------------------

/// One Meta Lead Ads notification (a `leadgen` change), the idempotency record
/// of the intake: (studio_id, leadgen_id) is unique, so a re-delivered webhook
/// or a retry never creates a second contact. `status` is one of
/// LEAD_AD_EVENT_STATUSES in @platform/shared. studio_id and contact_id are
/// plain ids (no foreign keys), like approval_requests.target_id.
model LeadAdEvent {
  id            String    @id @default(uuid()) @db.Uuid
  studioId      String    @map("studio_id") @db.Uuid
  connectionId  String?   @map("connection_id") @db.Uuid
  leadgenId     String    @map("leadgen_id") @db.VarChar(40)
  formId        String    @map("form_id") @db.VarChar(40)
  pageId        String    @map("page_id") @db.VarChar(40)
  /// { campaignId?, adsetId?, adId? } from the lead payload.
  adIds         Json      @default("{}") @map("ad_ids")
  /// Answers not mapped to a contact field, kept as-is (the attributes bag).
  attributes    Json      @default("{}")
  /// Meta's created_time of the lead.
  createdTime   DateTime? @map("created_time")
  receivedAt    DateTime  @default(now()) @map("received_at")
  processedAt   DateTime? @map("processed_at")
  contactId     String?   @map("contact_id") @db.Uuid
  status        String    @default("PENDING") @db.VarChar(16)
  attempts      Int       @default(0)
  nextAttemptAt DateTime? @map("next_attempt_at")
  lastError     String?   @map("last_error") @db.Text

  @@unique([studioId, leadgenId])
  @@index([studioId, status, nextAttemptAt])
  @@index([studioId, receivedAt])
  @@map("lead_ad_events")
}

/// Per form: how the form's questions map to contact fields (data, edited in the
/// integrations hub) and which question is the marketing consent checkbox.
model LeadAdFormMapping {
  id                 String   @id @default(uuid()) @db.Uuid
  studioId           String   @map("studio_id") @db.Uuid
  formId             String   @map("form_id") @db.VarChar(40)
  /// Display label only (Meta form names are not fetched).
  formName           String?  @map("form_name") @db.VarChar(120)
  /// { questionKey: name | first_name | last_name | email | phone | company | country }
  mapping            Json     @default("{}")
  consentQuestionKey String?  @map("consent_question_key") @db.VarChar(120)
  updatedByUserId    String?  @map("updated_by_user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([studioId, formId])
  @@map("lead_ad_form_mappings")
}

/// Idempotency-Key records of the public write endpoints, kept 24 hours. The
/// claim row is inserted before the work starts (IN_PROGRESS), so a parallel
/// duplicate is refused; DONE rows replay the stored response.
model PublicApiIdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  studioId       String   @map("studio_id") @db.Uuid
  apiKeyId       String   @map("api_key_id") @db.Uuid
  key            String   @db.VarChar(255)
  /// SHA-256 of method, path and canonical body: the same key with another request is refused.
  requestHash    String   @map("request_hash") @db.VarChar(64)
  status         String   @default("IN_PROGRESS") @db.VarChar(12)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  @@unique([studioId, key])
  @@index([expiresAt])
  @@map("public_api_idempotency_keys")
}

/// Platform-wide integration settings (singleton row id "platform"), edited by
/// the super admin only. Holds the Meta leadgen webhook verify token as a SHA-256
/// hash (Meta keeps the plaintext; the handshake compares hashes).
model PlatformIntegrationSettings {
  id                       String    @id @default("platform") @db.VarChar(20)
  leadgenVerifyTokenHash   String?   @map("leadgen_verify_token_hash") @db.VarChar(64)
  leadgenVerifyTokenLast4  String?   @map("leadgen_verify_token_last4") @db.VarChar(4)
  leadgenVerifyTokenSetAt  DateTime? @map("leadgen_verify_token_set_at")
  /// M4a: per OAuth provider { encrypted (CredentialCipher JSON of client id, secret and extras), clientIdLast4, clientSecretLast4, scopes, configIdSet, developerTokenLast4, updatedAt, updatedByUserId }.
  oauthClients             Json      @default("{}") @map("oauth_clients")
  updatedByUserId          String?   @map("updated_by_user_id") @db.Uuid
  updatedAt                DateTime  @updatedAt @map("updated_at")

  @@map("platform_integration_settings")
}

/// Add-on marketplace catalogue (G5c-2, docs/UYGULAMA_PAZARI.md): platform
/// data set by the super admin, no code per add-on. Name and description are
/// per-locale JSON objects ({ "tr": "...", "en": "..." }). An add-on unlocks
/// one feature flag key for the tenants that try or buy it.
model AddOn {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @unique @db.VarChar(60)
  name           Json
  description    Json
  promoVideoUrl  String?  @map("promo_video_url") @db.VarChar(500)
  /// string[] of https URLs.
  screenshotUrls Json     @default("[]") @map("screenshot_urls")
  featureFlagKey String   @map("feature_flag_key") @db.VarChar(80)
  trialDays      Int      @default(14) @map("trial_days")
  isPublished    Boolean  @default(false) @map("is_published")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  prices       AddOnPrice[]
  studioAddOns StudioAddOn[]

  @@index([isPublished, sortOrder])
  @@map("add_ons")
}

/// One price of an add-on per platform billing currency
/// (PLATFORM_BILLING_CURRENCIES in @platform/shared). No row for a currency
/// means the add-on is shown but not purchasable in it.
model AddOnPrice {
  id           String   @id @default(uuid()) @db.Uuid
  addOnId      String   @map("add_on_id") @db.Uuid
  currency     String   @db.VarChar(3)
  priceMonthly Decimal  @map("price_monthly") @db.Decimal(10, 2)
  priceYearly  Decimal  @map("price_yearly") @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  addOn AddOn @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@unique([addOnId, currency])
  @@map("add_on_prices")
}

/// A tenant's trial or subscription of an add-on (one row per tenant and
/// add-on, so the free trial can be used only once). status is
/// TRIALING | ACTIVE | CANCELLED | EXPIRED (ADD_ON_STATUSES in @platform/shared,
/// CHECK constraint in the migration). A row unlocks its feature flag while
/// TRIALING before trialEndsAt, ACTIVE, or CANCELLED before currentPeriodEnd.
model StudioAddOn {
  id                   String    @id @default(uuid()) @db.Uuid
  studioId             String    @map("studio_id") @db.Uuid
  addOnId              String    @map("add_on_id") @db.Uuid
  status               String    @default("TRIALING") @db.VarChar(12)
  /// MONTH | YEAR once bought, null while trialing.
  billingInterval      String?   @map("billing_interval") @db.VarChar(5)
  trialStartedAt       DateTime? @map("trial_started_at")
  trialEndsAt          DateTime? @map("trial_ends_at")
  activatedAt          DateTime? @map("activated_at")
  cancelledAt          DateTime? @map("cancelled_at")
  /// End of the paid period (or of the trial when cancelled while trialing).
  currentPeriodEnd     DateTime? @map("current_period_end")
  /// { currency, priceMonthly, priceYearly, interval, amount }: what the tenant was quoted; renewals charge this, so a later catalogue price change never surprises a running subscription.
  priceSnapshot        Json?     @map("price_snapshot")
  /// Set once when the "trial ends in 3 days" notice was sent.
  trialReminderSentAt  DateTime? @map("trial_reminder_sent_at")
  /// Consecutive failed renewal charges; reset by a successful one.
  renewalFailures      Int       @default(0) @map("renewal_failures")
  /// Dunning: do not retry the renewal before this moment.
  nextRenewalAttemptAt DateTime? @map("next_renewal_attempt_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  studio   Studio                   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  addOn    AddOn                    @relation(fields: [addOnId], references: [id])
  payments PlatformBillingPayment[]

  @@unique([studioId, addOnId])
  @@index([status, currentPeriodEnd])
  @@index([addOnId, status])
  @@map("studio_add_ons")
}

// ---------------------------------------------------------------------------
// H3: error reporting completion (docs/HATA_RAPORLAMA.md)
// ---------------------------------------------------------------------------

/// Fingerprint hash of a merged group -> the group that now owns it. New
/// events with this fingerprint land in the target. Always points at a live
/// (non-merged) group: merging the target later re-points its aliases.
model ErrorGroupAlias {
  fingerprintHash String   @id @map("fingerprint_hash") @db.VarChar(64)
  groupId         String   @map("group_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  group ErrorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("error_group_aliases")
}

/// Events per group per 15-minute bucket (UTC-aligned), the baseline of spike
/// detection. Independent of the per-group event cap (50 stored events);
/// the heartbeat deletes buckets older than 48 hours.
model ErrorGroupBucket {
  groupId     String   @map("group_id") @db.Uuid
  bucketStart DateTime @map("bucket_start")
  count       Int      @default(0)

  group ErrorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, bucketStart])
  @@index([bucketStart])
  @@map("error_group_buckets")
}

/// One alert raised for a group: SPIKE, NEW_GROUP or REGRESSION
/// (ERROR_ALERT_KINDS). (groupId, kind, windowStart) is unique, so a window
/// alerts once even if two heartbeats overlap.
model ErrorAlert {
  id                   String    @id @default(uuid()) @db.Uuid
  groupId              String    @map("group_id") @db.Uuid
  kind                 String    @db.VarChar(12)
  windowStart          DateTime  @map("window_start")
  windowEnd            DateTime  @map("window_end")
  windowCount          Int       @map("window_count")
  /// Events in the trailing 24 hours before the window (SPIKE only).
  baselineTotal        Int       @default(0) @map("baseline_total")
  /// Mean events per 15-minute bucket of that baseline.
  baselineMean         Float     @default(0) @map("baseline_mean")
  /// The count the window had to reach to count as a spike.
  threshold            Int       @default(0)
  notifiedAt           DateTime? @map("notified_at")
  acknowledgedAt       DateTime? @map("acknowledged_at")
  /// No FK: a deleted user must not delete alert history.
  acknowledgedByUserId String?   @map("acknowledged_by_user_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at")

  group      ErrorGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  deliveries ErrorAlertDelivery[]

  @@unique([groupId, kind, windowStart])
  @@index([groupId, createdAt])
  @@index([createdAt])
  @@map("error_alerts")
}

/// Delivery of an alert to one external sink (WEBHOOK or SLACK), retried with
/// the webhook backoff schedule by the heartbeat. No payload is stored.
model ErrorAlertDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  alertId        String    @map("alert_id") @db.Uuid
  /// WEBHOOK | SLACK (ERROR_ALERT_SINKS).
  sink           String    @db.VarChar(10)
  /// PENDING | SUCCEEDED | ABANDONED
  status         String    @default("PENDING") @db.VarChar(10)
  attempt        Int       @default(0)
  nextAttemptAt  DateTime? @map("next_attempt_at")
  lastStatusCode Int?      @map("last_status_code")
  /// Error class or HTTP status only, never a response body or the URL.
  lastError      String?   @map("last_error") @db.VarChar(200)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  alert ErrorAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([alertId])
  @@map("error_alert_deliveries")
}

/// Platform error alert settings (singleton row id "platform"), super admin
/// only. Sink URLs and the webhook secret are stored encrypted with
/// CredentialCipher and never returned (only the host and the last four
/// characters of the secret).
model ErrorSettings {
  id                     String   @id @default("platform") @db.VarChar(20)
  /// Partial ErrorSpikeSettings; missing keys use ERROR_SPIKE_DEFAULTS.
  spike                  Json     @default("{}")
  cooldownMinutes        Int      @default(60) @map("cooldown_minutes")
  webhookUrlEncrypted    String?  @map("webhook_url_encrypted") @db.Text
  webhookUrlHost         String?  @map("webhook_url_host") @db.VarChar(255)
  webhookSecretEncrypted String?  @map("webhook_secret_encrypted") @db.Text
  webhookSecretLast4     String?  @map("webhook_secret_last4") @db.VarChar(4)
  webhookEnabled         Boolean  @default(true) @map("webhook_enabled")
  slackUrlEncrypted      String?  @map("slack_url_encrypted") @db.Text
  slackEnabled           Boolean  @default(true) @map("slack_enabled")
  updatedByUserId        String?  @map("updated_by_user_id") @db.Uuid
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("error_settings")
}

/// Per-tenant error notification opt-in: e-mail the owner when a new group or
/// spike affects the tenant's users. Absent row = off.
model ErrorStudioSetting {
  studioId        String   @id @map("studio_id") @db.Uuid
  ownerNotify     Boolean  @default(false) @map("owner_notify")
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@map("error_studio_settings")
}

// ---------------------------------------------------------------------------
// M4a: OAuth connect (docs/PAZARLAMA_MODULU.md 5.2)
// ---------------------------------------------------------------------------

/// One started OAuth authorization. The raw state travels only in the
/// browser redirect; the row keeps its SHA-256. Single use (used_at),
/// valid for OAUTH_STATE_TTL_MINUTES, bound to the tenant, the user, the
/// provider and the target (new connection with its public fields, or the
/// id of the connection to reconnect). The PKCE verifier, where the
/// provider takes one, is CredentialCipher-encrypted because it has to be
/// sent to the token endpoint. studio_id and target_id are plain ids.
model OauthState {
  id                    String    @id @default(uuid()) @db.Uuid
  studioId              String    @map("studio_id") @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  provider              String    @db.VarChar(16)
  stateHash             String    @unique @map("state_hash") @db.VarChar(64)
  encryptedCodeVerifier String?   @map("encrypted_code_verifier") @db.Text
  /// One of OAUTH_TARGET_KINDS in @platform/shared.
  targetKind            String    @map("target_kind") @db.VarChar(32)
  targetId              String?   @map("target_id") @db.Uuid
  /// Public fields of a new connection (label, account id, pixel id, ...); never a secret.
  targetParams          Json      @default("{}") @map("target_params")
  /// 'marketing' | 'admin': which fixed hub path the browser returns to.
  returnTo              String    @map("return_to") @db.VarChar(16)
  expiresAt             DateTime  @map("expires_at")
  usedAt                DateTime? @map("used_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@index([studioId, createdAt])
  @@map("oauth_states")
}
