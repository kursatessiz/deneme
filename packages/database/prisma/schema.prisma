model Studio {
  id                     String   @id @default(uuid()) @db.Uuid
  businessTypeTemplateId String?  @map("business_type_template_id") @db.Uuid
  name                   String   @db.VarChar(100)
  slug                   String   @unique @db.VarChar(60)
  phone                  String?  @db.VarChar(30)
  email                  String?  @db.VarChar(120)
  address                String?  @db.Text
  timezone               String   @default("Europe/Istanbul") @db.VarChar(60)
  /// ISO 3166-1 alpha-2. Drives compliance region, default tax regime and
  /// provider registry priority. See packages/shared/src/growth/regions.ts.
  countryCode            String   @default("TR") @map("country_code") @db.VarChar(2)
  /// ISO 4217. Every Payment, Expense, invoice and report amount is in this
  /// currency; never hard-code 'TRY'. Changing it once payments exist is
  /// refused by the API (409) since existing amounts are not reconverted.
  currency               String   @default("TRY") @db.VarChar(3)
  /// TR_KDV | EU_VAT | UK_VAT | US_SALES_TAX | NONE. Drives invoicing (see
  /// docs/BUYUME_VE_GLOBAL_MIMARI.md section 2.4).
  taxRegime              String   @default("TR_KDV") @map("tax_regime") @db.VarChar(20)
  /// Whether PackageDefinition.price is entered tax-inclusive.
  pricesIncludeTax       Boolean  @default(true) @map("prices_include_tax")
  // Theme: logo, default theme family, one primary color and one gradient preset of that family.
  logoUrl                String?  @map("logo_url") @db.Text
  themeFamily            String   @default("atolye") @map("theme_family") @db.VarChar(20)
  themePrimary           String   @default("#2F6F5E") @map("theme_primary") @db.VarChar(7)
  gradientPresetKey      String   @default("atolye-orman") @map("gradient_preset_key") @db.VarChar(40)
  reminderHoursBefore    Int      @default(2) @map("reminder_hours_before")
  maxAdvanceBookingDays  Int      @default(14) @map("max_advance_booking_days")
  /// Deep link to the studio's Google Business review page. Must start with
  /// https://g.page/, https://search.google.com/local/writereview or
  /// https://www.google.com/maps. Null hides the review prompt entirely.
  googleReviewUrl        String?  @map("google_review_url") @db.Text
  /// Units credited to the referrer's active package when a referral is
  /// rewarded (EXTRA_UNITS is the only reward type while no gift-card
  /// module exists on main).
  referralRewardUnits    Int      @default(1) @map("referral_reward_units")
  /// QR check-in window around a session's start time (W17).
  checkInWindowBeforeMinutes Int  @default(30) @map("check_in_window_before_minutes")
  checkInWindowAfterMinutes  Int  @default(15) @map("check_in_window_after_minutes")
  /// Attribution window in days for the last-touch/linear models and the
  /// Google Ads offline click conversion lookback (G2b). Replaces the
  /// previously hard-coded DEFAULT_ATTRIBUTION_WINDOW_DAYS.
  attributionWindowDays      Int  @default(30) @map("attribution_window_days")
  /// Channel order and fallback, e.g. { "order": ["WHATSAPP", "SMS"] }
  notificationSettings   Json     @default("{\"order\":[\"WHATSAPP\",\"SMS\"]}") @map("notification_settings")
  /// G1c messaging engine settings (frequency caps, SMS provider override,
  /// email sender, inbound routing); see packages/shared/src/messaging-engine.ts.
  messagingSettings      Json     @default("{}") @map("messaging_settings")
  /// Churn risk scoring weights (W12). Null means the shared defaults apply;
  /// see packages/shared/src/churn.ts (ChurnWeightsSchema).
  churnWeights           Json?    @map("churn_weights")
  /// Streaks, milestones, badges and monthly goals (W16). On by default.
  gamificationEnabled    Boolean  @default(true) @map("gamification_enabled")
  /// Optional allow-list of origins that may frame /embed/<slug>; empty means any origin (frame-ancestors *).
  embedAllowedOrigins    String[] @default([]) @map("embed_allowed_origins")
  /// Language new users of this studio see until they pick their own (Language.code).
  defaultLocale          String   @default("tr") @map("default_locale") @db.VarChar(10)
  /// The platform's own tenant (its marketing CRM and site). At most one row
  /// is true (partial unique index in the migration SQL).
  isPlatform             Boolean  @default(false) @map("is_platform")
  /// Super-admin override of the monthly AI budget in US cents (G3b). Null
  /// falls back to the plan's aiMonthlyBudgetCents, then the platform default.
  aiMonthlyBudgetCents   Int?     @map("ai_monthly_budget_cents")
  /// Platform billing state (G5c-1, docs/DENEME_VE_ETKINLESTIRME.md): one of
  /// STUDIO_BILLING_STATUSES in @platform/shared. Lives on Studio (not on
  /// Subscription) because StudioTenantGuard already loads this row on
  /// every request; RESTRICTED and CANCELLED block writes on core modules.
  billingStatus          String    @default("ACTIVE") @map("billing_status") @db.VarChar(20)
  trialStartedAt         DateTime? @map("trial_started_at")
  trialEndsAt            DateTime? @map("trial_ends_at")
  /// First successful activation (first paid platform invoice).
  activatedAt            DateTime? @map("activated_at")
  billingStatusChangedAt DateTime? @map("billing_status_changed_at")
  /// Smallest TRIAL_REMINDER_DAYS threshold already sent for the current
  /// trial end; cleared when the trial is extended.
  trialReminderSentDays  Int?      @map("trial_reminder_sent_days")
  /// Business-to-business referral code (platform level), created on the
  /// owner's first visit to the referral page.
  platformReferralCode   String?   @unique @map("platform_referral_code") @db.VarChar(16)
  /// Super-admin override of the platform billing currency (G5c-1b); null
  /// derives it from countryCode (platformBillingCurrencyOf in shared).
  billingCurrency        String?   @map("billing_currency") @db.VarChar(3)
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  businessTypeTemplate BusinessTypeTemplate? @relation(fields: [businessTypeTemplateId], references: [id])

