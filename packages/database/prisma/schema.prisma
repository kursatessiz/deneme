// ---------------------------------------------------------------------------
// Platform level (super-admin)
// ---------------------------------------------------------------------------

/// Starter kit for a sector: default service/resource types, vocabulary
/// (member/client/patient, trainer/coach/therapist), forms and modules.
model BusinessTypeTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @unique @db.VarChar(60)
  name           String   @db.VarChar(100)
  vocabulary     Json     @default("{}")
  defaults       Json     @default("{}")
  enabledModules String[] @default([]) @map("enabled_modules")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  studios          Studio[]
  featureFlags     FeatureFlag[]
  measurementForms MeasurementFormTemplate[]

  @@map("business_type_templates")
}

/// Platform language (no studioId): the base language (tr) plus any language
/// the super admin adds. Bundled languages (tr, en) ship messages in code;
/// TranslationOverride rows layer CMS edits or uploaded pack values on top.
model Language {
  code       String   @id @db.VarChar(10)
  name       String   @db.VarChar(60)
  nativeName String   @map("native_name") @db.VarChar(60)
  isEnabled  Boolean  @default(false) @map("is_enabled")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  overrides       TranslationOverride[]
  glossaryTerms   AiGlossaryTerm[]
  translationJobs AiTranslationJob[]

  @@map("languages")
}

/// One translated key's value for one language, set via the super admin CMS
/// or an uploaded language pack. Only keys present in the code's base
/// (Turkish) message catalogue are ever written here.
model TranslationOverride {
  id              String            @id @default(uuid()) @db.Uuid
  locale          String            @db.VarChar(10)
  key             String            @db.VarChar(200)
  value           String            @db.Text
  /// Who produced the value: a person in the CMS, an uploaded pack or the
  /// AI translation engine (G3b).
  source          TranslationSource @default(MANUAL)
  /// When a person approved the value. Null on AI values still to review.
  reviewedAt      DateTime?         @map("reviewed_at")
  updatedByUserId String?           @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime          @updatedAt @map("updated_at")

  language      Language @relation(fields: [locale], references: [code], onDelete: Cascade)
  updatedByUser User?    @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([locale, key])
  @@index([locale, source, reviewedAt])
  @@map("translation_overrides")
}

enum TranslationSource {
  MANUAL
  UPLOAD
  AI
}

model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique @db.VarChar(60)
  name         String   @db.VarChar(100)
  priceMonthly Decimal  @map("price_monthly") @db.Decimal(10, 2)
  /// e.g. { "maxBranches": 1, "maxActiveMembers": 300, "maxStaff": 10 }
  limits       Json     @default("{}")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  /// Deprecated (G5c-1b): prices live in plan_prices. priceMonthly and
  /// currency are still written (mirror of one price) for one release and
  /// will be dropped; never read them to choose a price.
  currency     String   @db.VarChar(3)
  /// Free trial length in days for a new business on this plan (G5c-1).
  /// Platform data set by the super admin, never a constant in code.
  trialDays    Int      @default(14) @map("trial_days")

  subscriptions   Subscription[]
  billingPayments PlatformBillingPayment[]
  prices          PlanPrice[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  studioId           String             @map("studio_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  cancelledAt        DateTime?          @map("cancelled_at")
  createdAt          DateTime           @default(now()) @map("created_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([studioId, status])
  @@map("subscriptions")
}

/// Resolution order: TENANT, then BUSINESS_TYPE, then GLOBAL.
model FeatureFlag {
  id                     String           @id @default(uuid()) @db.Uuid
  key                    String           @db.VarChar(80)
  scope                  FeatureFlagScope
  businessTypeTemplateId String?          @map("business_type_template_id") @db.Uuid
  studioId               String?          @map("studio_id") @db.Uuid
  enabled                Boolean
  updatedAt              DateTime         @updatedAt @map("updated_at")

  businessTypeTemplate BusinessTypeTemplate? @relation(fields: [businessTypeTemplateId], references: [id], onDelete: Cascade)
  studio               Studio?               @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([key, scope, businessTypeTemplateId, studioId])
  @@index([studioId])
  @@map("feature_flags")
}

model SmsPackage {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(60)
  name      String   @db.VarChar(100)
  credits   Int
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  transactions SmsTransaction[]

  @@map("sms_packages")
}

