  ALL_MEMBERS
  SPECIFIC_PACKAGES
}

enum ColorSchemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum WaitlistStatus {
  WAITING
  OFFERED
  PROMOTED
  EXPIRED
  CANCELLED
}

enum PackageStatus {
  ACTIVE
