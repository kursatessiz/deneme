exports[`email block renderer renders a stable responsive, inline-styled document and a plain-text part 1`] = `"<!DOCTYPE html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light"><title>Konu</title><style>@media only screen and (max-width:620px){.container{width:100% !important;}.px{padding-left:20px !important;padding-right:20px !important;}}</style></head><body style="margin:0;padding:0;background-color:#FAFAF8;"><div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">Önizleme</div><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#FAFAF8;"><tr><td align="center" style="padding:24px 8px;"><table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;background-color:#FFFFFF;border:1px solid #E4E2DC;border-radius:12px;"><tr><td class="px" style="padding:24px 32px 8px 32px;border-top:4px solid #2F6F5E;border-radius:12px 12px 0 0;"><span style="font-family:&quot;Schibsted Grotesk&quot;, system-ui, sans-serif, Arial, sans-serif;font-size:20px;line-height:28px;font-weight:700;color:#17160F;">Zen &amp; Co</span></td></tr><tr><td class="px" style="padding:8px 32px 16px 32px;"><h1 style="margin:0;font-family:&quot;Schibsted Grotesk&quot;, system-ui, sans-serif, Arial, sans-serif;font-size:24px;line-height:32px;font-weight:700;color:#17160F;">Merhaba Ada</h1></td></tr><tr><td class="px" style="padding:0 32px 16px 32px;"><p style="margin:0;font-family:&quot;Figtree&quot;, system-ui, sans-serif, Arial, sans-serif;font-size:16px;line-height:24px;color:#17160F;">Satır 1<br>&lt;b&gt;kalın değil&lt;/b&gt;</p></td></tr><tr><td class="px" style="padding:8px 32px 24px 32px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td bgcolor="#2F6F5E" style="border-radius:24px;background-color:#2F6F5E;"><a href="https://app.example.com/m/c/45" target="_blank" rel="noopener" style="display:inline-block;padding:12px 24px;font-family:&quot;Figtree&quot;, system-ui, sans-serif, Arial, sans-serif;font-size:16px;line-height:20px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:24px;">Rezervasyon</a></td></tr></table></td></tr><tr><td class="px" style="padding:0 32px 16px 32px;"><a href="https://app.example.com/m/c/34" target="_blank" rel="noopener"><img src="https://cdn.example.com/a.png" alt="Stüdyo" width="536" style="display:block;width:100%;max-width:536px;height:auto;border:0;"></a></td></tr><tr><td class="px" style="padding:8px 32px 24px 32px;"><div style="height:1px;line-height:1px;font-size:1px;background-color:#E4E2DC;">&nbsp;</div></td></tr><tr><td class="px" style="padding:0 32px 16px 32px;"><p style="margin:0;font-family:&quot;Figtree&quot;, system-ui, sans-serif, Arial, sans-serif;font-size:13px;line-height:20px;color:#5F5C54;">Görüşmek üzere</p></td></tr><tr><td class="px" style="padding:16px 32px 24px 32px;border-top:1px solid #E4E2DC;"><p style="margin:0;font-family:&quot;Figtree&quot;, system-ui, sans-serif, Arial, sans-serif;font-size:12px;line-height:18px;color:#5F5C54;">Bu e-postayı izniniz olduğu için aldınız.<br>Zen &amp; Co, Moda Cad. 1, İstanbul<br><a href="https://app.example.com/m/u/tok" target="_blank" rel="noopener" style="color:#5F5C54;text-decoration:underline;">Abonelikten çık</a></p></td></tr></table><img src="https://api.example.com/m/o/tok" width="1" height="1" alt="" style="display:block;width:1px;height:1px;border:0;"></td></tr></table></body></html>"`;

