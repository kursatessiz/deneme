{
  "expo": {
    "name": "Platform",
    "slug": "platform-app",
    "scheme": "platform",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#14120f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.platform.member"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14120f"
      },
      "package": "com.platform.member"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2F6F5E"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.platform.member",
          "widgets": [
            {
              "name": "NextSessionWidget",
              "displayName": "Sonraki Ders",
              "description": "Sonraki dersiniz ve aktif paketinizde kalan hak.",
              "supportedFamilies": ["systemSmall", "systemMedium"],
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NextSessionWidget",
              "label": "Sonraki Ders",
              "description": "Sonraki dersiniz ve aktif paketinizde kalan hak.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "resizeMode": "horizontal"
            }
          ]
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}
