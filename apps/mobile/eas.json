{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "22.23.4",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "resourceClass": "medium"
      }
    },
    "preview": {
      "node": "22.23.4",
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "resourceClass": "medium",
        "buildType": "apk"
      }
    },
    "preprod": {
      "node": "22.23.4",
      "distribution": "internal",
      "channel": "preprod",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "preprod"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "resourceClass": "medium",
        "buildType": "apk"
      }
    },
    "production": {
      "node": "22.23.4",
      "channel": "production",
      "environment": "production",
      "env": {
        "APP_VARIANT": "production"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "resourceClass": "medium",
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "APPLE_ID_ENV_PLACEHOLDER",
        "ascAppId": "ASC_APP_ID_ENV_PLACEHOLDER",
        "appleTeamId": "APPLE_TEAM_ID_ENV_PLACEHOLDER"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
