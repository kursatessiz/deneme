# Local development. Start dependencies with:
#   docker compose -f deploy/docker-compose.dev.yml up -d
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://app_user:dev_password@localhost:5432/app_dev?schema=public
REDIS_URL=redis://:dev_redis_pass@localhost:6379
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
CORS_ORIGIN=http://localhost:3000
SMS_PROVIDER=MOCK
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# AI core (docs/YAPAY_ZEKA.md). The key is normally pasted in the super-admin
# AI settings screen and stored encrypted; this is only the optional fallback.
# ANTHROPIC_API_KEY=

# Database backups from the super admin panel (docs/YEDEKLER.md). Optional in
# development; with BACKUP_S3_BUCKET set, the access key, the secret and the
# encryption key are required. A local MinIO works as the store.
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=http://localhost:9000
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_PREFIX=db
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_ENCRYPTION_KEY=
# BACKUP_LOCAL_DIR=
# BACKUP_STALE_HOURS=26
# BACKUP_DOWNLOAD_URL_TTL_SECONDS=300
# BACKUP_PG_DUMP_PATH=pg_dump

# Platform two-step verification (docs/PAZARLAMA_MODULU.md 6.3): the issuer
# name authenticator apps show; defaults to "Platform".
# MFA_ISSUER=
